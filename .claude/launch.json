{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@erp/web",
        "exec",
        "vite",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199,
      "autoPort": false
    },
    {
      "name": "portal-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@erp/portal",
        "exec",
        "vite",
        "--port",
        "5198",
        "--strictPort"
      ],
      "port": 5198,
      "autoPort": false
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@erp/api",
        "exec",
        "node",
        "--max-http-header-size=65536",
        "dist/main.js"
      ],
      "port": 3001,
      "autoPort": false
    }
  ]
}
