# Production environment for:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Copy to .env on the host, fill every value, keep it out of git. Compose refuses
# to start while a required value is missing. Audit 2026-09-27 F10/F12/F13.

# ── Public names (DNS must already point at this host) ──────────────────────
SCHOOL_DOMAIN=school.example.ug
ACME_EMAIL=it@school.example.ug
# Staff app and family portal. Both call the API on their own origin (/api/v1),
# routed by Caddy — the browser bundles contain no API host.
WEB_URL=https://admin.school.example.ug
PORTAL_URL=https://portal.school.example.ug
PROD_CORS_ORIGINS=https://admin.school.example.ug,https://portal.school.example.ug

# ── The school the portal signs families into ───────────────────────────────
PORTAL_ORG_CODE=GREENVALLEY
PORTAL_SCHOOL_NAME=Green Valley Nursery and Primary

# ── Database roles (scripts/setup-rls-role.ts) ──────────────────────────────
# NOBYPASSRLS application role — what the API runs as.
APP_DATABASE_URL=postgresql://app:CHANGE_ME@db:5432/school?schema=public
# BYPASSRLS system role — pre-tenant lookups only.
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@db:5432/school?schema=public
# Owner role — migrations only.
MIGRATOR_DATABASE_URL=postgresql://school_owner:CHANGE_ME@db:5432/school?schema=public
# BYPASSRLS + CREATEDB — backups and the weekly restore drill
# (docs/operations/backup-and-restore.md).
BACKUP_DATABASE_URL=postgresql://school_backup:CHANGE_ME@db:5432/school?schema=public

# ── Secrets (openssl rand -base64 48) ───────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_POS_SECRET=
METRICS_TOKEN=
COMM_ENCRYPTION_KEY=

# ── Mail ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@school.example.ug

# ── Operator only ───────────────────────────────────────────────────────────
# Creating a new school. Leave empty to keep provisioning closed.
PROVISIONING_SECRET=
