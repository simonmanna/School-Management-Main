# The API. Leave unset to use the dev-server proxy at /api/v1.
VITE_API_URL="http://localhost:3003"

# The school this portal belongs to. Baked in at build time so a guardian is
# never shown an "organization code" field they cannot possibly know.
VITE_ORG_CODE="DEMO"

# The school's name. Shown on the public website, the login screen and the
# signed-in header, so it must read as a school rather than as a system —
# "Sunrise Academy", not "School Portal".
VITE_SCHOOL_NAME="Sunrise Academy"

# Short form, used where the full name will not fit.
VITE_SCHOOL_SHORT_NAME="Sunrise"

# Everything else the public website says — address, phone, term dates, news,
# programmes — lives in src/site/content.ts, not here. Those are paragraphs, not
# secrets, and they belong in version control where a change can be reviewed.
