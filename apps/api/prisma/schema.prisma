  updatedAt        DateTime @updatedAt

  teacher     StaffProfile @relation(fields: [teacherPartnerId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id])
  schoolClass SchoolClass  @relation(fields: [classId], references: [id])
  section     Section?     @relation(fields: [sectionId], references: [id])
  stream      Stream?      @relation(fields: [streamId], references: [id])
  term        Term?        @relation(fields: [termId], references: [id])

  @@unique([organizationId, teacherPartnerId, subjectId, classId, sectionId, streamId, termId])
  @@index([organizationId])
  @@index([teacherPartnerId])
  @@index([classId])
  @@index([streamId])
}

model TimetableSlot {
  id               String   @id @default(uuid())
  organizationId   String
  classId          String
  sectionId        String?
  streamId         String?
  dayOfWeek        Int // 1=Monday ... 7=Sunday
  periodId         String
  subjectId        String
  teacherPartnerId String?
  room             String?
  /// 'lesson' | 'break' | 'free'. Breaks/free periods are not conflict-checked.
  type             String   @default("lesson")
  /// Substitute teacher covering this slot (overrides teacherPartnerId visually).
  substituteTeacherId String?
  /// Published to students/staff (a class's whole grid is published together).
  published        Boolean  @default(false)
  /// Number of consecutive periods this slot spans (2 = double period).
  spanPeriods      Int      @default(1)
  /// Rotating-schedule cycle this slot belongs to: 'all' | 'A' | 'B'.
  cycle            String   @default("all")
  /// Optional link to a managed teaching room (vs the free-text `room` label).
  teachingRoomId   String?
  teachingRoom     TeachingRoom? @relation(fields: [teachingRoomId], references: [id])
  /// Canonical teaching instance this slot belongs to (CourseOffering spine).
  /// Backfilled from (class+section+subject+term); nullable during migration.
  courseOfferingId String?
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  schoolClass SchoolClass   @relation(fields: [classId], references: [id])
  section     Section?      @relation(fields: [sectionId], references: [id])
  stream      Stream?       @relation(fields: [streamId], references: [id])
  period      Period        @relation(fields: [periodId], references: [id])
  subject     Subject       @relation(fields: [subjectId], references: [id])
  campus      Campus?       @relation(fields: [campusId], references: [id])
  teacher     StaffProfile? @relation(fields: [teacherPartnerId], references: [id])
  campusId    String?

  @@index([organizationId])
  @@index([classId, dayOfWeek])
  @@index([teacherPartnerId, dayOfWeek])
  @@index([periodId, dayOfWeek])
  @@index([streamId])
  @@index([teachingRoomId])
  @@index([courseOfferingId])
}

/// Managed teaching rooms (labs, halls) used for timetable room booking/availability.
model TeachingRoom {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  capacity       Int      @default(30)
  type           String   @default("classroom") // classroom | lab | hall | gym
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  timetableSlots TimetableSlot[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Teacher weekly availability: which periods a teacher is free / busy / unavailable.
model TeacherAvailability {
  id               String   @id @default(uuid())
  organizationId   String
  teacherPartnerId String
  dayOfWeek        Int // 1=Mon ... 7=Sun
  periodId         String
  /// 'available' | 'busy' | 'unavailable'. Drives conflict detection.
  status           String   @default("available")
  reason           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, teacherPartnerId, dayOfWeek, periodId])
  @@index([organizationId])
  @@index([teacherPartnerId, dayOfWeek])
}

/// Per-class active rotating-schedule cycle ('all' | 'A' | 'B').
model TimetableRotation {
  id          String   @id @default(uuid())
  organizationId String
  classId     String   @unique
  /// Currently active cycle shown on the grid.
  activeCycle String   @default("all")
  /// When the active cycle last switched.
  switchedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
}

/// Temporary timetable changes: swap a slot's subject/teacher for a date range.
model TimetableOverride {
  id             String   @id @default(uuid())
  organizationId String
  classId        String
  sectionId      String?
  dayOfWeek      Int
  periodId       String
  /// Inclusive date range the override is active for.
  effectiveFrom  DateTime
  effectiveTo    DateTime
  /// Replacement values (optional). Null = cancellation for the window.
  subjectId      String?
  teacherPartnerId String?
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  @@index([organizationId])
  @@index([classId, dayOfWeek, periodId])
}

/// P-att-status: attendance statuses are organization-configurable. The old
/// rigid `AttendanceStatus` enum is gone; `status` is now a free string holding
/// the AttendanceStatusConfig.code (e.g. "present", "absent", "late"). An
/// optional FK to the config row carries display metadata (colour/label).
model StudentAttendance {
  id               String           @id @default(uuid())
  organizationId   String
  studentProfileId String
  classId          String
  sectionId        String?
  date             DateTime
  /// P5: null = daily attendance (one row per student/day); set = period
  /// attendance (one row per student/day/period), for secondary schools with
  /// subject teachers. Uniqueness is enforced by two partial indexes created in
  /// the migration (NULLS DISTINCT would otherwise let a student have many null
  /// daily rows), so this is a plain @@index here, not @@unique.
  periodId         String?
  status           String          @default("present")
  /// FK to AttendanceStatusConfig for display metadata (colour/label). Null when
  /// the status code has no matching config row (e.g. legacy / custom value).
  statusCfgId      String?
  minutesLate      Int              @default(0)
  earlyDepartureMinutes Int?
  reason           String?
  markedById       String?
  markedAt         DateTime         @default(now())
  customFields     Json             @default("{}")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass    @relation(fields: [classId], references: [id])
  section        Section?       @relation(fields: [sectionId], references: [id])
  period         Period?        @relation(fields: [periodId], references: [id])
  statusConfig   AttendanceStatusConfig? @relation(fields: [statusCfgId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([classId, date])
  @@index([organizationId, date])
  @@index([organizationId, studentProfileId, date])
  @@index([statusCfgId])
}

/// P-att-status: organization-configurable attendance statuses. Seed default
/// ships Absent / Present / Late (codes "absent" | "present" | "late"). Schools
/// can add more (e.g. "Excused", "On Leave") or adjust colours/labels. The
/// `isPresent`/`isLate` flags drive roll-up maths and parent alerts.
model AttendanceStatusConfig {
  id             String   @id @default(uuid())
  organizationId String
  /// Stable machine code used as StudentAttendance.status (e.g. "present").
  code           String
  label          String
  /// Hex colour used by the UI (e.g. "#16a34a").
  color          String   @default("#6b7280")
  /// First status shown in the mark grid; only one per org.
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  /// Counts towards "present" roll-up (good attendance).
  isPresent      Boolean  @default(false)
  /// Counts as a late arrival (treated as partial credit in rate maths).
  isLate         Boolean  @default(false)
  /// Counts as an absence (triggers absence alerts / below-threshold maths).
  isAbsent       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendanceRecords StudentAttendance[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isDefault])
}

/// P1: attendance alert thresholds. An org-level default plus optional
/// per-class overrides. `minAttendancePct` is the floor below which a student
/// is flagged and guardians are notified. `notifyAbsent` / `notifyLate` /
/// `notifyEarly` toggle the per-event parent alerts; `notifyBelowThreshold`
/// toggles the rolling roll-up alert.
model AttendanceThreshold {
  id                      String   @id @default(uuid())
  organizationId          String
  classId                 String?  // null = org default
  minAttendancePct        Float    @default(75)
  notifyAbsent            Boolean  @default(true)
  notifyLate              Boolean  @default(true)
  notifyEarly             Boolean  @default(true)
  notifyBelowThreshold    Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, classId])
}

model HomeworkAssignment {
  id               String    @id @default(uuid())
  organizationId   String
  teacherPartnerId String
  classId          String
  sectionId        String?
  subjectId        String
  termId           String?
  /// The gradebook column this homework IS. Minted when the homework is
  /// created, not when it is first graded, so the column exists from the moment
  /// the work is set. NO studentAssessmentId here — the per-student bridge is at
  /// submission level (HomeworkSubmission → StudentAssessment).
  assessmentId     String?   @unique
  courseOfferingId String?
  lessonPlanId     String?
  learningObjectiveId String?
  title            String
  description      String?
  dueDate          DateTime
  attachments      Json      @default("[]")
  maxScore         Decimal?  @db.Decimal(8, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  teacher     StaffProfile         @relation(fields: [teacherPartnerId], references: [id])
  schoolClass SchoolClass          @relation(fields: [classId], references: [id])
  section     Section?             @relation(fields: [sectionId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  submissions HomeworkSubmission[]

  @@index([organizationId])
  @@index([classId, dueDate])
  @@index([subjectId])
}

model HomeworkSubmission {
  id               String    @id @default(uuid())
