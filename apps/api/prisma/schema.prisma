/// Phase-2 identity/deduplication layer. Non-destructive candidate matching:
/// when a new application is submitted, the system computes likely-duplicate
/// existing students/applicants (by name+DOB, guardian phone/email, national/
/// birth-cert id where stored) and records them as ApplicantIdentityMatch rows.
/// An authorized admissions user then confirms (same person) or dismisses (not
/// the same person). This prevents destructive auto-merging and supports the
/// reapplication invariant: a person may hold multiple applications across cycles.
model ApplicantIdentityMatch {
  id                   String   @id @default(uuid())
  organizationId       String
  applicationId        String
  candidateType        String /// 'student' | 'applicant'
  candidateId          String /// StudentProfile.id OR AdmissionApplication.id being compared
  candidateName        String
  matchMethod          String /// 'name_dob' | 'guardian_phone' | 'guardian_email' | 'national_id' | 'birth_cert'
  matchScore           Int      @default(0) /// 0-100 confidence
  status               String   @default("open") /// open | confirmed_same | dismissed
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
  @@index([candidateId])
}

/// Phase-3 admission cycle: a scoped admissions campaign under an AcademicYear
/// (e.g. "Primary 1 2027/28"). Owns capacity, criteria, deadlines — not the
/// application FSM itself.
model AdmissionCycle {
  id             String   @id @default(uuid())
  organizationId String
  academicYearId String
  name           String
  opensAt        DateTime?
  closesAt       DateTime?
  status         String   @default("open") /// open | closed
  customFields   Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear  AcademicYear        @relation(fields: [academicYearId], references: [id])
  applications   AdmissionApplication[]
  capacities     AdmissionCapacity[]
  criteriaSets   AdmissionCriteriaSet[]

  @@unique([organizationId, academicYearId, name])
  @@index([organizationId])
  @@index([academicYearId])
}

/// Organization-scoped nationality master data. Replaces the hardcoded
/// dropdown on the application form. Physical deletion is avoided: deactivation
/// (isActive=false) keeps historical applications intact while hiding the value
/// from new-application selects.
model Nationality {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// Phase-3 capacity. Holds ONLY the declared capacity + reserved seats. Occupied
/// seats are DERIVED from active Enrollments (never stored, to avoid sync drift).
model AdmissionCapacity {
  id               String  @id @default(uuid())
  organizationId   String
  admissionCycleId String
  classId          String
  sectionId        String?
  streamId         String?
  campusId         String?
  capacity         Int     @default(0)
  reservedCapacity Int     @default(0)
  /// Atomic seat claim used to make enrollment capacity-safe under concurrency.
  /// Incremented (conditionally) inside the enroll transaction; the ui `available`
  /// is `capacity - reservedCapacity - claimedSeats`. Decremented on enrolment reversal.
  claimedSeats     Int     @default(0)

  admissionCycle AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, admissionCycleId, classId, sectionId, streamId])
  @@index([organizationId])
  @@index([admissionCycleId])
  @@index([classId])
}

/// Phase-3 configurable admission criteria set (per cycle/class). Weights drive
/// the weighted scoring engine instead of the old fixed "/3".
model AdmissionCriteriaSet {
  id               String   @id @default(uuid())
  organizationId   String
  admissionCycleId String
  name             String
  classId          String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())

  admissionCycle AdmissionCycle      @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)
  criteria       AdmissionCriterion[]

  @@index([organizationId])
  @@index([admissionCycleId])
}

model AdmissionCriterion {
  id                String  @id @default(uuid())
  organizationId    String
  criteriaSetId     String
  name              String /// e.g. Entrance Exam, Interview, Previous Grades
  weight            Float   @default(0) /// 0-1, sums to 1 across the set
  maxScore          Float   @default(100)
  required          Boolean  @default(false)
  passMark          Float   @default(0)

  criteriaSet AdmissionCriteriaSet @relation(fields: [criteriaSetId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([criteriaSetId])
}

/// Phase-3 admission decision record (audit + dispute resolution). Stores the
/// final decision, weighted score, per-criterion breakdown, and reason.
model AdmissionDecision {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String   @unique
  decision       String /// accepted | rejected | waitlisted
  totalScore     Float?
  breakdown      Json?    /// { exam: 86, interview: 78, ... }
  decidedById    String?
  reason         String?
  decidedAt      DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
}

model AdmissionApplication {
  id                 String          @id @default(uuid())
  organizationId     String
  academicYearId     String
  admissionCycleId   String?
  applicationNumber  String
  applicantFirstName String
  applicantLastName  String
  applicantDob       DateTime?
  applicantGender    String?
  applyingForClassId String?
  /// FK to Contact (parent/guardian contact for this application).
  parentContactId    String?
  status             AdmissionStatus @default(submitted)
  submittedAt        DateTime        @default(now())
  reviewedById       String?
  reviewedAt         DateTime?
  decisionNotes      String?
  /// Application fee lifecycle. unpaid | pending (invoice issued) | paid | waived.
  feeStatus          String          @default("unpaid")
  /// FK to the sales_invoice Document created for the application fee.
  feeInvoiceId       String?
  /// Phase-5 SLA / processing-time tracking timestamps.
  screenedAt         DateTime?
  interviewedAt      DateTime?
  examScheduledAt    DateTime?
  scoredAt           DateTime?
  acceptedAt         DateTime?
  offerIssuedAt      DateTime?
  offerAcceptedAt    DateTime?
  enrolledAt         DateTime?
  /// Set when a draft is submitted into the pipeline (draft → submitted).
  submittedByPortal  Boolean         @default(false)
  /// How the enquiry reached the school (referral | website | walk_in | agent | sibling | other).
  sourceOfEnquiry    String?
  /// Link to an existing student when the applicant is a sibling (analytics + priority).
  siblingOfStudentId String?
  /// AES-256-GCM field-level encryption of the national ID (NIN). PII must not
  /// sit in plaintext customFields where every `school:read` holder can see it.
  ninCiphertext      String?
  ninIv              String?
  ninTag             String?
  /// Promoted operational fields previously stored in customFields JSON.
  /// Stored top-level so they are queryable and type-checked (no enum migration
  /// risk — residenceType keeps the existing 'day'|'boarder' string convention).
  nationality        String?
  residenceType      String?
  entryStatus        String?
  address            String?
  customFields       Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  academicYear  AcademicYear          @relation(fields: [academicYearId], references: [id])
  admissionCycle AdmissionCycle?       @relation(fields: [admissionCycleId], references: [id])
  applyingForClass SchoolClass?        @relation("AdmissionApplyingForClass", fields: [applyingForClassId], references: [id])
  documents     ApplicationDocument[]
  entranceExams EntranceExam[]
  interviews    Interview?
  score         ApplicantScore?
  waitingList   WaitingList?
  fee           AdmissionFee?
  offerLetter   OfferLetter?
  enrollment    Enrollment?
  identityMatches ApplicantIdentityMatch[]
  decision      AdmissionDecision?
  guardians     AdmissionGuardian[]
  reviewerAssignments AdmissionReviewerAssignment[]
  portalTokens  AdmissionPortalToken[]
  statusHistory AdmissionStatusHistory[]

  @@unique([organizationId, applicationNumber])
  @@index([organizationId])
  @@index([academicYearId])
  @@index([status])
  @@index([organizationId, status, academicYearId])
}

/// Structured guardian captured on an application. Promoted to a real
/// Contact + StudentGuardian at enrollment. Previously guardians were 12 flat
/// strings in customFields, so no enrolled student had any guardian record.
model AdmissionGuardian {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String
  firstName      String
  lastName       String?
  relationship   String /// father | mother | guardian | other
  phone          String?
  altPhone       String?
  email          String?
  occupation     String?
  address        String?
  isPrimary      Boolean  @default(false)
  isEmergency    Boolean  @default(false)
  financiallyResponsible Boolean @default(false)
  /// Set once promoted to a Contact at enrollment (idempotency + traceability).
  contactId      String?
  createdAt      DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
}

/// Append-only status history for an application. Every FSM transition writes
/// one row: who, from, to, reason, when. The AuditLog captures it too, but this
/// is the queryable per-application timeline the UI renders.
model AdmissionStatusHistory {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String
  fromStatus     String?
  toStatus       String
  action         String
  reason         String?
  changedById    String?
  changedAt      DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
}

/// Per-cycle admission requirement: a document type or a checklist item that a
/// submitted application must satisfy. Drives the submission-completeness gate
/// and the enrollment document gate. `enrollmentEligibility` used to filter on a
/// `required` flag that did not exist; requirements now have a first-class home.
model AdmissionRequirement {
  id               String   @id @default(uuid())
  organizationId   String
  admissionCycleId String?
  /// Optional narrowing to one class/grade (null = applies to the whole cycle).
  classId          String?
  /// 'document' | 'field' | 'fee'.
  kind             String   @default("document")
  /// For documents: the ApplicationDocument.type this maps to (birth_cert, etc.).
  code             String
  label            String
  required         Boolean  @default(true)
  /// Gate this requirement applies at: 'submit' | 'enroll'.
  gate             String   @default("submit")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, admissionCycleId, classId, gate, code])
  @@index([organizationId])
  @@index([admissionCycleId])
}

/// Assignment of an application to a reviewer for independent assessment.
/// Supports the admissions-committee model: multiple reviewers, each with their
/// own recommendation, none able to see/alter another's until decision.
model AdmissionReviewerAssignment {
  id             String    @id @default(uuid())
  organizationId String
  applicationId  String
  reviewerId     String /// staff/user id
  role           String    @default("reviewer") /// reviewer | panel_lead | interviewer
  status         String    @default("assigned") /// assigned | in_progress | completed
  recommendation String? /// accept | reject | waitlist | borderline
  score          Float?
  comments       String?
  assignedById   String?
  assignedAt     DateTime  @default(now())
  completedAt    DateTime?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, reviewerId])
  @@index([organizationId])
  @@index([applicationId])
  @@index([organizationId, reviewerId, status])
}

/// Magic-link / OTP token for the applicant-facing portal. The applicant proves
/// control of an email/phone and receives a scoped token to view + progress
/// their own application without a full platform account.
model AdmissionPortalToken {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String
  /// SHA-256 of the raw token — the raw value is emailed, never stored.
  tokenHash      String   @unique
  email          String?
  phone          String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
}

/// Offer letter template (Phase 2). Rendered with application data at issue time.
model AdmissionOfferTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  /// Handlebars-ish body with {{applicantName}}, {{className}}, {{expiresAt}} tokens.
  body           String
  /// Default validity window in days when an offer is issued from this template.
  validityDays   Int      @default(14)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

/// Lightweight enquiry / lead captured before a formal application (Phase 5).
model AdmissionEnquiry {
  id                String   @id @default(uuid())
  organizationId    String
  academicYearId    String?
  applicantName     String
  guardianName      String?
  phone             String?
  email             String?
  interestedClassId String?
  source            String? /// referral | website | walk_in | agent | sibling | other
  status            String   @default("new") /// new | contacted | converted | closed
  notes             String?
  /// Set when the enquiry is converted into an AdmissionApplication.
  convertedApplicationId String?
  assignedToId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([organizationId])
  @@index([organizationId, status])
}

model ApplicationDocument {
  id             String    @id @default(uuid())
  organizationId String
  applicationId  String
  /// 'birth_cert' | 'report_card' | 'recommendation' | 'photo' | 'other'.
  type           String
  fileId         String
  uploadedAt     DateTime  @default(now())
  /// Mandatory before the applicant may be enrolled. `enrollmentEligibility()`
  /// already filtered on this flag, but the column did not exist — so the
  /// document gate silently matched nothing and never blocked an enrollment.
  required       Boolean   @default(false)
  verified       Boolean   @default(false)
  verifiedById   String?
  verifiedAt     DateTime?
  /// Why a reviewer rejected the document, so the applicant can be told what to
  /// replace. Null while the document is unreviewed or accepted.
  rejectionReason String?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        File                 @relation("applicationDocuments", fields: [fileId], references: [id])

  @@index([organizationId])
  @@index([applicationId])
}

model EntranceExam {
  id             String    @id @default(uuid())
  organizationId String
  applicationId  String
  subjectId      String
  scheduledAt    DateTime?
  score          Decimal?  @db.Decimal(8, 2)
  maxScore       Decimal   @default(100) @db.Decimal(8, 2)
  grade          String?
  notes          String?
  enteredById    String?
  enteredAt      DateTime?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject     Subject              @relation(fields: [subjectId], references: [id])

  @@unique([applicationId, subjectId])
  @@index([organizationId])
  @@index([applicationId])
}

model WaitingList {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String   @unique
  classId        String
  position       Int
  addedAt        DateTime @default(now())
  notes          String?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([classId, position])
}

/// Interview scheduling + outcome for an admission application.
model Interview {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String   @unique
  /// Staff/partner id of the interviewer (or panel lead).
  interviewerId  String?
  scheduledAt    DateTime?
  completedAt    DateTime?
  /// 1-5 panel rating.
  rating         Int?
  /// 'strong' | 'borderline' | 'weak'.
  recommendation String?
  panelNotes     String?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
}

/// Aggregate applicant score (entrance exam + interview + documents).
model ApplicantScore {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String   @unique
  examScore      Decimal? @db.Decimal(6, 2)
  interviewScore Decimal? @db.Decimal(6, 2)
  documentScore  Decimal? @db.Decimal(6, 2)
  totalScore     Decimal? @db.Decimal(6, 2)
  breakdown       Json?    /// per-criterion weighted contribution map
  computedAt     DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Application fee tracking. The actual charge is a sales_invoice Document
/// (reusing the invoicing/accounting stack — zero new accounting code).
model AdmissionFee {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String   @unique
  amount         Decimal  @db.Decimal(10, 2)
  /// FK to the sales_invoice Document created for this fee.
  invoiceId      String?
  paid           Boolean  @default(false)
  paidAt         DateTime?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Offer letter issued to an accepted applicant.
model OfferLetter {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String   @unique
  issuedAt       DateTime @default(now())
  expiresAt      DateTime?
  templateId     String?
  body           String?
  /// 'issued' | 'viewed' | 'accepted' | 'declined' | 'expired' | 'withdrawn'.
  status         String   @default("issued")
  acceptedAt     DateTime?
  viewedAt       DateTime?
  declinedAt     DateTime?
  withdrawnAt    DateTime?
  /// Free-text conditions attached to the offer (scholarship, deposit, etc.).
  conditions     String?
  depositPaid    Boolean  @default(false)
  version        Int      @default(1)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
}

model Enrollment {
  id               String   @id @default(uuid())
  organizationId   String
  applicationId    String?  @unique
  studentProfileId String
  classId          String
  sectionId        String?
  streamId         String?
  termId           String
  rollNumber       String
  enrolledAt       DateTime @default(now())
  /// Date the enrollment became effective (may differ from enrolledAt for mid-year entries).
  effectiveDate    DateTime @default(now())
  /// 'enrolled' | 'completed' | 'transferred_out' | 'withdrawn'.
  status           String   @default("enrolled")
  /// Set when the enrollment ends (transfer/withdraw). History is append-only in EnrollmentHistory.
  endedAt          DateTime?
  endReason        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application AdmissionApplication? @relation(fields: [applicationId], references: [id])
  student     StudentProfile        @relation(fields: [studentProfileId], references: [id])
  schoolClass SchoolClass           @relation(fields: [classId], references: [id])
  section     Section?              @relation(fields: [sectionId], references: [id])
  stream      Stream?               @relation(fields: [streamId], references: [id])
  term        Term                  @relation(fields: [termId], references: [id])
  history     EnrollmentHistory[]

  @@unique([organizationId, studentProfileId, termId])
  @@index([organizationId])
  @@index([classId])
  @@index([sectionId])
  @@index([streamId])
  @@index([termId])
}

/// Append-only history of every enrollment status change (enroll / transfer / withdraw /
/// re-enroll). This is the auditable record that makes Student Academic Enrollment a
/// first-class historical entity.
model EnrollmentHistory {
  id               String   @id @default(uuid())
  organizationId   String
  enrollmentId     String
  fromStatus       String?
  toStatus         String
  reason           String?
  changedById      String?
  changedAt        DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([enrollmentId])
}

/// Curriculum (per class + academic year). Versioned + lifecycle-managed:
/// draft → published → archived. Published versions are immutable; edits create a
/// new version via cloneAsNewVersion so the history is auditable.
model Curriculum {
  id             String    @id @default(uuid())
  organizationId String
  classId        String
  academicYearId String
  name           String
  description    String?
  /// Monotonic version within (classId, academicYearId). v1 is the first draft.
  version        Int       @default(1)
  /// 'draft' | 'published' | 'archived'.
  status         String    @default("draft")
  parentVersionId String?
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  subjects     CurriculumSubject[]
  parentVersion Curriculum?        @relation("CurriculumVersion", fields: [parentVersionId], references: [id])
  childVersions Curriculum[]       @relation("CurriculumVersion")
  topics       Topic[]
  units        Unit[]

  @@unique([organizationId, classId, academicYearId, version])
  @@index([organizationId])
  @@index([parentVersionId])
}

model CurriculumSubject {
  id             String  @id @default(uuid())
  /// P0.4: the fork left this join table without an organizationId, which made
  /// it the one school table the tenancy extension could not scope and RLS
  /// could not police. Added here per ROADMAP ground rule 4 ("company_id on
  /// every table from day one").
  organizationId String
  curriculumId   String
  subjectId      String
  periodsPerWeek Int     @default(4)
  isCore         Boolean @default(true)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])

  topics Topic[]
  units  Unit[]

  @@unique([curriculumId, subjectId])
  @@index([organizationId])
  @@index([subjectId])
}

/// Competency (CBC-style) attached to a subject or standalone for a school.
model Competency {
  id             String    @id @default(uuid())
  organizationId String
  subjectId      String?
  code           String
  description    String?
  /// Optional competency level/band (e.g. 'emerging' | 'proficient').
  level          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  subject  Subject?  @relation(fields: [subjectId], references: [id])
  topics   Topic[]

  learningOutcomes LearningOutcome[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([subjectId])
}

/// Topic under a competency (or directly under a curriculum subject).
model Topic {
  id                  String    @id @default(uuid())
  organizationId      String
  curriculumId        String?
  curriculumSubjectId String?
  competencyId        String?
  title               String
  order               Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?

  curriculum        Curriculum?        @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumSubject CurriculumSubject? @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  competency        Competency?        @relation(fields: [competencyId], references: [id])
  units             Unit[]
  learningObjectives LearningObjective[]
  learningOutcomes   LearningOutcome[]

  @@index([organizationId])
  @@index([curriculumId])
  @@index([curriculumSubjectId])
  @@index([competencyId])
}

/// Unit under a topic (or directly under a curriculum subject).
model Unit {
  id                  String    @id @default(uuid())
  organizationId      String
  curriculumId        String?
  curriculumSubjectId String?
  topicId             String?
  title               String
  description         String?
  order               Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?

  curriculum        Curriculum?        @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumSubject CurriculumSubject? @relation(fields: [curriculumSubjectId], references: [id], onDelete: Cascade)
  topic             Topic?             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  learningObjectives LearningObjective[]

  @@index([organizationId])
  @@index([curriculumId])
  @@index([curriculumSubjectId])
  @@index([topicId])
}

/// Learning objective (first-class, optionally tied to a Bloom level) under a unit/topic.
model LearningObjective {
  id             String    @id @default(uuid())
  organizationId String
  unitId         String?
  topicId        String?
  description    String
  /// Bloom's taxonomy level: 'remember' | 'understand' | 'apply' | 'analyze' | 'evaluate' | 'create'.
  bloomLevel     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lessonPlanObjectives LessonPlanObjective[]

  @@index([organizationId])
  @@index([unitId])
  @@index([topicId])
}

model LessonPlan {
  id               String    @id @default(uuid())
  organizationId   String
  /// NEW (Phase 1): teaching instance this plan belongs to.
  courseOfferingId String?
  /// Specific curriculum version row (published Curriculum).
  curriculumVersionId String?
  subjectId        String
  classId          String?
  termId           String?
  teacherPartnerId String?
  weekOf           DateTime
  title            String
  /// Denormalized free-text summary (kept for search/backwards-compat). First-class
  /// objectives live on LearningObjective and link here via LessonPlanObjective.
  objectives       String?
  materials        String?
  /// NEW (Phase 1): richer curriculum linkage.
  unitId           String?
  topicId          String?
  subtopic         String?
  /// Phase 1 workflow status. Replaces the minimal 'draft'|'published'.
  /// draft | submitted | needs_revision | approved | archived
  workflowStatus   String    @default("draft")
  /// Optimistic concurrency guard (reject stale writes on update).
  version          Int       @default(1)
  /// Backwards-compat thin status; kept until consumers migrate.
  status           String    @default("draft")
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subject Subject       @relation(fields: [subjectId], references: [id])
  term    Term?         @relation(fields: [termId], references: [id])
  teacher StaffProfile? @relation(fields: [teacherPartnerId], references: [id])
  learningObjectives LessonPlanObjective[]
  lessonPlanActivities LessonPlanActivity[]
  lessonPlanResources LessonPlanResource[]
  lessonPlanAssessments LessonPlanAssessment[]
  lessonPlanDifferentiations LessonPlanDifferentiation[]
  lessonPlanReflections LessonPlanReflection[]
  lessonPlanReviews LessonPlanReview[]
  lessonPlanRevisions LessonPlanRevision[]
  scheduledLessons ScheduledLesson[]
  discussions Discussion[]

  @@index([organizationId])
  @@index([subjectId])
  @@index([teacherPartnerId])
}

/// Join: a lesson plan references specific learning objectives it covers.
model LessonPlanObjective {
  id                String @id @default(uuid())
  organizationId    String
  lessonPlanId      String
  learningObjectiveId String
  deletedAt         DateTime?

  lessonPlan      LessonPlan       @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  learningObjective LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, learningObjectiveId])
  @@index([organizationId])
  @@index([learningObjectiveId])
}

/// ─────────────── LMS (Phase 1) ───────────────
/// Teaching instance of a subject: Subject+Class+Section+Term+Curriculum(version row).
/// Teacher is NOT part of the identity — team-teaching handled via CourseOfferingTeacher.
model CourseOffering {
  id               String   @id @default(uuid())
  organizationId   String
  academicYearId   String
  termId           String
  subjectId        String
  classId          String
  sectionId        String?
  /// Specific Curriculum version row (point at a published Curriculum, not a bare class).
  curriculumId     String
  status           String   @default("active") // active | archived
  /// ── Moodle-shaped course settings (ADR-014). ──
  format               CourseFormat @default(weeks)
  numSections          Int          @default(14)
  startDate            DateTime?
  endDate              DateTime?
  summary              String?
  summaryFormat        String       @default("html")
  visible              Boolean      @default(true)
  groupMode            GroupMode    @default(none)
  forceGroupMode       Boolean      @default(false)
  completionEnabled    Boolean      @default(true)
  showGradesToStudents Boolean      @default(true)
  categoryId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  teachers CourseOfferingTeacher[]
  scheduledLessons ScheduledLesson[]
  discussions Discussion[]
  timetableSlots TimetableSlot[]
  sections           CourseSection[]
  modules            CourseModule[]
  enrolmentMethods   CourseEnrolmentMethod[]
  enrolments         CourseEnrolment[]
  groups             LmsGroup[]
  groupings          LmsGrouping[]
  completionCriteria CourseCompletionCriteria[]

  @@unique([organizationId, academicYearId, termId, subjectId, classId, sectionId])
  @@index([organizationId])
  @@index([classId])
  @@index([subjectId])
