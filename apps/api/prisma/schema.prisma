model HrDepartment {
  id             String    @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  managerId      String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
