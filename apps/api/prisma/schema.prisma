enum GradeEntryStatus {
  draft
  submitted
  approved
  rejected
}

// ─────────────────────────── Assessment core (A1) ───────────────────────────
// The assessment spine: policy → component → assessment → student assessment →
// marks. GradeEntry becomes legacy evidence projected into this shape.

enum AssessmentKind {
  exam
  cat
  homework
  classwork
  practical
  project
  oral
  attendance
}

enum AssessmentSourceType {
  manual
  /// An A2 `Assignment` (sourceRef is null — see the note on Assessment).
  assignment
  exam_session
  quiz
  lms_activity
  /// A `HomeworkAssignment`. Split out of `assignment`, which the two used to
  /// share, distinguished only by whether `sourceRef` was null — and the unique
  /// key tolerates unlimited nulls, so "one assessment per origin row" was false.
  homework
}

enum AssessmentStatus {
  draft
  scheduled
  published
  open
  closed
  grading
  graded
  archived
}

/// Exam-day participation fact, distinct from the marking-workflow `status`.
enum ParticipationStatus {
  present
  absent
  exempt
  excused
  malpractice
  special_consideration
}

/// Workflow position of one student's work on one assessment.
enum StudentAssessmentStatus {
  assigned
  opened
  in_progress
  submitted
  resubmitted
  returned
  resubmission_requested
  graded
}

/// Multi-marker support: first mark, blind second mark, agreed reconciliation.
enum MarkRound {
  first
  second_blind
  reconciliation
}

enum MarkAdjustmentKind {
  moderation
  scaling
  late_penalty
  special_consideration
  correction
}

/// Where in a computation values are rounded. Snapshotted into results (A3).
enum RoundingMode {
  half_up
  half_even
  floor
  ceil
}

enum AggregationMethod {
  mean
  sum
  best_n
  last
  weighted_mean
}

// ─────────────────── Rosters + assignment evidence (A2) ───────────────────

enum RosterScopeType {
  class
  section
  subject
  grade
}

enum RosterSource {
  derived_current_class
  enrollment
  manual_import
}

enum AssignmentGradingMode {
  points
  rubric
  complete_incomplete
}

// ─────────────────────────── Result spine (A3) ───────────────────────────

enum ResultScopeType {
  class
  section
  grade
  campus
  school
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum ResultSetStatus {
  draft
  computing
  computed
  approved
  published
  locked
  archived
}

enum AmendmentStatus {
  requested
  approved
  rejected
  applied
}

enum PromotionRecommendation {
  promote
  repeat
  graduate
  review
}

model ExamType {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// Weight in overall term score (e.g. CAT1=10, Midterm=30, Final=40).
  weight         Decimal   @db.Decimal(5, 2)
  isFinal        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  exams Exam[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Exam {
  id             String     @id @default(uuid())
  organizationId String
  termId         String
  examTypeId     String
  name           String
  startDate      DateTime
  endDate        DateTime
  /// DEPRECATED (A4): class IDs as a JSON array. Superseded by ExamRegistration
  /// (a real candidate row). Kept for backfill provenance; new code uses
  /// registrations. Do not read this for coverage.
  classes        Json       @default("[]")
  status         ExamStatus @default(draft)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  term          Term               @relation(fields: [termId], references: [id])
  examType      ExamType           @relation(fields: [examTypeId], references: [id])
  schedules     ExamSchedule[]
  registrations ExamRegistration[]

  @@index([organizationId])
  @@index([termId])
  @@index([status])
}

/// One exam paper sitting: "Mathematics Paper 1 — 10 Nov 09:00, Room A". Acts
/// as the exam "session" (A4) — session-level fields (paper number, sitting,
/// resit, venue) live here rather than in a separate table, to keep the A1
/// GradeEntry adapter and A3 result flow (which key on examScheduleId) intact.
model ExamSchedule {
  id              String   @id @default(uuid())
  organizationId  String
  examId          String
  classId         String
  subjectId       String
  date            DateTime
  startTime       String // 'HH:mm'
  durationMinutes Int      @default(60)
  invigilatorId   String?
  maxMarks        Decimal  @default(100) @db.Decimal(8, 2)
  // A4 session detail (all additive/optional).
  paperNumber     Int?
  /// 'morning' | 'afternoon'.
  sitting         String?
  isResit         Boolean  @default(false)
  venueId         String?
  /// Marks lock — an admin freezes entry for this paper. Distinct from the
  /// GradeEntry approval workflow (which is SoD-guarded); this is the plain
  /// "no more edits" switch the exam office actually asks for.
  marksLockedAt   DateTime?
  marksLockedById String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass  @relation(fields: [classId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  venue        ExamVenue?   @relation(fields: [venueId], references: [id])
  gradeEntries GradeEntry[]
  invigilatorAssignments InvigilatorAssignment[]
  questionPapers QuestionPaper[]

  @@unique([examId, classId, subjectId])
  @@index([organizationId])
  @@index([classId, date])
  @@index([venueId])
}

enum ExamRegistrationStatus {
  registered
  sat
  absent
  withheld
}

/// A physical exam room. Capacity drives seat allocation + clash detection.
model ExamVenue {
  id             String    @id @default(uuid())
  organizationId String
  campusId       String?
  name           String
  code           String?
  capacity       Int       @default(30)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  schedules     ExamSchedule[]
  registrations ExamRegistration[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// A candidate registered to sit an exam — replaces the untyped Exam.classes
/// JSON with a real, seat-allocatable, status-tracked row.
model ExamRegistration {
  id               String                 @id @default(uuid())
  organizationId   String
  examId           String
  studentProfileId String
  classId          String?
  venueId          String?
  seatNumber       String?
  status           ExamRegistrationStatus @default(registered)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  exam  Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  venue ExamVenue? @relation(fields: [venueId], references: [id])

  @@unique([examId, studentProfileId])
  @@index([organizationId])
  @@index([examId])
  @@index([organizationId, studentProfileId])
}

// ───────────── Invigilator roster (A4) ─────────────
// Staff who supervise exams. Distinct from teaching staff so a school can run a
// pool of invigilators (teachers + non-teachers) and assign them to sittings.
model Invigilator {
  id             String    @id @default(uuid())
  organizationId String
  /// Staff/partner id when the invigilator is a school employee; null for
  /// external invigilators (named free-text instead).
  staffId        String?
  name           String
  /// Optional free-text qualifier (e.g. "External — UNEB", "Maths Dept").
  note           String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  assignments InvigilatorAssignment[]

  @@unique([organizationId, staffId])
  @@index([organizationId])
}

/// A single invigilator ↔ exam-schedule binding. Drives the A4 clash check
/// already implemented in ExamScheduleService (INVIGILATOR_CLASH).
model InvigilatorAssignment {
  id              String   @id @default(uuid())
  organizationId  String
  examScheduleId  String
  invigilatorId   String
  createdAt       DateTime @default(now())

  examSchedule ExamSchedule  @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  invigilator Invigilator    @relation(fields: [invigilatorId], references: [id], onDelete: Cascade)

  @@unique([examScheduleId, invigilatorId])
  @@index([organizationId])
  @@index([examScheduleId])
  @@index([invigilatorId])
}

// ───────────── Learning outcomes (P1-B) ─────────────
// A learning outcome is a measurable target attached to a subject/topic. Student
// achievement against each outcome is captured per term and feeds competency
// reports. Unlike a Competency (a broad strand), an outcome is concrete and
// assessable ("Solve quadratic equations").
model LearningOutcome {
  id             String    @id @default(uuid())
  organizationId String
  subjectId      String?
  topicId        String?
  competencyId   String?
  title          String
  description    String?
  /// Expected proficiency band, e.g. 'basic' | 'proficient' | 'advanced'.
  expectedLevel  String?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  subject      Subject?      @relation(fields: [subjectId], references: [id])
  topic        Topic?        @relation(fields: [topicId], references: [id])
  competency   Competency?   @relation(fields: [competencyId], references: [id])
  achievements StudentOutcomeAchievement[]

  @@index([organizationId])
  @@index([subjectId])
  @@index([topicId])
  @@index([competencyId])
}

/// Per-student per-outcome achievement for a term.
model StudentOutcomeAchievement {
  id                String    @id @default(uuid())
  organizationId    String
  studentProfileId  String
  learningOutcomeId String
  termId            String
  /// Achieved level: 'not_met' | 'approaching' | 'met' | 'exceeded'.
  level             String    @default("not_met")
  /// 0–100 mastery percentage, optional but used for aggregation.
  masteryPercent    Int?
  comment           String?
  assessedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  learningOutcome LearningOutcome @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)
  student        StudentProfile  @relation(fields: [studentProfileId], references: [id])

  @@unique([studentProfileId, learningOutcomeId, termId])
  @@index([organizationId])
  @@index([studentProfileId, termId])
  @@index([learningOutcomeId])
}

// ───────────── Traditional question papers (P2-A) ─────────────
// Paper-based (non-CBT) question papers, authored by teachers, attached to an
// ExamSchedule sitting. Distinct from CBT `Paper` so schools can keep a printed
// paper archive alongside computer-based testing.
model QuestionPaper {
  id              String    @id @default(uuid())
  organizationId  String
  examScheduleId  String
  title           String
  /// 'theory' | 'practical' | 'alternative_to_practical' | 'oral'.
  paperKind       String    @default("theory")
  paperNumber     Int?
  totalMarks      Decimal   @default(0) @db.Decimal(8, 2)
  /// Free-form question list (number, text, marks) — a printable paper.
  questions        Json      @default("[]")
  /// Uploaded paper source (PDF/DOCX) URL.
  fileUrl          String?
  /// Setter/moderator sign-off.
  setterId         String?
  moderatorId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([examScheduleId])
}

model GradeEntry {
  id               String           @id @default(uuid())
  organizationId   String
  examScheduleId   String
  studentProfileId String
  marksObtained    Decimal?         @db.Decimal(8, 2)
  maxMarks         Decimal          @db.Decimal(8, 2)
  /// Computed grade letter (A/B/C/...).
  grade            String?
  /// Computed grade point (GPA).
  gradePoint       Decimal?         @db.Decimal(4, 2)
  remarks          String?
  status           GradeEntryStatus @default(draft)
  /// A0: actor (User) id who entered these marks — a plain actor reference,
  /// symmetric with `approvedById`. It previously carried a StaffProfile FK
  /// while the code stored a User id, so the constraint could never be
  /// satisfied; the FK is dropped.
  enteredById      String?
  enteredAt        DateTime?
  approvedById     String?
  approvedAt       DateTime?
  /// A0: reason a marks-approval was rejected, so `rejected → resubmit` carries context.
  rejectionReason  String?
  /// A0: optimistic-concurrency guard — see kernel/common/optimistic-update.ts.
  version          Int              @default(0)
  customFields     Json             @default("{}")

  examSchedule   ExamSchedule   @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@unique([examScheduleId, studentProfileId])
  @@index([organizationId])
  @@index([studentProfileId])
  @@index([status])
}

model GradingScale {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// Bands: [{min:80, max:100, grade:'A', gpa:4.0, remark:'Distinction'}, ...]
  bands          Json
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ReportCard {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  termId           String
  generatedAt      DateTime  @default(now())
  /// Full report card payload (subjects, grades, GPA, rank, comments).
  payload          Json
  pdfUrl           String?
  publishedAt      DateTime?
  customFields     Json      @default("{}")
  /// Per-student free-text narrative persisted at generation time. These are
  /// captured via the report-card comment endpoints (P0-A) and rendered into
  /// the payload + PDF footer.
  classTeacherComment String?
  principalComment   String?
  /// Persisted competency levels keyed by competencyId (CBC strand outcomes).
  competencyLevels   Json      @default("{}")

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([termId])
}

model AcademicTranscript {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  generatedAt      DateTime @default(now())
  payload          Json
  pdfUrl           String?

  @@index([organizationId])
  @@index([studentProfileId])
}

/// Org-scoped configuration for the printable student report card
/// (school header colors, logo/photo/watermark/comment/date/fees/motto visibility).
/// Exactly one per organization; created lazily on first read with org defaults.
model ReportCardSettings {
  id                       String   @id @default(uuid())
  organizationId           String   @unique
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  showSchoolLogo           Boolean  @default(true)
  showStudentPhoto         Boolean  @default(true)
  showWatermark            Boolean  @default(false)
  showClassTeacherComment  Boolean  @default(true)
  showHeadTeacherComment   Boolean  @default(true)
  showTermStartDate        Boolean  @default(false)
  showTermEndDate          Boolean  @default(true)
  showFeesBalance          Boolean  @default(false)
  showSchoolMotto          Boolean  @default(true)

  schoolNameColor          String   @default("#000000")
  schoolAddressColor       String   @default("#000000")
  contactColor             String   @default("#000000")
  websiteColor             String   @default("#000000")
  emailColor               String   @default("#000000")
  reportTitleColor         String   @default("#000000")

  /// Every option added after v1 lives here, keyed by the field registry in
  /// report-card-settings.schema.ts — page size, typography, table columns,
  /// block order, comment/footer text, and so on. Storing them as JSON keeps
  /// new customisation options migration-free.
  config                   Json      @default("{}")
  /// Last named preset applied ('classic' | 'modern' | 'minimal' | 'bold' |
  /// 'formal'), or null once the configuration has been hand-tuned.
  presetKey                String?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([organizationId])
}

// ─────────────────────────── Assessment core (A1) ───────────────────────────
// Scope ids (gradeLevelId/classId/subjectId/termId/studentProfileId) are loose
// references with indexes, following the established Curriculum/LearningResource
// pattern; org-scoping is enforced by the tenancy extension + RLS. FKs are used
// only *within* the assessment cluster (policy→component→assessment→…→marks),
// where both ends are new, so cascade + integrity hold across the subsystem.

/// The weighting scheme for a scope. Resolved most-specific-first
/// (subject+class+term > subject+class > subject+gradeLevel > … > org default).
model AssessmentPolicy {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  // Scope — any subset may be null; more non-null fields = more specific.
  gradeLevelId   String?
  classId        String?
  subjectId      String?
  termId         String?
  passMark       Decimal   @default(50) @db.Decimal(5, 2)
  /// Optional ceiling on the total CA (non-exam) contribution, in percent.
  caCap          Decimal?  @db.Decimal(5, 2)
  roundingMode   RoundingMode @default(half_up)
  decimalPlaces  Int       @default(2)
  /// { tie, scope, inclusion, rankOn } — snapshotted into ResultSet at compute (A3).
  rankingPolicy     Json   @default("{}")
  aggregationPolicy Json   @default("{}")
  isActive       Boolean   @default(true)
  /// Optimistic concurrency guard — see kernel/common/optimistic-update.ts.
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  components AssessmentComponent[]

  @@index([organizationId])
  @@index([organizationId, subjectId, classId, gradeLevelId, termId])
}

/// A weighted bucket within a policy (e.g. "Final Exam, 50%, mean").
model AssessmentComponent {
  id                 String   @id @default(uuid())
  organizationId     String
  policyId           String
  name               String
  kind               AssessmentKind
  /// Weight in percentage points; components under a policy should sum to 100.
  weight             Decimal  @db.Decimal(6, 3)
  aggregation        AggregationMethod @default(mean)
  bestN              Int?
  /// When true, an `absent` assessment scores zero; when false it is excluded.
  countsAbsentAsZero Boolean  @default(true)
  /// Loose bridge to the legacy ExamType this component subsumes (nullable).
  examTypeId         String?
  order              Int      @default(0)
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  policy      AssessmentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([organizationId])
  @@index([policyId])
  @@index([organizationId, examTypeId])
}

/// A concrete assessment instance ("Math CAT 2", "Physics Paper 1", "Homework 3").
model Assessment {
  id                String   @id @default(uuid())
  organizationId    String
  /// Nullable: an adapter-projected exam mark is unattached until a policy maps
  /// it to a weighting bucket. Manual/assignment/quiz assessments attach on create.
  componentId       String?
  subjectId         String
  classId           String
  /// Stream/section, when the assessment is narrower than the whole class.
  sectionId         String?
  termId            String
  title             String
  /// CAT 1 / CAT 2, exam paper number — orders same-kind assessments in a term.
  sequence          Int?
  /// Teacher who owns this assessment (StaffProfile.id). Lets the approvals
  /// queue say "submitted by Mr John" without joining through the mark ledger.
  /// NOTE: distinct from `StudentAssessment.enteredById`, which is a User id.
  teacherPartnerId  String?
  maxScore          Decimal  @default(100) @db.Decimal(8, 2)
  /// Relative weight if a component aggregates several assessments (e.g. best-N).
  weightInComponent Decimal  @default(1) @db.Decimal(6, 3)
  /// What this assessment IS, independent of whether a weighting component has
  /// been attached yet. Kind used to be reachable only through
  /// `component.kind`, so an adapter-projected exam mark was typeless — which
  /// is precisely what made one "Assessments" list, filterable by CAT /
  /// homework / exam, impossible to build.
  ///
  /// Mandatory. It was nullable only while the backfill needed to tell "not
  /// yet classified" apart from "classified as cat"; both producers and data
  /// are now complete, so the legacy read-time guess is retired.
  kind              AssessmentKind
  sourceType        AssessmentSourceType @default(manual)
  /// FK-less link to the origin row (examScheduleId, assignmentId, quizId).
  sourceRef         String?
  status            AssessmentStatus @default(draft)
  dueAt             DateTime?
  /// Moodle grade-item hide/lock (ADR-014 §3.5).
  hiddenFromStudents Boolean @default(false)
  lockedAt          DateTime?
  lockedById        String?
  /// Resit sitting of the same paper — carried over from ExamSchedule.
  isResit           Boolean  @default(false)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  component          AssessmentComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  studentAssessments StudentAssessment[]
  assignment         Assignment?

  /// One assessment per origin row — makes the GradeEntry adapter idempotent.
  @@unique([organizationId, sourceType, sourceRef])
  @@index([organizationId])
  @@index([organizationId, classId, termId, subjectId])
  @@index([organizationId, termId, kind])
  @@index([organizationId, teacherPartnerId])
  @@index([componentId])
}

/// One student's participation + canonical score on one assessment.
model StudentAssessment {
  id               String   @id @default(uuid())
  organizationId   String
  assessmentId     String
  studentProfileId String
  // Position snapshot captured at write time (A2 rosters refine this).
  classId          String?
  sectionId        String?
  gradeLevelId     String?
  termId           String?
  status           StudentAssessmentStatus @default(assigned)
  participation    ParticipationStatus     @default(present)
  maxScore         Decimal  @db.Decimal(8, 2)
  /// Reconciled from MarkEntry rounds (reconciliation ?? first).
  originalScore    Decimal? @db.Decimal(8, 2)
  /// originalScore after the ordered MarkAdjustment ledger, clamped to [0, maxScore].
  effectiveScore   Decimal? @db.Decimal(8, 2)
  percentage       Decimal? @db.Decimal(6, 3)
  /// Marking-approval workflow, reusing the GradeEntry enum (draft→submitted→approved/rejected).
  approvalStatus   GradeEntryStatus @default(draft)
  enteredById      String?
  enteredAt        DateTime?
  approvedById     String?
  approvedAt       DateTime?
  /// Why an approver sent the marks back. Carried over from GradeEntry so the
  /// spine can own the whole approval workflow.
  rejectionReason  String?
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  assessment            Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  markEntries           MarkEntry[]
  adjustments           MarkAdjustment[]
  rubricScores          AssessmentRubricScore[]
  assignmentSubmissions AssignmentSubmission[]

  @@unique([assessmentId, studentProfileId])
  @@index([organizationId])
  @@index([organizationId, studentProfileId])
  @@index([organizationId, studentProfileId, termId])
}

/// A single marker's score in one marking round. Multiple rounds support
/// blind double-marking; the reconciliation round is the agreed mark.
model MarkEntry {
  id                  String   @id @default(uuid())
  organizationId      String
  studentAssessmentId String
  markerId            String?
  round               MarkRound @default(first)
  score               Decimal  @db.Decimal(8, 2)
  comment             String?
  enteredAt           DateTime @default(now())

  studentAssessment StudentAssessment @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)

  @@unique([studentAssessmentId, round])
  @@index([organizationId])
}

/// Append-only ledger of non-arithmetic mark changes (moderation, scaling,
/// penalties, corrections). A DB trigger blocks UPDATE/DELETE.
model MarkAdjustment {
  id                  String   @id @default(uuid())
  organizationId      String
  studentAssessmentId String
  sequence            Int
  kind                MarkAdjustmentKind
  /// Additive change...
  delta               Decimal? @db.Decimal(8, 2)
  /// ...OR an absolute replacement (exactly one of delta/replacementScore set).
  replacementScore    Decimal? @db.Decimal(8, 2)
  reason              String
  requestedById       String?
  approvedById        String?
  createdAt           DateTime @default(now())

  studentAssessment StudentAssessment @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)

  @@unique([studentAssessmentId, sequence])
  @@index([organizationId])
  @@index([studentAssessmentId])
}

// ─────────────────── Rosters + assignment evidence (A2) ───────────────────
// The AcademicRoster is the enrollment-independent academic cohort: captured
// (from currentClassId or elsewhere), reviewed, then FROZEN. A frozen roster is
// immutable and is what assignments fan out over and result runs (A3) bind to.
// currentClassId is only ever an *input* to capture, never academic truth.

model AcademicRoster {
  id             String          @id @default(uuid())
  organizationId String
  termId         String
  scopeType      RosterScopeType @default(class)
  classId        String?
  sectionId      String?
  subjectId      String?
  name           String?
  source         RosterSource    @default(derived_current_class)
  capturedById   String?
  capturedAt     DateTime        @default(now())
  /// Once set, the roster is immutable — members can no longer change.
  frozenAt       DateTime?
  frozenById     String?
  version        Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  members AcademicRosterMember[]

  @@index([organizationId])
  @@index([organizationId, termId, classId])
}

model AcademicRosterMember {
  id               String    @id @default(uuid())
  organizationId   String
  rosterId         String
  studentProfileId String
  // Position snapshot captured at roster-capture time.
  classId          String?
  sectionId        String?
  gradeLevelId     String?
  /// Effective range expresses a mid-term class move without silent re-attribution.
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  joinReason       String?
  exitReason       String?
  createdAt        DateTime  @default(now())

  roster AcademicRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  @@unique([rosterId, studentProfileId])
  @@index([organizationId])
  @@index([rosterId])
}

/// A grading rubric. Versioned: editing a rubric forks a new version so work
/// graded under the old version stays reproducible.
model Rubric {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  version        Int       @default(1)
  /// Set on the OLD row when a new version supersedes it.
  supersededById String?
  isActive       Boolean   @default(true)
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  criteria RubricCriterion[]

  @@index([organizationId])
}

model RubricCriterion {
  id             String   @id @default(uuid())
  organizationId String
  rubricId       String
  name           String
  description    String?
  weight         Decimal  @default(1) @db.Decimal(6, 3)
  maxScore       Decimal  @db.Decimal(8, 2)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rubric Rubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels RubricLevel[]

  @@index([organizationId])
  @@index([rubricId])
}

model RubricLevel {
  id             String   @id @default(uuid())
  organizationId String
  criterionId    String
  label          String
  score          Decimal  @db.Decimal(8, 2)
  descriptor     String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([criterionId])
}

/// Canonical relational rubric grading: one row per (studentAssessment,
/// criterion). A denormalised JSON snapshot is kept on the submission for
/// rendering; THIS is the queryable source for "how did the class do on X?".
model AssessmentRubricScore {
  id                  String   @id @default(uuid())
  organizationId      String
  studentAssessmentId String
  criterionId         String
  levelId             String?
  score               Decimal  @db.Decimal(8, 2)
  comment             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studentAssessment StudentAssessment @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)

  @@unique([studentAssessmentId, criterionId])
  @@index([organizationId])
  @@index([studentAssessmentId])
}

/// An assignment: the delivery detail for an Assessment of sourceType='assignment'.
/// 1:1 with its Assessment; publishing fans the roster out into StudentAssessment.
model Assignment {
  id                 String   @id @default(uuid())
  organizationId     String
  assessmentId       String   @unique
  rosterId           String?
  instructions       String?
  allowLate          Boolean  @default(false)
  latePenaltyPercent Decimal  @default(0) @db.Decimal(5, 2)
  lateCutoffAt       DateTime?
  maxAttempts        Int      @default(1)
  gradingMode        AssignmentGradingMode @default(points)
  rubricId           String?
  rubricVersion      Int?
  attachments        Json     @default("[]")
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  assessment  Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([organizationId])
  @@index([rosterId])
}

/// A student's submitted work for an assignment. Participation truth lives on
/// StudentAssessment; this is the artefact + per-attempt scoring.
model AssignmentSubmission {
  id                  String   @id @default(uuid())
  organizationId      String
  assignmentId        String
  studentAssessmentId String
  attemptNo           Int      @default(1)
  submittedAt         DateTime?
  isLate              Boolean  @default(false)
  content             String?
  attachments         Json     @default("[]")
  /// Raw marker score before the late penalty.
  rawScore            Decimal? @db.Decimal(8, 2)
  /// Points deducted for lateness (rawScore − penaltyApplied lands as the mark).
  penaltyApplied      Decimal? @db.Decimal(8, 2)
  /// Snapshot of the rubric scores at grade time, for historical rendering.
  rubricSnapshot      Json?
  version             Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assignment        Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentAssessment StudentAssessment @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentAssessmentId, attemptNo])
  @@index([organizationId])
  @@index([studentAssessmentId])
}

// ─────────────────────────── Result spine (A3) ───────────────────────────
// Marks are facts; results are DERIVED. A run computes a ResultSet (a versioned,
// immutable-once-published snapshot) from a frozen roster under a snapshotted
// policy. Report cards, transcripts, certificates, promotion and analytics read
// StudentTermResult / StudentSubjectResult — never raw marks.

/// One operational batch: "what exactly happened when we computed Term 2".
model ResultProcessingRun {
  id                 String    @id @default(uuid())
  organizationId     String
  termId             String
  scopeType          ResultScopeType @default(class)
  scopeId            String?
  rosterId           String?
  calculationVersion String    @default("v1")
  status             RunStatus @default(queued)
  initiatedById      String?
  startedAt          DateTime?
  completedAt        DateTime?
  inputChecksum      String?
  outputChecksum     String?
  errorCount         Int       @default(0)
  report             Json      @default("{}")
  /// Idempotency key so a retried compute returns the same run, not a duplicate.
  idempotencyKey     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  resultSets ResultSet[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, termId])
}

/// A versioned, scoped set of computed results. Immutable once published — a
/// DB trigger blocks UPDATE/DELETE in published/locked/archived. Corrections go
/// through an amendment → new revision, never a mutation.
model ResultSet {
  id                     String          @id @default(uuid())
  organizationId         String
  runId                  String?
  termId                 String
  scopeType              ResultScopeType @default(class)
  scopeId                String?
  rosterId               String?
  revision               Int             @default(1)
  status                 ResultSetStatus @default(draft)
  calculationVersion     String          @default("v1")
  roundingMode           RoundingMode    @default(half_up)
  gradingSystem          String?
  // Immutable historical snapshots of the config the numbers were produced under.
  policySnapshot         Json            @default("{}")
  gradingScaleSnapshot   Json            @default("{}")
  rankingPolicySnapshot  Json            @default("{}")
  aggregationSnapshot    Json            @default("{}")
  inputChecksum          String?
  outputChecksum         String?
  studentCount           Int             @default(0)
  publishedAt            DateTime?
  publishedById          String?
  version                Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  run            ResultProcessingRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  subjectResults StudentSubjectResult[]
  termResults    StudentTermResult[]
  amendments     AmendmentRequest[]

  @@index([organizationId])
  @@index([organizationId, termId, scopeType, scopeId])
}

/// A student's result in one subject within a ResultSet.
model StudentSubjectResult {
  id                 String   @id @default(uuid())
  organizationId     String
  resultSetId        String
  studentProfileId   String
  subjectId          String
  // Position snapshot.
  classId            String?
  sectionId          String?
  gradeLevelId       String?
  termId             String?
  caScore            Decimal? @db.Decimal(8, 3)
  examScore          Decimal? @db.Decimal(8, 3)
  finalPercent       Decimal? @db.Decimal(6, 3)
  grade              String?
  gradePoint         Decimal? @db.Decimal(4, 2)
  /// UCE/UACE subject points (lower = better); null for non-points systems.
  points             Int?
  subjectRank        Int?
  /// Per-component contribution breakdown — answers "why this final percent?".
  componentBreakdown Json     @default("[]")
  createdAt          DateTime @default(now())

  resultSet ResultSet @relation(fields: [resultSetId], references: [id], onDelete: Cascade)

  @@unique([resultSetId, studentProfileId, subjectId])
  @@index([organizationId])
  @@index([organizationId, studentProfileId])
  @@index([resultSetId])
}

/// A student's overall term result within a ResultSet.
model StudentTermResult {
  id                      String   @id @default(uuid())
  organizationId          String
  resultSetId             String
  studentProfileId        String
  classId                 String?
  sectionId               String?
  gradeLevelId            String?
  termId                  String?
  gpa                     Decimal? @db.Decimal(4, 2)
  aggregate               Int?
  division                String?
  meanPercent             Decimal? @db.Decimal(6, 3)
  classRank               Int?
  sectionRank             Int?
  subjectsCount           Int      @default(0)
  eligible                Boolean  @default(true)
  promotionRecommendation PromotionRecommendation @default(review)
  incompleteReason        String?
  createdAt               DateTime @default(now())

  resultSet ResultSet @relation(fields: [resultSetId], references: [id], onDelete: Cascade)

  @@unique([resultSetId, studentProfileId])
  @@index([organizationId])
  @@index([organizationId, studentProfileId])
  @@index([resultSetId])
}

/// A request to change a published ResultSet — the ONLY path back into a
/// published set. Approval drives a fresh run → a new revision; the old
/// revision is archived, never edited.
model AmendmentRequest {
  id               String          @id @default(uuid())
  organizationId   String
  resultSetId      String
  reason           String
  detail           Json            @default("{}")
  status           AmendmentStatus @default(requested)
  requestedById    String?
  reviewedById     String?
  newResultSetId   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  resultSet ResultSet @relation(fields: [resultSetId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([resultSetId])
}

// ─────────────────────────── CBT engine (A5) ───────────────────────────
// Question bank → papers → server-authoritative attempts. Questions are
// versioned (an edit forks) so a historical attempt stays reproducible; the
// realised question set is frozen onto the attempt at start.

enum QuestionType {
  mcq_single
  mcq_multi
  true_false
  short_answer
  numeric
  matching
  fill_blank
  essay
}

enum QuizAttemptStatus {
  not_started
  in_progress
  submitted
  auto_submitted
  abandoned
  reset
}

model QuestionBank {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  subjectId      String?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  questions Question[]

  @@index([organizationId])
  @@index([organizationId, subjectId])
}

model Question {
  id             String       @id @default(uuid())
  organizationId String
  bankId         String
  type           QuestionType
  prompt         String
  marks          Decimal      @default(1) @db.Decimal(8, 2)
  /// Auto-mark key for non-option types: { value, tolerance, accepted[], pairs }.
  answerKey      Json         @default("{}")
  /// topic / bloom / difficulty tags for blueprints + item analysis.
  tags           Json         @default("[]")
  difficulty     String?
  version        Int          @default(1)
  supersededById String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  bank    QuestionBank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([organizationId])
  @@index([bankId])
}

model QuestionOption {
  id             String   @id @default(uuid())
  organizationId String
  questionId     String
  label          String
  isCorrect      Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([questionId])
}

model Paper {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  subjectId       String?
  /// NEW (Phase 1): link quizzes into the LMS spine (no new quiz engine).
  courseOfferingId String?
  lessonPlanId     String?
  learningObjectiveId String?
  totalMarks      Decimal   @default(0) @db.Decimal(8, 2)
  durationMinutes Int       @default(60)
  /// Random assembly from a blueprint (draw by tag/difficulty/count) vs a fixed
  /// question list. When true, `blueprint` drives per-attempt assembly.
  isRandom        Boolean   @default(false)
  blueprint       Json      @default("{}")
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  questions PaperQuestion[]
  attempts  QuizAttempt[]

  @@index([organizationId])
}

model PaperQuestion {
  id             String   @id @default(uuid())
  organizationId String
  paperId        String
  questionId     String
  order          Int      @default(0)
  marks          Decimal? @db.Decimal(8, 2)
  createdAt      DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, questionId])
  @@index([organizationId])
  @@index([paperId])
}

/// One student's sitting of a paper. Server-authoritative timing; the realised
/// question set is frozen at start and never regenerated.
model QuizAttempt {
  id                  String            @id @default(uuid())
  organizationId      String
  paperId             String
  studentProfileId    String
  /// NEW (Phase 1): link attempts into the LMS spine.
  courseOfferingId    String?
  lessonPlanId        String?
  learningObjectiveId String?
  /// Optional link to the assessment spine — the auto-marked total lands here.
  studentAssessmentId String?
  attemptNumber       Int               @default(1)
  status              QuizAttemptStatus @default(in_progress)
  startedAt           DateTime          @default(now())
  expiresAt           DateTime
  submittedAt         DateTime?
  /// The exact questions (ids + marks + answer keys) presented — frozen here.
  realisedQuestions   Json              @default("[]")
  autoScore           Decimal?          @db.Decimal(8, 2)
  manualPending       Int               @default(0)
  maxScore            Decimal           @default(0) @db.Decimal(8, 2)
  /// Monotonic server counter — the last accepted client sequence.
  serverSequence      Int               @default(0)
  version             Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  paper     Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  responses QuizResponse[]
  events    AttemptEvent[]

  @@index([organizationId])
  @@index([organizationId, studentProfileId])
  @@index([paperId])
}

model QuizResponse {
  id             String   @id @default(uuid())
  organizationId String
  attemptId      String
  questionId     String
  /// Client-generated idempotency id for the save event (offline-safe sync).
  clientEventId  String?
  /// Client sequence for this question — the highest valid one wins.
  sequenceNumber Int      @default(0)
  response       Json     @default("{}")
  /// Question-behaviour state (tries used, penalty accrued) for interactive/adaptive modes.
  stepData       Json     @default("{}")
  autoScore      Decimal? @db.Decimal(8, 2)
  isCorrect      Boolean?
  needsManual    Boolean  @default(false)
  serverReceivedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([organizationId])
  @@index([attemptId])
}

/// Append-only attempt evidence (focus loss, reconnect, submit, reset). A DB
/// trigger blocks UPDATE/DELETE. Evidence for a human review — never an
/// automatic cheating verdict.
model AttemptEvent {
  id             String   @id @default(uuid())
  organizationId String
  attemptId      String
  type           String
  payload        Json     @default("{}")
  at             DateTime @default(now())

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([attemptId])
}

// ─────────────────────────── Certification (A6) ───────────────────────────

enum CertificateType {
  completion
  leaving
  testimonial
  merit
  award
}

enum CertificateStatus {
  draft
  issued
  revoked
  void
}

/// A national/external board result (UNEB PLE/UCE/UACE) recorded alongside
/// internal results. Structured subject rows are canonical; importedPayload is
/// kept only as provenance.
model ExternalExamResult {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  board            String   @default("UNEB")
  /// 'PLE' | 'UCE' | 'UACE'.
  level            String
  indexNumber      String?
  year             Int
  aggregate        Int?
  division         String?
  verified         Boolean  @default(false)
  importedPayload  Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  subjects ExternalExamSubjectResult[]

  @@unique([organizationId, studentProfileId, level, year])
  @@index([organizationId])
  @@index([organizationId, studentProfileId])
}

model ExternalExamSubjectResult {
  id               String   @id @default(uuid())
  organizationId   String
  externalResultId String
  subject          String
  grade            String
  mark             String?
  result           String?
  createdAt        DateTime @default(now())

  externalResult ExternalExamResult @relation(fields: [externalResultId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([externalResultId])
}

/// An issued credential. Serial numbers come from SequenceService; verification
/// codes are cryptographically random. `revoked` = was valid, later invalidated;
/// `void` = never valid (administrative error).
model Certificate {
  id               String            @id @default(uuid())
  organizationId   String
  studentProfileId String
  type             CertificateType
  status           CertificateStatus @default(issued)
  serialNumber     String
  verificationCode String
  title            String
  /// Snapshot payload (holder name, summary, term/year) at issue time.
  payload          Json              @default("{}")
  issuedAt         DateTime?
  issuedById       String?
  revokedAt        DateTime?
  revokeReason     String?
  voidedAt         DateTime?
  pdfUrl           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, serialNumber])
  @@unique([verificationCode])
  @@index([organizationId])
  @@index([organizationId, studentProfileId])
}

model FeeStructure {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  academicYearId String
  /// JSON array of {code:'TUITION', productId, amount, isOptional}
  components     Json
  /// JSON filter: {gradeLevelIds:[...], classIds:[...]}.
  applicableTo   Json      @default("{}")
  isActive       Boolean   @default(true)
  /// B5 lifecycle: draft | published | archived. Only 'published' is billable.
  status         String    @default("published")
  /// The FeeStructureVersion currently in effect (loose ref).
  currentVersionId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id])
  schedules    FeeSchedule[]
  assignments  StudentFeeAssignment[]

  @@unique([organizationId, name, academicYearId])
  @@index([organizationId])
}

/// P1: A sponsor (company, NGO, individual) that pays fees on behalf of one or
/// more students. The sponsor is a Partner; collections attribute to the
/// student's own Partner but record the sponsorId so reporting can group by
/// sponsor. A sponsorship may carry a per-term cap and validity window.
model Sponsorship {
  id               String   @id @default(uuid())
  organizationId   String
  sponsorId        String // FK Partner (type=organization|individual)
  studentProfileId String
  code             String
  name             String
  /// Optional per-term monetary cap (0/null = uncapped).
  capAmount        Decimal? @db.Decimal(20, 6)
  validFrom        DateTime
  validTo          DateTime?
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?

  sponsor        Partner        @relation(fields: [sponsorId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([sponsorId])
  @@index([studentProfileId])
}

/// Catalog of reusable waiver templates (e.g. "Sibling Discount 25%", "Merit
/// Bursary", "Staff Child", "COVID Relief"). A waiver (Waiver) may be born from
/// a category; the category only pre-fills name/amount/type when creating one.
model WaiverCategory {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  description    String?
  /// 'percentage' (of billed fee) or 'fixed' (absolute amount).
  type           String   @default("percentage")
  /// percentage: 0-100; fixed: absolute monetary value.
  value          Decimal  @db.Decimal(20, 6)
  defaultReason  String?
  /// JSON filter: { gradeLevelIds: [...], classIds: [...] } (null/empty = all).
  appliesTo      Json?    @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// P1: A waiver forgives an amount the school does not expect to collect (distinct
/// from a Discount, which reduces the *billed* amount). A waiver is applied as a
/// credit against a student's open fee invoices (Dr Waiver Expense / Cr AR) and
/// shows on statements as a waived (not paid) amount. A waiver may be born from a
/// WaiverCategory (waiverCategoryId) or created ad-hoc.
model Waiver {
  id                 String   @id @default(uuid())
  organizationId     String
  waiverCategoryId   String?
  studentProfileId  String
  code               String
  name               String
  amount             Decimal  @db.Decimal(20, 6)
  /// JSON: reason / authorizedBy, free-form.
  reason             String?
  documentId         String? // the fee invoice the waiver was applied to (null = whole-student credit)
  applied            Boolean  @default(false)
  /// Set when the waiver was applied as a bad-debt write-off.
  badDebt            Boolean  @default(false)
  /// A4 approval workflow: pending | approved | rejected | applied | reversed.
  /// applyWaiver requires status='approved' and approvedById != createdBy.
  status             String   @default("pending")
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  updatedBy          String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([waiverCategoryId])
  @@index([studentProfileId])
  @@index([documentId])
}

/// P1: A student-held fee credit (overpayment, or a credit created by a refund /
/// withdrawal). Applied automatically by the billing run's allocation step, or
/// manually. Stored-value liability (Dr AR / Cr Fee Credit Liability on creation)
/// that draws down as it settles invoices.
model FeeCredit {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  code             String
  amount           Decimal  @db.Decimal(20, 6)
  /// Remaining unapplied balance. amount - applied = available credit.
  remaining        Decimal  @db.Decimal(20, 6)
  /// Where the credit came from: 'overpayment' | 'refund' | 'advance' | 'adjustment'.
  source           String   @default("overpayment")
  /// active | partially_applied | fully_applied | expired | refunded | reversed (A2)
  status           String   @default("active")
  /// Whether the outstanding balance may be paid out as a refund (A2.1).
  isRefundable     Boolean  @default(true)
  /// The payment/document that funded this credit (for traceability).
  sourcePaymentId  String?
  sourceDocumentId String?
  expiresAt        DateTime?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([studentProfileId])
}

/// P2: Generic school policy store (attendance, grading, late-fee, uniform, etc.).
model SchoolPolicy {
  id           String   @id @default(uuid())
  organizationId String
  /// Stable key, e.g. 'attendance.graceMinutes', 'grading.scale', 'lateFee.percent'
  key          String
  name         String
  category     String   @default("general")
  /// Free-form policy value (number / string / object / array).
  value        Json
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, category])
}

/// P3: Reusable custom-field definitions attached to school entities
/// (Student / Staff / Class / Guardian / etc.). Replaces ad-hoc Json columns.
model CustomField {
  id         String   @id @default(uuid())
  organizationId String
  /// Target entity: 'student' | 'staff' | 'class' | 'guardian' | 'fee' | 'subject'
  entityType String
  name       String
  label      String
  /// 'text' | 'number' | 'date' | 'select' | 'boolean' | 'textarea'
  type       String   @default("text")
  /// For select type.
  options    String[]
  required   Boolean  @default(false)
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?

  @@unique([organizationId, entityType, name])
  @@index([organizationId])
  @@index([organizationId, entityType])
}

model FeeSchedule {
  id             String   @id @default(uuid())
  organizationId String
  feeStructureId String
  termId         String
  dueDate        DateTime
  /// JSON: {type:'percent'|'fixed', value:Number, graceDays:Int}
  lateFeePolicy  Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure       FeeStructure        @relation(fields: [feeStructureId], references: [id])
  term               Term                @relation(fields: [termId], references: [id])
  penaltyRules       PenaltyRule[]
  penaltyRuns        PenaltyRun[]
  penaltyAssessments PenaltyAssessment[]

  @@unique([organizationId, feeStructureId, termId])
  @@index([organizationId])
  @@index([termId])
}

model StudentFeeAssignment {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  feeStructureId   String
  termId           String
  /// Per-student override of components: {code: amount} or null to use defaults.
  customDiscount   Json     @default("{}")
  /// Optional JSON: [{code,type,value}]
  extraDiscounts   Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure   @relation(fields: [feeStructureId], references: [id])
  term           Term           @relation(fields: [termId], references: [id])

  @@unique([organizationId, studentProfileId, feeStructureId, termId])
  @@index([organizationId])
  @@index([studentProfileId])
}

model Discount {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           DiscountType // parent enum: percentage | fixed_amount (was percent | fixed in the fork)
  value          Decimal      @db.Decimal(18, 6)
  /// JSON filter: {gradeLevelIds, classIds, feeCodes:[...]}
  appliesTo      Json         @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Scholarship {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  code             String
  name             String
  /// 'percent' | 'fixed'.
  type             String
  value            Decimal   @db.Decimal(18, 6)
  validFrom        DateTime
  validTo          DateTime?
  awardedBy        String?
  notes            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentProfileId])
}

model InstallmentPlan {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  termId           String
  totalAmount      Decimal  @db.Decimal(20, 6)
  /// JSON: [{number, dueDate, amount}]
  installments     Json
  customFields     Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  term           Term           @relation(fields: [termId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
}

model PenaltyRule {
  id             String   @id @default(uuid())
  organizationId String
  feeScheduleId  String
  /// 'percent' | 'fixed'.
  type           String
  value          Decimal  @db.Decimal(18, 6)
  graceDays      Int      @default(7)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeSchedule FeeSchedule         @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  assessments PenaltyAssessment[]

  @@index([organizationId])
}

model PenaltyRun {
  id              String   @id @default(uuid())
  organizationId  String
  runAt           DateTime @default(now())
  /// P0-2: the date the cron was scheduled to run (UTC, date-only).
  /// Combined with the unique constraint below, this prevents the
  /// daily penalty cron from creating two PenaltyRun rows for the
  /// same schedule on the same day.
  cronDate        DateTime @db.Date
  scheduleId      String
  totalAssessed   Decimal  @db.Decimal(20, 6)
  /// JSON array of created penalty-document IDs.
  createdInvoices Json     @default("[]")
  notes           String?

  schedule    FeeSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assessments PenaltyAssessment[]

  @@unique([organizationId, scheduleId, cronDate])
  @@index([organizationId])
  @@index([scheduleId])
}

/// P0-2: one row per penalty applied to an overdue invoice. Enforces
/// "no duplicate penalty for the same source document in the same
/// PenaltyRun" — the most common case of the silent compounding bug
/// where a daily cron tick would mint a new penalty invoice every
/// 24 h.
model PenaltyAssessment {
  id                String   @id @default(uuid())
  organizationId    String
  penaltyRunId      String
  sourceDocumentId  String
  scheduleId        String
  ruleId            String
  amount            Decimal  @db.Decimal(20, 6)
  /// P0-2: the penalty invoice that was created for this assessment.
  /// Unique because each PenaltyAssessment produces at most one Document
  /// (and Document is the inverse side of a 1:1 relation).
  penaltyDocumentId String?  @unique
  /// When the assessment was created (audit / debugging).
  createdAt         DateTime @default(now())

  penaltyRun      PenaltyRun  @relation(fields: [penaltyRunId], references: [id], onDelete: Cascade)
  sourceDocument  Document    @relation("PenaltySource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  schedule        FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  rule            PenaltyRule @relation(fields: [ruleId], references: [id])
  penaltyDocument Document?   @relation("PenaltyDocument", fields: [penaltyDocumentId], references: [id])

  @@unique([sourceDocumentId, penaltyRunId])
  @@index([organizationId])
  @@index([penaltyRunId])
  @@index([sourceDocumentId])
  @@index([scheduleId])
}


/* ══════════════════════════════════════════════════════════════════════════
   FEES & FINANCE — Production-hardening models (ADR-013).
   Cross-entity FKs are loose refs (String + @@index / @unique), matching the
   established Waiver.documentId pattern, so existing models gain only fields,
   never relation back-references. Status columns are String with documented
   allowed values, matching FeeCredit.source / Scholarship.type.
   ══════════════════════════════════════════════════════════════════════════ */

/// A1.1 — First-class school-domain invoice, bound 1:1 to an accounting
/// Document. School queries (statement, ledger, defaulters, dashboard) read
/// this; the accounting engine keeps binding to Document alone. Financial
/// amounts live on Document and are NOT duplicated here — reading a total means
/// joining, deliberately, so there is no third number to disagree.
model SchoolFeeInvoice {
  id                    String   @id @default(uuid())
  organizationId        String
  invoiceNumber         String
  /// Required 1:1 link. @unique enforces the 1:1 without a Prisma back-relation
  /// on the (very large) Document model.
  documentId            String   @unique
  studentProfileId      String
  academicYearId        String?
  termId                String?
  classId               String?
  sectionId             String?
  /// Provenance stamp (B5). Null for legacy/unmapped invoices — harmless
  /// because DocumentLine already carries the priced snapshot.
  feeStructureVersionId String?
  billingRunId          String?
  /// draft | issued | settled | cancelled | voided. Mirrors the Document
  /// lifecycle; never diverges from it.
  status                String   @default("issued")
  issueDate             DateTime @default(now())
  dueDate               DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             String?
  updatedBy             String?

  /// Business-key uniqueness (A3): the database, not an app existence check,
  /// is what makes concurrent billing produce exactly one invoice per student
  /// per term per fee-structure version.
  @@unique([organizationId, studentProfileId, termId, feeStructureVersionId])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([studentProfileId])
  @@index([termId])
  @@index([billingRunId])
}

/// A2 — the credit subledger. One row per drawdown of a FeeCredit against an
/// invoice. FeeCredit.remaining is the cached projection of
/// amount minus SUM(these) plus SUM(reversals).
/// A live mobile-money collection request (MTN MoMo / Airtel Money).
///
/// A request-to-pay is a PROMPT, not a receipt: money only becomes a Payment
/// when the provider confirms, and then only through SchoolPaymentService.collect
/// like every other tender. This row exists so a bursar can see what was asked
/// for and chase what never completed.
model MobileMoneyRequest {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  /// mtn | airtel
  provider         String
  /// OUR reference, sent to the provider and echoed back on the callback. It
  /// becomes Payment.externalReference, which carries the unique index that
  /// makes at-least-once provider retries idempotent.
  providerRef      String
  /// Normalised payer MSISDN (256XXXXXXXXX).
  msisdn           String
  amount           Decimal   @db.Decimal(20, 6)
  /// pending | succeeded | failed
  status           String    @default("pending")
  note             String?
  failureReason    String?
  /// Set once the callback posted the money.
  paymentId        String?
  settledAt        DateTime?
  requestedById    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// One request per provider reference — the callback finds its way home by this.
  @@unique([providerRef])
  @@index([organizationId])
  @@index([studentProfileId])
  @@index([organizationId, status])
}

model FeeCreditAllocation {
  id             String   @id @default(uuid())
  organizationId String
  feeCreditId    String
  documentId     String
  amount         Decimal  @db.Decimal(20, 6)
  /// posted | reversed
  status         String   @default("posted")
  journalEntryId String?
  reversedById   String?
  createdAt      DateTime @default(now())
  createdBy      String?

  @@index([organizationId])
  @@index([feeCreditId])
  @@index([documentId])
}

/// A2 (P1-13) — the typed escape hatch. Every balance change not explained by
/// invoice / payment / waiver / credit / refund / write-off is a FeeAdjustment.
/// This is what keeps a bare amountResidual mutation from ever being the way to
/// "adjust a balance".
model FeeAdjustment {
  id               String   @id @default(uuid())
  organizationId   String
  code             String
  studentProfileId String
  documentId       String?
  /// debit (increases what the student owes) | credit (decreases it)
  direction        String
  amount           Decimal  @db.Decimal(20, 6)
  reason           String
  /// draft | pending_approval | approved | posted | rejected | reversed
  status           String   @default("pending_approval")
  journalEntryId   String?
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  reversedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([studentProfileId])
  @@index([documentId])
}

/// Phase 1.5 — a billing run as a resumable, auditable job rather than a
/// synchronous HTTP request. Each item commits atomically; the run tolerates
/// partial failure.
model BillingRun {
  id             String   @id @default(uuid())
  organizationId String
  termId         String
  classId        String?
  /// queued | running | completed | completed_with_failures | cancelled
  status         String   @default("queued")
  totalStudents  Int      @default(0)
  postedCount    Int      @default(0)
  failedCount    Int      @default(0)
  skippedCount   Int      @default(0)
  startedById    String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items BillingRunItem[]

  @@index([organizationId])
  @@index([termId])
}

model BillingRunItem {
  id                 String   @id @default(uuid())
  organizationId     String
  billingRunId       String
  studentProfileId   String
  /// pending | processing | posted | failed | skipped
  status             String   @default("pending")
  documentId         String?
  schoolFeeInvoiceId String?
  amount             Decimal? @db.Decimal(20, 6)
  error              String?
  retryCount         Int      @default(0)
  processedAt        DateTime?
  createdAt          DateTime @default(now())

  billingRun BillingRun @relation(fields: [billingRunId], references: [id], onDelete: Cascade)

  @@unique([billingRunId, studentProfileId])
  @@index([organizationId])
  @@index([billingRunId])
}

/// A4.1 — school-term financial close. A SCHOOL-domain control, deliberately
/// distinct from accounting fiscal-period close: postings remain governed by
/// the posting date's FiscalPeriod. Both must pass.
model TermFinancialClose {
  id             String   @id @default(uuid())
  organizationId String
  termId         String
  /// open | closed
  status         String   @default("open")
  closedById     String?
  closedAt       DateTime?
  reopenedById   String?
  reopenedAt     DateTime?
  reopenReason   String?
  /// Frozen totals at close (billed/collected/waived/credited/outstanding).
  snapshot       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, termId])
  @@index([organizationId])
}

/// B4 — a mobile-money / bank statement import. File-level audit trail so a
/// bursar can prove "the statement contained X and the ERP processed Y".
model PaymentImportBatch {
  id               String   @id @default(uuid())
  organizationId   String
  /// mtn_momo | airtel_money | bank
  provider         String
  originalFilename String
  fileHash         String
  statementPeriod  String?
  rowCount         Int      @default(0)
  totalAmount      Decimal  @default(0) @db.Decimal(20, 6)
  matchedCount     Int      @default(0)
  postedCount      Int      @default(0)
  rejectedCount    Int      @default(0)
  uploadedById     String?
  uploadedAt       DateTime @default(now())

  rows PaymentImportRow[]

  /// Batch locking: an identical file for the same provider+period is rejected
  /// before parsing.
  @@unique([organizationId, provider, statementPeriod, fileHash])
  @@index([organizationId])
}

model PaymentImportRow {
  id                      String   @id @default(uuid())
  organizationId          String
  batchId                 String
  externalRef             String
  payerPhone              String?
  payerName               String?
  amount                  Decimal  @db.Decimal(20, 6)
  transactionDate         DateTime?
  narration               String?
  /// imported | matched | confirmed | posted | unmatched | duplicate | rejected | failed
  matchStatus             String   @default("imported")
  /// high | medium | low | none
  matchConfidence         String   @default("none")
  matchedStudentProfileId String?
  paymentId               String?
  error                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  batch PaymentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Row-level duplicate guard: a provider transaction reference is unique.
  @@unique([organizationId, externalRef])
  @@index([organizationId])
  @@index([batchId])
  @@index([matchStatus])
}

/// B5 — versioned fee structures. FeeStructureVersion freezes a snapshot;
/// FeeItem is the priced line. Provenance and reproducibility, NOT protection
/// of the historical invoice (DocumentLine already does that).
model FeeStructureVersion {
  id             String    @id @default(uuid())
  organizationId String
  feeStructureId String
  versionNo      Int
  isImmutable    Boolean   @default(false)
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime  @default(now())

  items FeeItem[]

  @@unique([feeStructureId, versionNo])
  @@index([organizationId])
  @@index([feeStructureId])
}

model FeeItem {
  id                    String   @id @default(uuid())
  organizationId        String
  feeStructureVersionId String
  code                  String
  name                  String
  productId             String?
  amount                Decimal  @db.Decimal(20, 6)
  isOptional            Boolean  @default(false)
  /// one_time | per_term | annual
  frequency             String   @default("per_term")
  appliesTo             Json     @default("{}")
  createdAt             DateTime @default(now())

  version FeeStructureVersion @relation(fields: [feeStructureVersionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([feeStructureVersionId])
}

/// P2 — Reusable fee category master (the "Fee Categories" catalog). A
/// standalone, tenant-scoped lookup of fee types (School Fees, Registration
/// Fees, Transport, Swimming, …) that FeeStructures reference by `code`. This
/// is the primitive the legacy fork was missing: a category was only ever an
/// ad-hoc string inside a structure's `components` JSON, so it could not be
/// reused or governed. `type` mirrors the competitor's Mandatory/Optional flag;
/// `paymentOrder` drives display/processing sequence.
model FeeCategory {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  /// 'mandatory' | 'optional'
  type           String   @default("mandatory")
  description    String?
  /// Display/processing order (Payment Order in the competitor UI).
  paymentOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  studentOptionalFees StudentOptionalFee[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// P3 — per-student opt-in to an OPTIONAL fee category for one term.
///
/// A *mandatory* category bills every student inside the fee structure's scope
/// automatically. An *optional* one (Swimming, Transport, Boarding extras, …)
/// must never be force-billed: it only reaches a student's invoice when a row
/// exists here. `amount` overrides the structure component's price when set,
/// which is how one structure can charge two students different swimming fees
/// without cloning the structure.
model StudentOptionalFee {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  termId           String
  feeCategoryId    String
  /// Per-student amount. Null = fall back to the structure component amount.
  amount           Decimal? @db.Decimal(20, 6)
  isActive         Boolean  @default(true)
  notes            String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  term           Term           @relation(fields: [termId], references: [id])
  feeCategory    FeeCategory    @relation(fields: [feeCategoryId], references: [id])

  @@unique([organizationId, studentProfileId, termId, feeCategoryId])
  @@index([organizationId])
  @@index([termId, feeCategoryId])
  @@index([studentProfileId])
}

/// Phase 0.9 — historical remediation. Corrections to data corrupted by the P0
/// defects are grouped into approved batches and executed as reversal /
/// compensating entries, never by editing history. Answers "why did this
/// student balance change after go-live?".
model FinancialRemediationBatch {
  id               String   @id @default(uuid())
  organizationId   String
  code             String
  reason           String
  sourceReportHash String?
  /// draft | approved | applied | rejected
  status           String   @default("draft")
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  appliedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items FinancialRemediationItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model FinancialRemediationItem {
  id              String   @id @default(uuid())
  organizationId  String
  batchId         String
  sourceType      String
  sourceId        String
  discrepancyType String
  originalAmount  Decimal  @db.Decimal(20, 6)
  correctedAmount Decimal  @db.Decimal(20, 6)
  journalEntryId  String?
  explanation     String?
  createdAt       DateTime @default(now())

  batch FinancialRemediationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([batchId])
}

model BookMetadata {
  id             String  @id @default(uuid())
  organizationId String
  /// FK to Product (stockable, trackInventory=true). One row per ISBN.
  productId      String  @unique
  author         String?
  isbn           String?
  publisher      String?
  edition        String?
  /// 'reference' | 'textbook' | 'novel' | 'journal' | 'magazine'.
  category       String  @default("textbook")
  shelfLocation  String?
  /// Total copies owned across the library.
  totalCopies    Int     @default(1)
  customFields   Json    @default("{}")

  copies     BookCopy[]
  borrowings Borrowing[]

  @@index([organizationId])
  @@index([isbn])
}

model BookCopy {
  id             String   @id @default(uuid())
  organizationId String
  bookMetadataId String
  copyNumber     String
  /// 'available' | 'borrowed' | 'lost' | 'damaged' | 'reserved'.
  status         String   @default("available")
  condition      String   @default("good")
  acquiredAt     DateTime @default(now())
  customFields   Json     @default("{}")

  book       BookMetadata @relation(fields: [bookMetadataId], references: [id], onDelete: Cascade)
  borrowings Borrowing[]

  @@unique([organizationId, bookMetadataId, copyNumber])
  @@index([organizationId])
  @@index([status])
}

model Borrowing {
  id               String    @id @default(uuid())
  organizationId   String
  bookMetadataId   String
  bookCopyId       String
  studentProfileId String?
  staffProfileId   String?
  borrowedAt       DateTime  @default(now())
  dueAt            DateTime
  returnedAt       DateTime?
  /// 'borrowed' | 'returned' | 'overdue' | 'lost'.
  status           String    @default("borrowed")
  fineAmount       Decimal   @default(0) @db.Decimal(18, 6)
  fineInvoiceId    String? // FK to Document if a fine was issued
  notes            String?

  book     BookMetadata @relation(fields: [bookMetadataId], references: [id])
  bookCopy BookCopy     @relation(fields: [bookCopyId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([status])
  @@index([dueAt])
}

/// Transport fleet vehicle. Evolved in place from the naive v1: real status
/// enum, ownership, odometer, capacity split (seated vs operational vs
/// wheelchair), and compliance documents. `driverPartnerId` is deprecated —
/// real crew lives on `TransportCrewMember`; the migration backfills it.
model Vehicle {
  id                 String              @id @default(uuid())
  organizationId     String
  code               String
  plateNumber        String
  fleetNumber        String?
  /// 'bus' | 'van' | 'car' | 'shuttle'.
  type               String              @default("bus")
  make               String?
  model              String?
  year               Int?
  fuelType           String?
  odometerKm         Decimal             @default(0) @db.Decimal(20, 6)
  seatedCapacity     Int                 @default(14)
  wheelchairCapacity Int                 @default(0)
  /// The capacity checks actually use (legal/policy beats physical).
  operationalCapacity Int                @default(14)
  ownership          TransportOwnership   @default(owned)
  providerId         String?
  status             TransportVehicleStatus @default(available)
  campusId           String?
  /// Deprecated — real driver is a TransportCrewMember. Kept for backfilled data.
  driverPartnerId    String?
  customFields       Json                @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  routeAssignments         RouteAssignment[]
  documents               TransportVehicleDocument[]
  inspections             TransportVehicleInspection[]
  trips                   TransportTrip[]
  devices                 TransportDevice[]
  locationEvents          TransportLocationEvent[]
  geofenceEvents          TransportGeofenceEvent[]
  trackingAlerts          TransportTrackingAlert[]
  schedules               TransportSchedule[]     @relation("schedVehicle")
  incidents               TransportIncident[]      @relation("vehicleIncidents")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([plateNumber])
  @@index([campusId])
  @@index([status])
}

/// A planned transport service. Evolved in place: real status enum, direction,
/// service type, campus/year scoping, and an immutable route-version history.
/// `monthlyFee`/`feeProductId` are kept but demoted — T4 pricing lives on
/// `TransportFeePlan`; these are the flat-rate fallback.
model Route {
  id               String              @id @default(uuid())
  organizationId   String
  name             String
  code             String?
  description      String?
  campusId         String?
  academicYearId   String?
  direction        TransportDirection  @default(inbound)
  /// 'morning' | 'afternoon' | 'activity' | 'special' | 'field_trip'.
  serviceType      String              @default("morning")
  status           TransportRouteStatus @default(draft)
  currentVersionId String?
  estimatedDurationMin Int?
  distanceKm       Decimal?            @db.Decimal(20, 6)
  monthlyFee       Decimal             @default(0) @db.Decimal(20, 6)
  /// FK to Product (service) used when invoicing the transport fee fallback.
  feeProductId     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  assignments      StudentTransportAssignment[]
  routeAssignments RouteAssignment[]
  versions         TransportRouteVersion[]
  schedules        TransportSchedule[]   @relation("routeSchedules")
  trips            TransportTrip[]       @relation("routeTrips")
  requests         TransportRequest[]    @relation("routeRequests")
  feeRates         TransportFeePlanRate[] @relation("routeFeeRates")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
  @@index([status])
}

/// Standalone physical location. Restructured in T1: the v1 `Stop` was owned by
/// the route (routeId + order + times on the stop itself). Now a Stop is a
/// shared place (a physical point can serve multiple routes) and ordering/timing
/// live on `TransportRouteStop` (route-version scoped).
model Stop {
  id             String              @id @default(uuid())
  organizationId String
  code           String
  name           String
  zoneId         String?
  campusId       String?
  address        String?
  landmark       String?
  latitude       Decimal?            @db.Decimal(9, 6)
  longitude      Decimal?            @db.Decimal(9, 6)
  pickupAllowed  Boolean             @default(true)
  dropoffAllowed Boolean             @default(true)
  geofenceRadiusM Int                @default(100)
  safetyNotes    String?
  status         TransportStopStatus @default(active)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  assignments        StudentTransportAssignment[]
  routeStops         TransportRouteStop[]
  tripStops          TransportTripStop[]
  boardingEvents     TransportBoardingEvent[]
  geofences          TransportGeofence[]
  authorizedPersons  TransportAuthorizedPerson[]
  zone               TransportZone?         @relation(fields: [zoneId], references: [id])
  pickupAssignments  StudentTransportAssignment[] @relation("pickupStop")
  dropoffAssignments StudentTransportAssignment[] @relation("dropoffStop")
  requests           TransportRequest[]           @relation("stopRequests")
  feeRates          TransportFeePlanRate[]      @relation("stopFeeRates")
  tripPickups       TransportTripPassenger[]   @relation("tripPassengerPickup")
  tripDropoffs      TransportTripPassenger[]   @relation("tripPassengerDropoff")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([zoneId])
  @@index([campusId])
  @@index([status])
}

/// Retired in T1. Its (route, vehicle, dayOfWeek) rows are backfilled into
/// `TransportSchedule` and the table is dropped.
model RouteAssignment {
  id             String  @id @default(uuid())
  organizationId String
  routeId        String
  vehicleId      String
  dayOfWeek      Int
  pickupTime     String? // 'HH:mm'
  dropoffTime    String? // 'HH:mm'
  isActive       Boolean @default(true)

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([organizationId, routeId, vehicleId, dayOfWeek])
  @@index([organizationId])
}

/// Student ⇄ Route contractual assignment. Evolved in place: real status enum,
/// termId FK, separate inbound/outbound stops, service mode, assignment type,
/// days-of-week, and a partial-unique invariant (one active per
/// student+term+serviceMode). The v1 `stopId` is backfilled into `pickupStopId`
/// and kept as a deprecated alias.
model StudentTransportAssignment {
  id                String                   @id @default(uuid())
  organizationId    String
  studentProfileId  String
  routeId           String
  /// Deprecated alias; backfilled from v1 `stopId`. Use pickupStopId/dropoffStopId.
  stopId            String
  pickupStopId      String?
  dropoffStopId     String?
  campusId          String?
  academicYearId    String?
  termId            String?
  startDate         DateTime
  endDate           DateTime?
  serviceMode       TransportServiceMode     @default(both)
  assignmentType    TransportAssignmentType @default(permanent)
  daysOfWeek        Int[]                    @default([1, 2, 3, 4, 5])
  monthlyFee        Decimal                  @default(0) @db.Decimal(20, 6)
  status            TransportAssignmentStatus @default(pending)
  reason            String?
  requestId         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  student       StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  route         Route                     @relation(fields: [routeId], references: [id])
  stop          Stop                      @relation(fields: [stopId], references: [id])
  pickupStop    Stop?                     @relation("pickupStop", fields: [pickupStopId], references: [id])
  dropoffStop   Stop?                     @relation("dropoffStop", fields: [dropoffStopId], references: [id])
  tripPassengers TransportTripPassenger[]
  boardingEvents  TransportBoardingEvent[]

  requests TransportRequest[] @relation("assignmentRequests")
  charges TransportCharge[]   @relation("assignmentCharges")

  @@unique([organizationId, studentProfileId, termId, serviceMode], map: "StudentTransportAssignment_active_unique")
  @@index([organizationId])
  @@index([studentProfileId])
  @@index([routeId])
  @@index([status])
}

