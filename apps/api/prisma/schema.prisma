  gradedById       String?
  gradedAt         DateTime?
  feedback         String?
  status           String    @default("assigned") // 'assigned' | 'submitted' | 'late' | 'graded'
  /// Phase 1 bridge: one submission → one StudentAssessment (the gradebook row).
  studentAssessmentId String?

  assignment     HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id])

  @@unique([assignmentId, studentProfileId])
  @@index([organizationId])
  @@index([studentProfileId])
  @@index([studentAssessmentId])
}

model LearningResource {
  id             String    @id @default(uuid())
  organizationId String
  classId        String?
  subjectId      String?
  title          String
  /// 'note' | 'video' | 'link' | 'file' | 'slide'.
