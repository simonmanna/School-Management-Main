// ═══════════════════════════════════════════════════════════════════════════
// School Transport Management System (STMS) — models
// ═══════════════════════════════════════════════════════════════════════════

/// Per (org, optional campus) transport configuration.
model TransportSettings {
  id                String   @id @default(uuid())
  organizationId    String
  campusId          String?
  operatingDays     Int[]    @default([1, 2, 3, 4, 5])
  pickupGraceMin    Int      @default(5)
  dropoffGraceMin   Int      @default(5)
  lateThresholdMin  Int      @default(10)
  maxRouteDurationMin Int?
  boardingMethodsEnabled Json @default("[\"manual\",\"qr\",\"rfid\",\"barcode\",\"mobile\"]")
  deviationThresholdM Int    @default(150)
  speedThresholdKph  Int     @default(80)
  geofenceDefaultRadiusM Int @default(100)
  notifyAbsenceCancelsPickup Boolean @default(false)
  billingSuspensionEnabled Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?

  @@unique([organizationId, campusId])
  @@index([organizationId])
}

/// Named service area — drives pricing, planning and reporting.
model TransportZone {
  id           String   @id @default(uuid())
  organizationId String
  code         String
  name         String
  campusId     String?
  boundary     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  stops       Stop[]
  feeRates    TransportFeePlanRate[]
  geofences   TransportGeofence[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([campusId])
}

/// Immutable route history. Trips reference the version, never the route directly.
model TransportRouteVersion {
  id             String              @id @default(uuid())
  organizationId String
  routeId        String
  versionNo      Int
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  status         TransportRouteStatus @default(active)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  route      Route               @relation(fields: [routeId], references: [id])
  routeStops TransportRouteStop[]
  schedules  TransportSchedule[]
  trips      TransportTrip[]

  @@unique([routeId, versionNo])
  @@index([organizationId])
  @@index([routeId])
}

/// Ordered stop on a route *version* (timing + capacity live here, not on Stop).
model TransportRouteStop {
  id                 String   @id @default(uuid())
  organizationId     String
  routeVersionId     String
  stopId             String
  sequence           Int
  plannedArrival     String?  // 'HH:mm'
  plannedDeparture   String?  // 'HH:mm'
  pickupAllowed      Boolean  @default(true)
  dropoffAllowed     Boolean  @default(true)
  studentCapacity    Int?
  distanceFromPrevKm Decimal? @db.Decimal(20, 6)
  feeOverride        Decimal? @db.Decimal(20, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  routeVersion TransportRouteVersion @relation(fields: [routeVersionId], references: [id], onDelete: Cascade)
  stop         Stop                   @relation(fields: [stopId], references: [id])

  @@unique([routeVersionId, sequence])
  @@index([organizationId])
  @@index([routeVersionId])
  @@index([stopId])
}

/// Driver / attendant / supervisor / coordinator — one model, many roles.
model TransportCrewMember {
  id             String            @id @default(uuid())
  organizationId String
  /// Link to the staff profile (for drivers needing a real login).
  staffProfileId String?
  /// Link to a Partner (person) when not a staff member.
  partnerId      String?
  role           TransportCrewRole @default(driver)
  name           String
  phone          String?
  licenseNumber  String?
  licenseClass   String?
  licenseExpiry  DateTime?
  emergencyContact Json?
  status         TransportCrewStatus @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  documents    TransportCrewDocument[]
  driverTrips  TransportTrip[]        @relation("tripDriver")
  attendantTrips TransportTrip[]      @relation("tripAttendant")
  inspections TransportVehicleInspection[]
  incidents    TransportIncident[]
  scheduledDrivers  TransportSchedule[] @relation("schedDriverBack")
  scheduledAttendants TransportSchedule[] @relation("schedAttendantBack")

  @@index([organizationId])
  @@index([staffProfileId])
  @@index([partnerId])
  @@index([status])
}

model TransportCrewDocument {
  id            String   @id @default(uuid())
  organizationId String
  crewMemberId  String
  /// 'license' | 'training' | 'first_aid' | 'background_check' | 'medical'.
  documentType  String
  documentNumber String
  issueDate     DateTime?
  expiryDate    DateTime?
  fileId        String?
  verified      Boolean  @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  crewMember TransportCrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([crewMemberId])
  @@index([expiryDate])
}

model TransportVehicleDocument {
  id            String   @id @default(uuid())
  organizationId String
  vehicleId     String
  /// 'registration' | 'insurance' | 'inspection_certificate' | 'roadworthiness' | 'operating_licence' | 'permit'.
  documentType  String
  documentNumber String
  issueDate     DateTime?
  expiryDate    DateTime?
  fileId        String?
  verified      Boolean  @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@index([expiryDate])
}

// ── T2 Student Transport ──

/// Parent-initiated request. Approval mints or amends a StudentTransportAssignment.
model TransportRequest {
  id                 String              @id @default(uuid())
  organizationId     String
  studentProfileId   String
  type               TransportRequestType @default(new)
  requestedRouteId   String?
  requestedStopId    String?
  requestedStartDate DateTime?
  requestedEndDate   DateTime?
  notes              String?
  status             TransportRequestStatus @default(submitted)
  reviewedById       String?
  decisionNotes      String?
  assignmentId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String?
  updatedBy          String?

  student   StudentProfile @relation(fields: [studentProfileId], references: [id])
  route     Route?         @relation("routeRequests", fields: [requestedRouteId], references: [id])
  stop      Stop?          @relation("stopRequests", fields: [requestedStopId], references: [id])
  assignment StudentTransportAssignment? @relation("assignmentRequests", fields: [assignmentId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([status])
}

/// Per-student authorized pick-up person.
model TransportAuthorizedPerson {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  stopId           String?
  name             String
  relationship     String
  phone            String?
  photoFileId      String?
  idType           String?
  idNumber         String?
  validFrom        DateTime?
  validTo          DateTime?
  isActive         Boolean  @default(true)
  verificationMethod String @default("visual") // 'visual' | 'qr' | 'otp' | 'staff_approval'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  stop    Stop?          @relation(fields: [stopId], references: [id])
  releasedBy TransportBoardingEvent[] @relation("boardingReleases")

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([stopId])
}

/// Per-student eligibility flags that feed vehicle/route checks.
model TransportSpecialRequirement {
  id           String   @id @default(uuid())
  organizationId String
  studentProfileId String
  /// 'wheelchair' | 'mobility' | 'visual' | 'hearing' | 'behavioral' | 'escort_required' | 'front_seat' | 'medication'.
  kind         String
  notes        String?
  validFrom    DateTime?
  validTo      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentProfileId])
}

// ── T3 Scheduling + Operations ──

/// The *plan*: route version × direction × days × vehicle × crew.
model TransportSchedule {
  id                   String              @id @default(uuid())
  organizationId       String
  routeVersionId       String
  routeId              String?
  direction            TransportDirection
  daysOfWeek           Int[]               @default([1, 2, 3, 4, 5])
  departureTime        String // 'HH:mm'
  defaultVehicleId     String?
  defaultCrewDriverId  String?
  defaultCrewAttendantId String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  status               TransportRouteStatus @default(active)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?

  routeVersion TransportRouteVersion @relation(fields: [routeVersionId], references: [id])
  route       Route?        @relation("routeSchedules", fields: [routeId], references: [id])
  vehicle     Vehicle?               @relation("schedVehicle", fields: [defaultVehicleId], references: [id])
  driver       TransportCrewMember? @relation("schedDriverBack", fields: [defaultCrewDriverId], references: [id])
  attendant    TransportCrewMember? @relation("schedAttendantBack", fields: [defaultCrewAttendantId], references: [id])
  exceptions   TransportScheduleException[]
  trips        TransportTrip[]

  @@index([organizationId])
  @@index([routeVersionId])
}

/// Date-scoped override of a schedule.
model TransportScheduleException {
  id                 String                        @id @default(uuid())
  organizationId     String
  scheduleId         String
  date               DateTime
  kind               TransportScheduleExceptionKind
  newDepartureTime   String?
  newRouteVersionId  String?
  reason             String?
  calendarEventId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  schedule      TransportSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  calendarEvent SchoolCalendarEvent?  @relation(fields: [calendarEventId], references: [id])

  @@index([organizationId])
  @@index([scheduleId])
  @@index([date])
}

/// The *execution* of a schedule on a date.
model TransportTrip {
  id                    String            @id @default(uuid())
  organizationId        String
  scheduleId            String?
  routeVersionId        String
  routeId               String?
  direction             TransportDirection
  vehicleId             String?
  driverCrewId          String?
  attendantCrewId       String?
  date                  DateTime
  status                TransportTripStatus @default(scheduled)
  plannedDeparture      DateTime?
  plannedArrival        DateTime?
  actualDeparture       DateTime?
  actualArrival         DateTime?
  odometerStart         Decimal?          @db.Decimal(20, 6)
  odometerEnd           Decimal?          @db.Decimal(20, 6)
  delayMinutes          Int               @default(0)
  inspectionId          String?
  endOfTripCheckedAt    DateTime?
  endOfTripCheckedById  String?
  unaccountedCount      Int               @default(0)
  version               Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  createdBy             String?
  updatedBy             String?

  schedule      TransportSchedule?        @relation(fields: [scheduleId], references: [id])
  routeVersion  TransportRouteVersion    @relation(fields: [routeVersionId], references: [id])
  route         Route?          @relation("routeTrips", fields: [routeId], references: [id])
  vehicle       Vehicle?                  @relation(fields: [vehicleId], references: [id])
  driver        TransportCrewMember?      @relation("tripDriver", fields: [driverCrewId], references: [id])
  attendant     TransportCrewMember?      @relation("tripAttendant", fields: [attendantCrewId], references: [id])
  inspection    TransportVehicleInspection? @relation("inspectionTrip", fields: [inspectionId], references: [id])
  stops         TransportTripStop[]
  passengers    TransportTripPassenger[]
  tripEvents    TransportTripEvent[]
  boardingEvents TransportBoardingEvent[]
  geofenceEvents TransportGeofenceEvent[]
  locationEvents TransportLocationEvent[]
  trackingAlerts TransportTrackingAlert[]
  incidents     TransportIncident[]
  track         TransportTripTrack?
  endOfTripCheck TransportEndOfTripCheck[] @relation("endOfTripCheck")

  @@unique([organizationId, scheduleId, date, direction])
  @@index([organizationId])
  @@index([routeVersionId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
}

/// Materialized per-trip stop.
model TransportTripStop {
  id               String   @id @default(uuid())
  organizationId   String
  tripId           String
  stopId           String
  sequence         Int
  plannedArrival   DateTime?
  plannedDeparture DateTime?
  actualArrival    DateTime?
  actualDeparture  DateTime?
  expectedCount    Int      @default(0)
  boardedCount     Int      @default(0)
  skipped          Boolean  @default(false)
  skipReason       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop Stop         @relation(fields: [stopId], references: [id])

  @@index([organizationId])
  @@index([tripId])
  @@index([stopId])
}

/// The manifest: one row per (trip, student).
model TransportTripPassenger {
  id                  String                @id @default(uuid())
  organizationId      String
  tripId              String
  studentProfileId    String
  pickupStopId        String?
  dropoffStopId       String?
  assignmentId        String?
  status              TransportPassengerStatus @default(expected)
  specialRequirementsSnapshot Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  trip        TransportTrip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student     StudentProfile       @relation("tripPassengers", fields: [studentProfileId], references: [id])
  pickupStop  Stop?                @relation("tripPassengerPickup", fields: [pickupStopId], references: [id])
  dropoffStop Stop?                @relation("tripPassengerDropoff", fields: [dropoffStopId], references: [id])
  assignment  StudentTransportAssignment? @relation(fields: [assignmentId], references: [id])
  boardingEvents TransportBoardingEvent[] @relation("passengerBoarding")

  @@unique([tripId, studentProfileId])
  @@index([organizationId])
  @@index([tripId])
  @@index([studentProfileId])
}

/// Immutable, append-only boarding fact.
model TransportBoardingEvent {
  id               String                  @id @default(uuid())
  organizationId   String
  tripId           String
  studentProfileId String
  stopId           String?
  assignmentId     String?
  eventType        TransportBoardingEventType
  occurredAt       DateTime                @default(now())
  source           TransportBoardingSource @default(manual)
  deviceId         String?
  recordedById     String?
  latitude         Decimal?                @db.Decimal(9, 6)
  longitude        Decimal?                @db.Decimal(9, 6)
  reason           String?
  releasedToPersonId String?
  /// Offline idempotency key (one event per clientEventId).
  clientEventId    String?
  clientRecordedAt DateTime?
  sequence         Int?
  createdAt        DateTime                @default(now())

  trip        TransportTrip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student     StudentProfile             @relation("studentBoarding", fields: [studentProfileId], references: [id])
  stop        Stop?                      @relation(fields: [stopId], references: [id])
  assignment  StudentTransportAssignment? @relation(fields: [assignmentId], references: [id])
  passenger   TransportTripPassenger[]   @relation("passengerBoarding")
  releasedTo  TransportAuthorizedPerson? @relation("boardingReleases", fields: [releasedToPersonId], references: [id])

  @@unique([organizationId, clientEventId], map: "TransportBoardingEvent_client_unique")
  @@index([organizationId])
  @@index([tripId])
  @@index([studentProfileId])
}

/// Pre-trip vehicle inspection.
model TransportVehicleInspection {
  id              String                @id @default(uuid())
  organizationId  String
  vehicleId       String
  tripId          String?
  date            DateTime
  inspectedByCrewId String
  result          TransportInspectionResult @default(pass)
  odometerKm      Decimal               @default(0) @db.Decimal(20, 6)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  vehicle   Vehicle             @relation(fields: [vehicleId], references: [id])
  crewMember TransportCrewMember @relation(fields: [inspectedByCrewId], references: [id])
  trip      TransportTrip[]      @relation("inspectionTrip")
  items     TransportInspectionItem[]

  @@index([organizationId])
  @@index([vehicleId])
  @@index([date])
}

model TransportInspectionItem {
  id               String                    @id @default(uuid())
  organizationId   String
  inspectionId     String
  label            String
  isCritical       Boolean                  @default(false)
  result           TransportInspectionItemResult @default(pass)
  notes            String?
  createdAt        DateTime                 @default(now())

  inspection TransportVehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inspectionId])
}

/// Operational timeline (complements, does not replace, AuditLog).
model TransportTripEvent {
  id          String   @id @default(uuid())
  organizationId String
  tripId      String
  eventType   String
  fromStatus  String?
  toStatus    String?
  actorId     String?
  reason      String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  trip TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tripId])
}

// ── T4 Finance ──

model TransportFeePlan {
  id              String            @id @default(uuid())
  organizationId  String
  name            String
  campusId        String?
  academicYearId  String?
  basis           TransportFeeBasis @default(flat)
  period          TransportFeePeriod @default(monthly)
  baseAmount      Decimal           @default(0) @db.Decimal(20, 6)
  oneWayFactor    Decimal           @default(0.6) @db.Decimal(9, 4)
  ratePerKm       Decimal?          @db.Decimal(20, 6)
  feeProductId    String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  rates    TransportFeePlanRate[]

  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
}

model TransportFeePlanRate {
  id          String   @id @default(uuid())
  organizationId String
  feePlanId   String
  zoneId      String?
  routeId     String?
  stopId      String?
  amount      Decimal  @default(0) @db.Decimal(20, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan TransportFeePlan @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  zone TransportZone?   @relation(fields: [zoneId], references: [id])
  route Route?          @relation("routeFeeRates", fields: [routeId], references: [id])
  stop  Stop?           @relation("stopFeeRates", fields: [stopId], references: [id])

  @@index([organizationId])
  @@index([feePlanId])
}

model TransportDiscountRule {
  id         String   @id @default(uuid())
  organizationId String
  name       String
  /// 'sibling' | 'staff' | 'scholarship' | 'hardship'.
  kind       String
  /// 'percent' | 'fixed'.
  type       String
  value      Decimal  @default(0) @db.Decimal(20, 6)
  criteria   Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([organizationId])
  @@index([isActive])
}

/// Normalized charge row; maps to an invoiced Document.
model TransportCharge {
  id            String              @id @default(uuid())
  organizationId String
  assignmentId  String
  periodStart   DateTime
  periodEnd     DateTime
  grossAmount   Decimal             @default(0) @db.Decimal(20, 6)
  discountAmount Decimal            @default(0) @db.Decimal(20, 6)
  netAmount     Decimal             @default(0) @db.Decimal(20, 6)
  documentId    String?
  status        TransportChargeStatus @default(pending)
  prorated      Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  assignment StudentTransportAssignment @relation("assignmentCharges", fields: [assignmentId], references: [id])

  @@unique([organizationId, assignmentId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([assignmentId])
  @@index([status])
}

// ── T5 Safety + Communication ──

model TransportIncident {
  id              String                  @id @default(uuid())
  organizationId  String
  type            TransportIncidentType   @default(other)
  severity        TransportIncidentSeverity @default(medium)
  tripId          String?
  vehicleId       String?
  crewMemberId    String?
  latitude        Decimal?                @db.Decimal(9, 6)
  longitude       Decimal?                @db.Decimal(9, 6)
  occurredAt      DateTime                @default(now())
  description     String?
  status          TransportIncidentStatus @default(open)
  reportedById    String?
  resolutionNotes String?
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  trip       TransportTrip?        @relation(fields: [tripId], references: [id])
  vehicle    Vehicle?              @relation("vehicleIncidents", fields: [vehicleId], references: [id])
  crewMember TransportCrewMember? @relation(fields: [crewMemberId], references: [id])
  students   TransportIncidentStudent[]
  actions    TransportIncidentAction[]

  @@index([organizationId])
  @@index([tripId])
  @@index([status])
  @@index([severity])
}

model TransportIncidentStudent {
  id           String   @id @default(uuid())
  organizationId String
  incidentId   String
  studentProfileId String
  createdAt    DateTime @default(now())

  incident TransportIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  student  StudentProfile   @relation("incidentStudents", fields: [studentProfileId], references: [id])

  @@index([organizationId])
  @@index([incidentId])
  @@index([studentProfileId])
}

model TransportIncidentAction {
  id           String   @id @default(uuid())
  organizationId String
  incidentId   String
  action       String
  actorId      String?
  notes        String?
  fileId       String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  incident TransportIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([incidentId])
}

/// End-of-trip safety checklist; a trip cannot close without it.
model TransportEndOfTripCheck {
  id           String   @id @default(uuid())
  organizationId String
  tripId       String
  checklist    Json
  confirmedByCrewId String
  confirmedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  trip TransportTrip @relation("endOfTripCheck", fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId])
  @@index([organizationId])
}

// ── T6 GPS + Tracking ──

/// GPS unit or registered driver phone.
model TransportDevice {
  id           String            @id @default(uuid())
  organizationId String
  vehicleId    String?
  kind         TransportDeviceKind @default(hardware)
  identifier   String
  secretHash   String?
  lastSeenAt   DateTime?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@unique([organizationId, identifier])
  @@index([organizationId])
  @@index([vehicleId])
}

/// Partitioned by month (T6 maintenance cron). Written by the queue processor.
model TransportLocationEvent {
  id           String   @id @default(uuid())
  organizationId String
  vehicleId    String
  tripId       String?
  recordedAt   DateTime @default(now())
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  speedKph     Decimal? @db.Decimal(9, 2)
  headingDeg   Int?
  accuracyM    Int?
  source       String   @default("gps")
  deviceId     String?
  createdAt    DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  trip    TransportTrip? @relation(fields: [tripId], references: [id])

  @@index([organizationId])
  @@index([vehicleId])
  @@index([tripId])
  @@index([recordedAt])
}

model TransportGeofence {
  id           String              @id @default(uuid())
  organizationId String
  kind         TransportGeofenceKind @default(stop)
  stopId       String?
  campusId     String?
  zoneId       String?
  centerLat    Decimal?            @db.Decimal(9, 6)
  centerLng    Decimal?            @db.Decimal(9, 6)
  radiusM      Int?
  polygon      Json?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  stop  Stop?        @relation(fields: [stopId], references: [id])
  campus Campus?     @relation("campusGeofences", fields: [campusId], references: [id])
  zone  TransportZone? @relation(fields: [zoneId], references: [id])
  events TransportGeofenceEvent[]

  @@index([organizationId])
  @@index([stopId])
  @@index([campusId])
  @@index([zoneId])
}

model TransportGeofenceEvent {
  id           String                    @id @default(uuid())
  organizationId String
  vehicleId    String
  tripId       String?
  geofenceId   String
  eventType    TransportGeofenceEventType
  occurredAt   DateTime                  @default(now())
  createdAt    DateTime                  @default(now())

  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  trip      TransportTrip?   @relation(fields: [tripId], references: [id])
  geofence  TransportGeofence @relation(fields: [geofenceId], references: [id])

  @@index([organizationId])
  @@index([vehicleId])
  @@index([tripId])
  @@index([geofenceId])
}

model TransportTrackingAlert {
  id           String                      @id @default(uuid())
  organizationId String
  tripId       String?
  vehicleId    String
  kind         TransportTrackingAlertKind
  severity     TransportTrackingAlertSeverity @default(medium)
  detail       Json?
  raisedAt     DateTime                    @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  createdAt    DateTime                    @default(now())

  trip    TransportTrip? @relation(fields: [tripId], references: [id])
  vehicle Vehicle?       @relation(fields: [vehicleId], references: [id])

  @@index([organizationId])
  @@index([tripId])
  @@index([vehicleId])
  @@index([raisedAt])
}

/// Post-completion rollup so raw location rows can age out.
model TransportTripTrack {
  id           String   @id @default(uuid())
  organizationId String
  tripId       String
  polyline     Json?
  distanceKm   Decimal? @db.Decimal(20, 6)
  maxSpeedKph  Decimal? @db.Decimal(9, 2)
  avgSpeedKph  Decimal? @db.Decimal(9, 2)
  pointCount   Int      @default(0)
  createdAt    DateTime @default(now())

  trip TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId])
  @@index([organizationId])
}

model Dormitory {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  /// 'boys' | 'girls' | 'mixed'.
  gender          String    @default("mixed")
  capacity        Int       @default(40)
  wardenPartnerId String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  rooms Room[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Room {
  id             String    @id @default(uuid())
  organizationId String
  dormitoryId    String
  number         String
  /// 'single' | 'double' | 'triple' | 'quad'.
  type           String    @default("double")
  capacity       Int       @default(2)
  monthlyFee     Decimal   @default(0) @db.Decimal(18, 6)
  /// FK to Product (service) for invoicing.
  feeProductId   String?
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  beds      Bed[]

  @@unique([organizationId, dormitoryId, number])
  @@index([organizationId])
}

model Bed {
  id             String   @id @default(uuid())
  organizationId String
  roomId         String
  number         String
  /// 'available' | 'occupied' | 'reserved' | 'maintenance'.
  status         String   @default("available")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocation HostelAllocation?

  @@unique([organizationId, roomId, number])
  @@index([organizationId])
  @@index([status])
}

model HostelAllocation {
  id               String    @id @default(uuid())
  organizationId   String
  bedId            String    @unique
  studentProfileId String
  termId           String?
  startDate        DateTime
  endDate          DateTime?
  checkOutDate     DateTime?
  /// 'active' | 'ended' | 'cancelled'.
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bed     Bed            @relation(fields: [bedId], references: [id])
  student StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
}

model MealPlan {
  id             String    @id @default(uuid())
  organizationId String
  /// Meals V1: optional parent program (Day / Day+Boarding / Custom). Nullable so
  /// pre-existing wallet-only plans keep working.
  mealProgramId  String?
  name           String
  /// 'full' | 'half' | 'lunch_only' | 'breakfast_only'.
  type           String    @default("full")
  /// FK to Product (service) for invoicing.
  feeProductId   String?
  pricePerTerm   Decimal   @db.Decimal(18, 6)
  /// Meals V1: how this plan is charged. 'term_plan' = billed as a term fee via
  /// Document/AR/GL; 'wallet' = prepaid cafeteria wallet; 'included' = bundled in
  /// boarding/tuition (no separate charge). MealPlan holds charge CONFIGURATION
  /// only — posting stays in the services / Document engine.
  billingModel   String    @default("term_plan")
  /// 'school_funded' | 'parent_funded' | 'parent_contribution' | 'mixed'.
  fundingModel   String    @default("parent_funded")
  /// When true, serving a student on this plan (via attendance) decrements the
  /// inventory products behind each menu dish (via MealRecipeIngredient) and
  /// writes a per-student MealConsumption row. Off by default — opt-in so plans
  /// that are billing-only or inventory-free don't move stock.
  trackInventory Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  mealProgram  MealProgram?          @relation(fields: [mealProgramId], references: [id])
  accounts     MealAccount[]
  entitlements MealPlanEntitlement[]
  assignments  MealPlanAssignment[]
  menus        MealMenu[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([mealProgramId])
}

model MealAccount {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String   @unique
  mealPlanId       String
  balance          Decimal  @default(0) @db.Decimal(20, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student      StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  mealPlan     MealPlan                @relation(fields: [mealPlanId], references: [id])
  purchases    MealPurchase[]
  transactions MealAccountTransaction[]

  @@index([organizationId])
}

model MealPurchase {
  id             String   @id @default(uuid())
  organizationId String
  mealAccountId  String
  amount         Decimal  @db.Decimal(18, 6)
  description    String?
  paymentId      String?
  purchasedAt    DateTime @default(now())

  mealAccount MealAccount @relation(fields: [mealAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mealAccountId])
}

// ═══════════════════════════════════════════════════════════════════════════
// School Meals module (Meals V1–V3) — programs, entitlements, sessions,
// attendance, menus, wallet ledger, kitchen production. Reuses Document/Payment/
// Posting for money and Inventory for stock; adds no new accounting primitives.
// ═══════════════════════════════════════════════════════════════════════════

enum MealAssignmentStatus {
  active
  suspended
  ended
  cancelled
}

enum MealAttendanceStatus {
  served
  absent
  excused
  not_eligible
}

enum MealAccountTxnType {
  top_up
  purchase
  refund
  adjustment
  reversal
}

enum MealProductionStatus {
  preparing
  ready
  served
  cancelled
}

enum MealWasteReason {
  overproduction
  spoilage
  burnt
  damaged
  returned
  other
}

/// Top-level meal program grouping plans (Day School / Day+Boarding / Custom).
model MealProgram {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// 'day' | 'day_boarding' | 'custom'.
  kind           String    @default("custom")
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  plans MealPlan[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// A configurable meal (Breakfast / Lunch / Dinner / Snack). Org-level catalog.
model MealType {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  order          Int       @default(0)
  /// 'HH:mm' serving window (optional, display only).
  startTime      String?
  endTime        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  entitlements    MealPlanEntitlement[]
  sessions        MealSession[]
  menus           MealMenu[]
  productionPlans MealProductionPlan[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Which meal types a plan includes (MealPlan × MealType).
model MealPlanEntitlement {
  id             String   @id @default(uuid())
  organizationId String
  mealPlanId     String
  mealTypeId     String
  createdAt      DateTime @default(now())

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealType MealType @relation(fields: [mealTypeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, mealPlanId, mealTypeId])
  @@index([organizationId])
  @@index([mealPlanId])
}

/// Student ⇄ MealPlan per term. Historical/immutable: suspend/end/re-assign
/// create or close rows, never rewrite history. Invariant "one ACTIVE plan per
/// student per term" is enforced by a partial unique index (WHERE status='active')
/// created in the migration — a plain @@unique can't allow the historical rows.
model MealPlanAssignment {
  id               String               @id @default(uuid())
  organizationId   String
  studentProfileId String
  mealPlanId       String
  termId           String
  startDate        DateTime
  endDate          DateTime?
  status           MealAssignmentStatus @default(active)
  reason           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        String?
  updatedBy        String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  mealPlan       MealPlan       @relation(fields: [mealPlanId], references: [id])
  term           Term           @relation(fields: [termId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([organizationId, termId])
  @@index([mealPlanId])
}

/// A dated serving instance for a meal type (optionally scoped to a class).
model MealSession {
  id             String    @id @default(uuid())
  organizationId String
  mealTypeId     String
  date           DateTime
  /// Optional scope. Null = school-wide session for the date/meal.
  classId        String?
  sectionId      String?
  mealPlanId     String?
  expectedCount  Int       @default(0)
  servedCount    Int       @default(0)
  /// 'open' | 'closed'.
  status         String    @default("open")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  mealType    MealType         @relation(fields: [mealTypeId], references: [id])
  attendances MealAttendance[]

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([mealTypeId, date])
}

/// Per (student, session) serving record. No inventory side-effects — records
/// WHO was served, never moves stock.
model MealAttendance {
  id               String               @id @default(uuid())
  organizationId   String
  mealSessionId    String
  studentProfileId String
  status           MealAttendanceStatus @default(served)
  reason           String?
  markedById       String?
  markedAt         DateTime             @default(now())
  createdAt        DateTime             @default(now())

  mealSession    MealSession    @relation(fields: [mealSessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, mealSessionId, studentProfileId])
  @@index([organizationId])
  @@index([mealSessionId])
  @@index([studentProfileId])
}

/// Menu for a day (or weekday) + meal type, optionally scoped to a plan.
model MealMenu {
  id             String    @id @default(uuid())
  organizationId String
  mealTypeId     String
  date           DateTime?
  /// 0=Sun..6=Sat when the menu is a recurring weekday template.
  dayOfWeek      Int?
  mealPlanId     String?
  title          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  mealType MealType       @relation(fields: [mealTypeId], references: [id])
  mealPlan MealPlan?      @relation(fields: [mealPlanId], references: [id])
  items    MealMenuItem[]

  @@index([organizationId])
  @@index([mealTypeId])
  @@index([mealPlanId])
}

/// A dish line under a menu. Distinct from the POS `MenuItem`.
model MealMenuItem {
  id             String   @id @default(uuid())
  organizationId String
  mealMenuId     String
  name           String
  notes          String?
  sortOrder      Int      @default(0)
  /// Optional link to an imported POS `MenuItem` (same org) so the meal menu
  /// reuses the cafe catalog instead of duplicating dish data. Plain scalar
  /// (no Prisma relation) to avoid coupling MenuItem's relation set.
  posMenuItemId  String?
  /// Optional link to a recipe (drives kitchen production / inventory in V3).
  mealRecipeId   String?
  createdAt      DateTime @default(now())

  mealMenu   MealMenu    @relation(fields: [mealMenuId], references: [id], onDelete: Cascade)
  mealRecipe MealRecipe? @relation(fields: [mealRecipeId], references: [id])

  @@index([organizationId])
  @@index([mealMenuId])
  @@index([posMenuItemId])
}

/// A recipe (dish) mapping to inventory ingredients. School-owned (parallels the
/// POS MenuProduct BOM) so meals stay decoupled from POS ordering.
model MealRecipe {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  portionYield   Int       @default(1)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  ingredients MealRecipeIngredient[]
  menuItems   MealMenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// One ingredient line of a recipe: an inventory Product + quantity per portion.
model MealRecipeIngredient {
  id                 String   @id @default(uuid())
  organizationId     String
  mealRecipeId       String
  /// FK to inventory Product (kept as a plain scalar, like MealPlan.feeProductId).
  productId          String
  quantityPerPortion Decimal  @db.Decimal(20, 6)
  uomId              String?
  createdAt          DateTime @default(now())

  mealRecipe MealRecipe @relation(fields: [mealRecipeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mealRecipeId])
}

/// Kitchen production plan for a date + meal type: expected portions → required
/// ingredients, with actual issue/consumption/waste tracked on the items.
model MealProductionPlan {
  id               String               @id @default(uuid())
  organizationId   String
  mealTypeId       String
  date             DateTime
  mealSessionId    String?
  expectedPortions Int                  @default(0)
  status           MealProductionStatus @default(preparing)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  mealType     MealType            @relation(fields: [mealTypeId], references: [id])
  items        MealProductionItem[]
  consumptions MealConsumption[]
  wastes       MealWaste[]

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([mealTypeId, date])
}

/// Per-ingredient line of a production plan with full variance columns.
model MealProductionItem {
  id                   String   @id @default(uuid())
  organizationId       String
  mealProductionPlanId String
  productId            String
  uomId                String?
  plannedQuantity      Decimal  @default(0) @db.Decimal(20, 6)
  issuedQuantity       Decimal  @default(0) @db.Decimal(20, 6)
  consumedQuantity     Decimal  @default(0) @db.Decimal(20, 6)
  wastedQuantity       Decimal  @default(0) @db.Decimal(20, 6)
  returnedQuantity     Decimal  @default(0) @db.Decimal(20, 6)
  unitCost             Decimal  @default(0) @db.Decimal(20, 6)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  productionPlan MealProductionPlan @relation(fields: [mealProductionPlanId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mealProductionPlanId])
}

/// Actual ingredient issue/consume event — the ONLY thing that moves stock (via
/// StockService.issue). Keeps "served" (attendance) separate from "consumed".
/// Supports two scopes: (a) kitchen production issue (mealProductionPlanId set,
/// student NULL) and (b) per-student consumption when a plan serves a meal and
/// tracks inventory (studentProfileId + mealSessionId + mealMenuId set).
model MealConsumption {
  id                   String   @id @default(uuid())
  organizationId       String
  mealProductionPlanId String?
  mealSessionId        String?
  mealMenuId           String?
  studentProfileId     String?
  productId            String
  quantity             Decimal  @db.Decimal(20, 6)
  unitCost             Decimal  @default(0) @db.Decimal(20, 6)
  /// Link back to the inventory move that decremented stock.
  inventoryLedgerId    String?
  stockLocationId      String?
  consumedAt           DateTime @default(now())
  recordedById         String?
  createdAt            DateTime @default(now())

  productionPlan MealProductionPlan? @relation(fields: [mealProductionPlanId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mealProductionPlanId])
  @@index([mealSessionId])
  @@index([studentProfileId])
  @@index([mealMenuId])
}

/// Food waste record. Cost is computed from inventory costing, not hand-entered.
model MealWaste {
  id                   String          @id @default(uuid())
  organizationId       String
  mealProductionPlanId String?
  mealSessionId        String?
  productId            String?
  quantity             Decimal         @db.Decimal(20, 6)
  uomId                String?
  cost                 Decimal         @default(0) @db.Decimal(20, 6)
  reason               MealWasteReason @default(other)
  notes                String?
  recordedById         String?
  recordedAt           DateTime        @default(now())
  createdAt            DateTime        @default(now())

  productionPlan MealProductionPlan? @relation(fields: [mealProductionPlanId], references: [id])

  @@index([organizationId])
  @@index([mealProductionPlanId])
}

/// Immutable cafeteria-wallet ledger. MealAccount.balance is a cached read; this
/// ledger is the source of truth (safe refunds/reversals/reconciliation).
model MealAccountTransaction {
  id             String             @id @default(uuid())
  organizationId String
  mealAccountId  String
  type           MealAccountTxnType
  amount         Decimal            @db.Decimal(20, 6)
  balanceAfter   Decimal            @db.Decimal(20, 6)
  /// Idempotency/replay key (e.g. mobile-money ref). Dedup only when set.
  reference      String?
  paymentId      String?
  sourceType     String?
  sourceId       String?
  notes          String?
  recordedById   String?
  createdAt      DateTime           @default(now())

  mealAccount MealAccount @relation(fields: [mealAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mealAccountId])
}

model SchoolDashboardCache {
  id             String   @id @default(uuid())
  organizationId String
  /// 'admin' | 'academic' | 'finance' | 'operational'.
  kind           String
  /// Date this snapshot covers (end-of-day).
  asOf           DateTime
  payload        Json
  builtAt        DateTime @default(now())

  @@unique([organizationId, kind, asOf])
  @@index([organizationId, asOf])
}

/// School finance budgeting — planned vs actual spend per category/period.
model Budget {
  id             String   @id @default(uuid())
  organizationId String
  academicYearId String?
  termId         String?
  /// e.g. 'salaries', 'supplies', 'transport', 'utilities', 'capital', 'feeding'.
  category       String
  name           String
  /// Planned amount for the period (in org currency).
  amount         Decimal  @db.Decimal(18, 4)
  currency       String?
  periodFrom     DateTime?
  periodTo       DateTime?
  notes          String?
  /// 'draft' | 'approved' | 'closed'.
  status         String   @default("approved")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  term         Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([academicYearId])
  @@index([termId])
}

/// Front Desk visitor / walk-in log (check-in / check-out, purpose, host).
model FrontDeskLog {
  id             String   @id @default(uuid())
  organizationId String
  /// Optional link to an existing Partner (repeat visitor / parent / guest).
  partnerId      String?
  visitorName    String
  phone          String?
  purpose        String?
  personVisited  String?
  /// 'in' | 'out' | 'expected'.
  status         String   @default("in")
  notes          String?
  checkInAt      DateTime @default(now())
  checkOutAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([partnerId])
  @@index([status])
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║  MOODLE-SHAPED LMS  (ADR-014)                                              ║
// ║  docs/architecture/LMS-MOODLE-ARCHITECTURE.md                             ║
// ║  All models below are additive. Cross-aggregate links are FK-less string  ║
// ║  ids (the existing LMS idiom: LearningObjectiveEvidence.sourceId etc.);   ║
// ║  real relations exist only inside the LMS aggregate.                      ║
// ╚══════════════════════════════════════════════════════════════════════════╝

// ─────────────────────── P0 · Context & capability ───────────────────────

enum LmsContextLevel {
  system
  organization
  category
  course
  activity
  user
}

/// Access-control permission verbs (Moodle's roles/allow/prevent/prohibit).
enum LmsPermission {
  inherit
  allow
  prevent
  prohibit
}

/// Materialised-path context tree. path e.g. '/org-1/cat-3/course-88/cm-412/'.
model LmsContext {
  id             String          @id @default(uuid())
  organizationId String
  level          LmsContextLevel
  /// The row this context wraps: CourseOffering.id, CourseModule.id, CourseCategory.id, userId…
  instanceId     String?
  parentId       String?
  path           String
  depth          Int             @default(0)
  createdAt      DateTime        @default(now())

  parent          LmsContext?             @relation("LmsCtxTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        LmsContext[]            @relation("LmsCtxTree")
  roleAssignments LmsRoleAssignment[]
  overrides       LmsCapabilityOverride[]

  @@unique([organizationId, level, instanceId])
  @@index([organizationId, path])
  @@index([parentId])
}

/// Role definition. archetype ∈ manager|coursecreator|editingteacher|teacher|student|parent|observer|guest.
model LmsRole {
  id             String            @id @default(uuid())
  organizationId String
  shortname      String
  name           String
  archetype      String
  sortOrder      Int               @default(0)
  /// Context levels at which this role may be assigned.
  assignableAt   LmsContextLevel[]
  createdAt      DateTime          @default(now())

  capabilities LmsRoleCapability[]
  assignments  LmsRoleAssignment[]

  @@unique([organizationId, shortname])
  @@index([organizationId])
}

model LmsRoleCapability {
  id         String        @id @default(uuid())
  roleId     String
  capability String
  permission LmsPermission @default(inherit)

  role LmsRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, capability])
  @@index([capability])
}

model LmsRoleAssignment {
  id               String   @id @default(uuid())
  organizationId   String
  contextId        String
  roleId           String
  /// Exactly one principal. Staff carry a userId; students a studentProfileId.
  userId           String?
  studentProfileId String?
  /// Enrolment component that created it, for auto-sync reconciliation.
  sourceComponent  String?
  createdAt        DateTime @default(now())

  context LmsContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  role    LmsRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([contextId, roleId, userId, studentProfileId])
  @@index([organizationId, userId])
  @@index([organizationId, studentProfileId])
  @@index([roleId])
}

/// Per-context capability override ("permissions in this context").
model LmsCapabilityOverride {
  id         String        @id @default(uuid())
  contextId  String
  roleId     String
  capability String
  permission LmsPermission

  context LmsContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, roleId, capability])
  @@index([contextId])
}

// ─────────────────────── P1 · Course spine ───────────────────────

enum CourseFormat {
  weeks
  topics
  single_activity
  social
  flexible
}

enum GroupMode {
  none
  separate
  visible
}

enum CompletionMode {
  none
  manual
  automatic
}

/// Optional browse tree above offerings (department / stage / subject area).
model CourseCategory {
  id             String   @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  path           String
  depth          Int      @default(0)
  sortOrder      Int      @default(0)
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())

  parent   CourseCategory?  @relation("CourseCatTree", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CourseCatTree")

  @@index([organizationId, path])
}

/// Moodle course_sections. sectionNo 0 = "General" (always visible, no dates).
model CourseSection {
  id               String    @id @default(uuid())
  organizationId   String
  courseOfferingId String
  sectionNo        Int
  name             String?
  summary          String?
  visible          Boolean   @default(true)
  /// Availability tree (see AvailabilityService). null = always available.
  availability     Json?
  /// For format=weeks: the Monday of the week this section covers.
  weekOf           DateTime?
  /// Ordered CourseModule ids — one-write drag reorder (Moodle sequence).
  sequence         String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  modules        CourseModule[]

  @@unique([courseOfferingId, sectionNo])
  @@index([organizationId])
  @@index([courseOfferingId])
}

/// Registry of installed activity types (Moodle's `modules` table).
model LmsActivityType {
  id                     String  @id @default(uuid())
  name                   String  @unique
  label                  String
  icon                   String  @default("Square")
  gradable               Boolean @default(false)
  supportsGroups         Boolean @default(false)
  supportsCompletionAuto Boolean @default(true)
  hasSubmissions         Boolean @default(false)
  visible                Boolean @default(true)
  sortOrder              Int     @default(0)
}

/// Moodle course_modules — the spine row for every placed activity.
model CourseModule {
  id               String         @id @default(uuid())
  organizationId   String
  courseOfferingId String
  sectionId        String
  activityType     String
  /// Polymorphic FK into the per-type instance table (plugin-enforced integrity).
  instanceId       String
  idnumber         String?
  sequence         Int            @default(0)
  visible          Boolean        @default(true)
  visibleOnPage    Boolean        @default(true)
  availability     Json?
  groupMode        GroupMode      @default(none)
  groupingId       String?
  completionMode   CompletionMode @default(manual)
  completionRules  Json           @default("{}")
  /// Set when gradable: the single Assessment this module owns (FK-less). Marks never live here.
  assessmentId     String?        @unique
  openAt           DateTime?
  dueAt            DateTime?
  cutoffAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  courseOffering CourseOffering           @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  section        CourseSection            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completions    CourseModuleCompletion[]

  @@index([organizationId, courseOfferingId])
  @@index([activityType, instanceId])
  @@index([sectionId])
  @@index([organizationId, dueAt])
}

// ─────────────────────── P2 · content activity instances ───────────────────────

model ModResource {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  /// FK-less link to LearningResource (the file), or a raw fileId.
  resourceId     String?
  fileId         String?
  displayMode    String   @default("auto")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ModUrl {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  externalUrl    String
  display        String   @default("new_window")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ModPage {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  content        String   @default("")
  contentFormat  String   @default("html")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ModLabel {
  id             String   @id @default(uuid())
  organizationId String
  content        String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ModFolder {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  /// FK-less list of LmsFile / fileIds.
  fileIds        String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────── P3 · adapter activity instances ───────────────────────

/// Wraps the existing Assignment/AssignmentSubmission chain (Moodle mod_assign).
model ModAssign {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  intro              String?
  /// FK-less link to the existing Assignment row that carries the real submission/grade tables.
  assignmentId       String?
  /// FK-less link to a migrated HomeworkAssignment (dual-read during P3).
  homeworkId         String?
  allowSubmissionsFrom DateTime?
  dueDate            DateTime?
  cutoffDate         DateTime?
  maxScore           Decimal   @default(100) @db.Decimal(8, 2)
  submissionTypes    String[]  @default(["online_text", "file"])
  maxAttempts        Int       @default(1)
  teamSubmission     Boolean   @default(false)
  blindMarking       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Wraps the existing Discussion/DiscussionPost chain (Moodle mod_forum).
model ModForum {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  /// general | eachuser | single | qanda | news.
  forumType      String   @default("general")
  /// optional|forced|auto|disabled.
  subscription   String   @default("optional")
  maxAttachments Int      @default(2)
  ratingScale    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions ModForumSubscription[]
}

model ModForumSubscription {
  id               String   @id @default(uuid())
  organizationId   String
  forumId          String
  userId           String?
  studentProfileId String?
  createdAt        DateTime @default(now())

  forum ModForum @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@unique([forumId, userId, studentProfileId])
  @@index([forumId])
}

// ─────────────────────── P4 · enrolment / groups / completion ───────────────────────

enum EnrolMethod {
  roster_sync
  manual
  self
  cohort
  guest
}

enum EnrolStatus {
  active
  suspended
}

enum CompletionState {
  incomplete
  complete
  complete_pass
  complete_fail
}

model CourseEnrolmentMethod {
  id               String      @id @default(uuid())
  organizationId   String
  courseOfferingId String
  method           EnrolMethod
  enabled          Boolean     @default(true)
  config           Json        @default("{}")
  defaultRoleId    String?
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())

  courseOffering CourseOffering    @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  enrolments     CourseEnrolment[]

  @@unique([courseOfferingId, method])
  @@index([organizationId])
}

model CourseEnrolment {
  id               String      @id @default(uuid())
  organizationId   String
  courseOfferingId String
  methodId         String
  studentProfileId String?
  userId           String?
  status           EnrolStatus @default(active)
  startedAt        DateTime?
  endsAt           DateTime?
  lastAccessAt     DateTime?
  createdAt        DateTime    @default(now())

  courseOffering CourseOffering        @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  method         CourseEnrolmentMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@unique([courseOfferingId, studentProfileId, userId])
  @@index([organizationId, studentProfileId])
  @@index([courseOfferingId])
}

model LmsGroup {
  id               String   @id @default(uuid())
  organizationId   String
  courseOfferingId String
  name             String
  description      String?
  enrolmentKey     String?
  createdAt        DateTime @default(now())

  courseOffering CourseOffering   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  members        LmsGroupMember[]

  @@unique([courseOfferingId, name])
  @@index([organizationId])
}

model LmsGroupMember {
  id               String   @id @default(uuid())
  groupId          String
  studentProfileId String?
  userId           String?
  createdAt        DateTime @default(now())

  group LmsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentProfileId, userId])
  @@index([groupId])
}

model LmsGrouping {
  id               String   @id @default(uuid())
  organizationId   String
  courseOfferingId String
  name             String
  groupIds         String[] @default([])
  createdAt        DateTime @default(now())

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([courseOfferingId, name])
}

model CourseModuleCompletion {
  id               String          @id @default(uuid())
  organizationId   String
  courseModuleId   String
  studentProfileId String
  state            CompletionState @default(incomplete)
  viewed           Boolean         @default(false)
  overriddenById   String?
  completedAt      DateTime?
  updatedAt        DateTime        @updatedAt

  courseModule CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)

  @@unique([courseModuleId, studentProfileId])
  @@index([organizationId, studentProfileId])
}

model CourseCompletionCriteria {
  id               String   @id @default(uuid())
  organizationId   String
  courseOfferingId String
  criteriaType     String
  courseModuleId   String?
  minGrade         Decimal? @db.Decimal(5, 2)
  byDate           DateTime?
  aggregation      String   @default("all")
  createdAt        DateTime @default(now())

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@index([organizationId, courseOfferingId])
}

// ─────────────────────── P5 · gradebook additions ───────────────────────

model AssessmentGradeOverride {
  id                  String   @id @default(uuid())
  organizationId      String
  studentAssessmentId String   @unique
  overriddenScore     Decimal  @db.Decimal(8, 2)
  reason              String?
  overriddenById      String
  createdAt           DateTime @default(now())

  @@index([organizationId])
}

model StudentAssessmentHistory {
  id                  String   @id @default(uuid())
  organizationId      String
  studentAssessmentId String
  oldScore            Decimal? @db.Decimal(8, 2)
  newScore            Decimal? @db.Decimal(8, 2)
  source              String
  changedById         String?
  changedAt           DateTime @default(now())

  @@index([organizationId, studentAssessmentId])
}

// ─────────────────────── P6 · quiz depth ───────────────────────

model ModQuiz {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  intro            String?
  /// FK-less optional link to a pre-built QuestionPaper.
  questionPaperId  String?
  timeLimitSec     Int?
  attemptsAllowed  Int      @default(0)
  gradingMethod    String   @default("highest")
  navMethod        String   @default("free")
  shuffleQuestions Boolean  @default(false)
  shuffleAnswers   Boolean  @default(true)
  behaviour        String   @default("deferredfeedback")
  reviewOptions    Json     @default("{}")
  overallFeedback  Json     @default("[]")
  maxScore         Decimal  @default(100) @db.Decimal(8, 2)
  openAt           DateTime?
  closeAt          DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slots     QuizSlot[]
  overrides QuizOverride[]
}

/// Question categories: a tree OWNED BY A CONTEXT (course bank vs shared org bank).
model QuestionCategory {
  id             String   @id @default(uuid())
  organizationId String
  contextId      String
  parentId       String?
  name           String
  info           String?
  path           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, contextId])
}

/// Moodle 4.x question versioning: edits create a version; live attempts keep theirs.
model QuestionVersion {
  id         String   @id @default(uuid())
  questionId String
  version    Int
  status     String   @default("ready")
  snapshot   Json
  createdAt  DateTime @default(now())

  @@unique([questionId, version])
  @@index([questionId])
}

model QuizSlot {
  id                String   @id @default(uuid())
  organizationId    String
  quizId            String
  page              Int      @default(1)
  slotNo            Int
  questionId        String?
  questionVersionId String?
  randomCategoryId  String?
  randomIncludeSub  Boolean  @default(false)
  randomTags        String[] @default([])
  maxMark           Decimal  @default(1) @db.Decimal(8, 2)
  requirePrevious   Boolean  @default(false)

  quiz ModQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, slotNo])
  @@index([quizId])
}

model QuizOverride {
  id               String    @id @default(uuid())
  organizationId   String
  quizId           String
  studentProfileId String?
  groupId          String?
  openAt           DateTime?
  closeAt          DateTime?
  timeLimitSec     Int?
  attemptsAllowed  Int?
  createdAt        DateTime  @default(now())

  quiz ModQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

// ─────────────────────── P7 · events, reports, badges ───────────────────────

/// Moodle's standard log — one row per mutation, written by the plugin base.
model LmsEvent {
  id               String   @id @default(uuid())
  organizationId   String
  eventName        String
  component        String
  action           String
  target           String
  contextId        String?
  courseOfferingId String?
  courseModuleId   String?
  objectId         String?
  userId           String?
  studentProfileId String?
  other            Json     @default("{}")
  createdAt        DateTime @default(now())

  @@index([organizationId, courseOfferingId, createdAt])
  @@index([organizationId, studentProfileId, createdAt])
  @@index([organizationId, component, action])
}

model LmsBadge {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  imageUrl       String?
  /// manual | course_completion | activity_completion | grade.
  criteriaType   String   @default("manual")
  criteria       Json     @default("{}")
  courseOfferingId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  awards LmsBadgeAward[]

  @@index([organizationId])
}

model LmsBadgeAward {
  id               String   @id @default(uuid())
  organizationId   String
  badgeId          String
  studentProfileId String?
  userId           String?
  awardedAt        DateTime @default(now())
  awardedById      String?

  badge LmsBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([badgeId, studentProfileId, userId])
  @@index([organizationId])
}

// ─────────────────────── P8 · standards & extra activity instances ───────────────────────

model ModChoice {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  allowMultiple  Boolean  @default(false)
  allowUpdate    Boolean  @default(true)
  limitAnswers   Boolean  @default(false)
  showResults    String   @default("after_answer")
  publishAnon    Boolean  @default(false)
  options        Json     @default("[]")
  closeAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  answers ModChoiceAnswer[]
}

model ModChoiceAnswer {
  id               String   @id @default(uuid())
  organizationId   String
  choiceId         String
  optionKey        String
  studentProfileId String?
  userId           String?
  createdAt        DateTime @default(now())

  choice ModChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@index([choiceId])
}

model ModGlossary {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  allowComments  Boolean  @default(false)
  allowDuplicate Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries ModGlossaryEntry[]
}

model ModGlossaryEntry {
  id             String   @id @default(uuid())
  organizationId String
  glossaryId     String
  concept        String
  definition     String
  aliases        String[] @default([])
  approved       Boolean  @default(true)
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  glossary ModGlossary @relation(fields: [glossaryId], references: [id], onDelete: Cascade)

  @@index([glossaryId])
}

model ModWiki {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  /// collaborative | individual.
  wikiMode       String   @default("collaborative")
  firstPageTitle String   @default("Home")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pages ModWikiPage[]
}

model ModWikiPage {
  id        String   @id @default(uuid())
  organizationId String
  wikiId    String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wiki     ModWiki          @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  versions ModWikiVersion[]

  @@unique([wikiId, title])
  @@index([wikiId])
}

model ModWikiVersion {
  id        String   @id @default(uuid())
  pageId    String
  version   Int
  content   String
  authorId  String?
  createdAt DateTime @default(now())

  page ModWikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
}

model ModLesson {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  gradable       Boolean  @default(false)
  maxScore       Decimal  @default(100) @db.Decimal(8, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pages ModLessonPage[]
}

model ModLessonPage {
  id           String   @id @default(uuid())
  organizationId String
  lessonId     String
  title        String
  content      String   @default("")
  /// content | question.
  pageType     String   @default("content")
  qtype        String?
  sequence     Int      @default(0)
  /// Branches: [{ label, answer?, correct?, jumpToPageId? }].
  branches     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lesson ModLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model ModFeedback {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  anonymous      Boolean  @default(true)
  multipleSubmit Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items     ModFeedbackItem[]
  responses ModFeedbackResponse[]
}

model ModFeedbackItem {
  id             String   @id @default(uuid())
  organizationId String
  feedbackId     String
  label          String
  /// text | textarea | multichoice | rating | info.
  itemType       String   @default("text")
  required       Boolean  @default(false)
  options        Json     @default("[]")
  sequence       Int      @default(0)

  feedback ModFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model ModFeedbackResponse {
  id               String   @id @default(uuid())
  organizationId   String
  feedbackId       String
  studentProfileId String?
  userId           String?
  answers          Json     @default("{}")
  submittedAt      DateTime @default(now())

  feedback ModFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model ModWorkshop {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  intro           String?
  /// setup | submission | assessment | grading | closed.
  phase           String   @default("setup")
  instructAuthors String?
  instructReviewers String?
  submissionStart DateTime?
  submissionEnd   DateTime?
  assessmentStart DateTime?
  assessmentEnd   DateTime?
  gradeSubmission Decimal  @default(80) @db.Decimal(8, 2)
  gradeAssessment Decimal  @default(20) @db.Decimal(8, 2)
  numReviewers    Int      @default(3)
  rubric          Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions ModWorkshopSubmission[]
  allocations ModWorkshopAllocation[]
}

model ModWorkshopSubmission {
  id               String   @id @default(uuid())
  organizationId   String
  workshopId       String
  studentProfileId String
  title            String
  content          String?
  attachments      Json     @default("[]")
  submittedAt      DateTime @default(now())

  workshop    ModWorkshop             @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  allocations ModWorkshopAllocation[]

  @@index([workshopId])
}

model ModWorkshopAllocation {
  id             String   @id @default(uuid())
  organizationId String
  workshopId     String
  submissionId   String
  reviewerProfileId String
  grade          Decimal? @db.Decimal(8, 2)
  feedback       String?
  filledRubric   Json     @default("{}")
  submittedAt    DateTime?
  createdAt      DateTime @default(now())

  workshop   ModWorkshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  submission ModWorkshopSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, reviewerProfileId])
  @@index([workshopId])
}

/// SCORM package instance + per-user tracking (CMI subset).
model ModScorm {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  /// FK-less fileId of the uploaded .zip package; manifest parsed into `manifest`.
  packageFileId  String?
  scormVersion   String   @default("1.2")
  manifest       Json     @default("{}")
  maxAttempts    Int      @default(0)
  gradingMethod  String   @default("highest")
  maxScore       Decimal  @default(100) @db.Decimal(8, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tracks ScormTrack[]
}

model ScormTrack {
  id               String   @id @default(uuid())
  organizationId   String
  scormId          String
  studentProfileId String
  scoIdentifier    String
  attempt          Int      @default(1)
  /// CMI element → value map (cmi.core.lesson_status, cmi.core.score.raw, …).
  cmi              Json     @default("{}")
  lessonStatus     String   @default("not attempted")
  scoreRaw         Decimal? @db.Decimal(8, 2)
  totalTimeSec     Int      @default(0)
  updatedAt        DateTime @updatedAt

  scorm ModScorm @relation(fields: [scormId], references: [id], onDelete: Cascade)

  @@unique([scormId, studentProfileId, scoIdentifier, attempt])
  @@index([scormId])
}

/// LTI 1.3 external tool link (tool consumer side).
model ModLti {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  toolUrl        String
  clientId       String?
  deploymentId   String?
  publicKeyset   String?
  loginUrl       String?
  redirectUrls   String[] @default([])
  customParams   Json     @default("{}")
  launchContainer String  @default("new_window")
  gradable       Boolean  @default(false)
  maxScore       Decimal  @default(100) @db.Decimal(8, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// H5P interactive content instance + xAPI capture.
model ModH5p {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  intro          String?
  /// FK-less fileId of the uploaded .h5p; extracted metadata in `contentJson`.
  packageFileId  String?
  contentJson    Json     @default("{}")
  library        String?
  gradable       Boolean  @default(false)
  maxScore       Decimal  @default(100) @db.Decimal(8, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  statements XapiStatement[]
}

/// xAPI statements captured from H5P / external tools.
model XapiStatement {
  id               String   @id @default(uuid())
  organizationId   String
  h5pId            String?
  courseModuleId   String?
  studentProfileId String?
  userId           String?
  verb             String
  object           String
  /// { score?, success?, completion?, duration?, response? }
  result           Json     @default("{}")
  raw              Json     @default("{}")
  createdAt        DateTime @default(now())

  h5p ModH5p? @relation(fields: [h5pId], references: [id], onDelete: Cascade)

  @@index([organizationId, courseModuleId])
  @@index([organizationId, studentProfileId])
}

// ─────────────────────── files ───────────────────────

/// Context-addressed file record layered over kernel/files (Moodle file API).
model LmsFile {
  id             String   @id @default(uuid())
  organizationId String
  fileId         String
  contextId      String
  component      String
  fileArea       String
  itemId         String
  filePath       String   @default("/")
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, component, fileArea, itemId])
  @@index([contextId])
}

/// Submissions for the LMS-native mod_assign. Grades live in the spine
/// (StudentAssessment via the grade bridge); this holds only the artefact.
model ModAssignSubmission {
  id               String    @id @default(uuid())
  organizationId   String
  assignId         String
  courseModuleId   String
  studentProfileId String
  attemptNo        Int       @default(1)
  content          String?
  attachments      Json      @default("[]")
  status           String    @default("submitted") // draft | submitted | graded
  submittedAt      DateTime  @default(now())
  gradedAt         DateTime?
  feedback         String?
  updatedAt        DateTime  @updatedAt

  @@unique([assignId, studentProfileId, attemptNo])
  @@index([organizationId, courseModuleId])
  @@index([studentProfileId])
}
