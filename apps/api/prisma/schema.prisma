// ------------------------- System / global tables ---------------------------

/// Tenant root. This table IS the tenant, so it has no organizationId.
model Organization {
  id                  String             @id @default(uuid())
  code                String             @unique
  name                String
  timezone            String             @default("UTC")
  currencyCode        String             @default("USD")
  /// Phase C: FK to Currency for the org's base. Defaults to "USD" via seed.
  /// Renamed relation name avoids ambiguity with other Currency refs.
  baseCurrency        Currency?          @relation("OrgBaseCurrency", fields: [currencyCode], references: [code])
  status              OrganizationStatus @default(active)
  settings            Json               @default("{}")
  /// Books lock date (hard close). Any posting dated on or before this instant is
  /// rejected regardless of fiscal-period status. Null = no global lock.
  booksLockDate       DateTime?
  /// When true, a posting date MUST fall inside a defined fiscal period; dates
  /// outside every period are rejected. Default false (periods stay optional).
  requireFiscalPeriod Boolean            @default(false)
  /// Receipt header/footer overrides (businessName, addressLine1, phone, taxId, message)
  receiptHeader       Json?
  receiptFooter       Json?
  /// Report card printable configuration (logo, colors, visibility toggles).
  reportCardSettings  ReportCardSettings?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
}

/// Global permission catalog (resource:action). Seeded from @erp/shared.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
}

/// Global ISO-4217 currency catalog (ADR-004: currency is global).
model Currency {
  id            String   @id @default(uuid())
  code          String   @unique
  symbol        String
  name          String
  decimalPlaces Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Phase C: this currency IS the org's base for these organizations.
  baseForOrganizations Organization[] @relation("OrgBaseCurrency")
  /// Phase C: FX rates where this currency is the FROM side.
  ratesFrom            CurrencyRate[] @relation("CurrencyRateFrom")
  /// Phase C: FX rates where this currency is the TO side.
  ratesTo              CurrencyRate[] @relation("CurrencyRateTo")
}

/// Phase C: FX rate between two currencies on a given date. Rates are
/// denominated in the TO currency per 1 unit of FROM currency. We use the
/// "as-of" lookup semantics: posting a 2024-01-15 invoice reads the rate
/// whose `asOf` is the most recent ≤ postingDate (per IFRS IAS 21).
model CurrencyRate {
  id        String   @id @default(uuid())
  fromCode  String
  toCode    String
  asOf      DateTime
  rate      Decimal  @db.Decimal(18, 8)
  /// Where this rate came from: 'manual' (operator entry), 'ecb' (European
  /// Central Bank daily reference), 'fed' (US Fed), 'import' (CSV upload).
  source    String   @default("manual")
  createdAt DateTime @default(now())

  from Currency @relation("CurrencyRateFrom", fields: [fromCode], references: [code], onDelete: Cascade)
  to   Currency @relation("CurrencyRateTo", fields: [toCode], references: [code], onDelete: Cascade)

  @@unique([fromCode, toCode, asOf])
  @@index([fromCode, toCode, asOf])
}

/// Phase C: unrealized FX gain/loss on monetary balances in foreign currency.
/// Written by `RevaluationService.runPeriod(periodId)` at period close.
model FxRevaluation {
  id              String   @id @default(uuid())
  organizationId  String
  fiscalPeriodId  String
  asOf            DateTime
  accountId       String
  currencyCode    String
  /// Book balance in the foreign currency.
  bookBalance     Decimal  @db.Decimal(20, 6)
  /// Balance valued at closing rate (in org base currency).
  revaluedBalance Decimal  @db.Decimal(20, 6)
  /// Gain (positive) or loss (negative) posted to the FX adjustment account.
  fxGain          Decimal  @db.Decimal(20, 6)
  rate            Decimal  @db.Decimal(18, 8)
  createdAt       DateTime @default(now())

  @@unique([organizationId, fiscalPeriodId, accountId])
  @@index([organizationId, fiscalPeriodId])
}

// =============================================================================
// Phase D — Bank reconciliation
// =============================================================================

/// Bank statement imported from a CSV / MT940 / OFX file. Each row is a
/// single transaction on the bank side.
model BankStatementLine {
  id               String   @id @default(uuid())
  organizationId   String
  bankAccountId    String // -> BankAccount.id
  postedAt         DateTime
  /// Bank's reference (often a transaction ID, check #, etc.).
  externalRef      String?
  description      String
  /// Positive = money in, negative = money out (in the bank's currency).
  amount           Decimal  @db.Decimal(20, 6)
  currencyCode     String
  /// Status: 'unmatched' | 'matched' | 'ignored'.
  status           String   @default("unmatched")
  /// Linked payment (null until matched).
  matchedPaymentId String?
  /// Linked bank reconciliation run.
  matchedRunId     String?
  createdAt        DateTime @default(now())

  @@index([organizationId, bankAccountId, postedAt])
  @@index([status])
}

/// Reconciliation run — a single attempt to match a chunk of statement lines
/// against payments. Stores summary stats for audit.
model BankReconciliationRun {
  id             String    @id @default(uuid())
  organizationId String
  bankAccountId  String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  matched        Int       @default(0)
  unmatched      Int       @default(0)
  totalAmount    Decimal   @db.Decimal(20, 6)
  notes          String?
  createdById    String?

  @@index([organizationId, bankAccountId, startedAt])
}

// ------------------------------- Auth / RBAC --------------------------------

model User {
  id               String    @id @default(uuid())
  organizationId   String
  email            String
  passwordHash     String
  firstName        String
  lastName         String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  /// Phase B1: TOTP secret (encrypted at rest with AES-256-GCM via the
  /// EncryptionService using a key derived from JWT_ACCESS_SECRET). `null`
  /// means MFA is not enrolled. The plaintext is never stored.
  mfaSecret        String?
  /// Phase B1: Initialization vector for the mfaSecret ciphertext (hex).
  mfaSecretIv      String?
  /// Phase B1: Auth tag for the mfaSecret ciphertext (hex).
  mfaSecretTag     String?
  /// Phase B1: when MFA was enrolled. Used by the UI to show "MFA active since X".
  mfaEnrolledAt    DateTime?
  /// Phase B1: number of consecutive failed login attempts. Reset on success.
  /// When ≥ 10, the account is locked and requires admin intervention.
  failedLoginCount Int       @default(0)
  /// Phase B1: when the account was locked.
  lockedUntil      DateTime?
  /// POS Phase A: optional manager PIN hash (bcrypt). Lets a cashier trigger
  /// a manager override (`pos:override`) by entering the manager's email + PIN
  /// without exposing the manager's full login password. Null = no PIN set.
  pinHash          String?
  /// POS Phase A: salt rounds used for the PIN hash (recorded at set time so
  /// future rehashes can be triggered). Defaults handled at write time.
  pinHashRounds    Int?
  /// Phase F: the user's home branch. Optional; null = access to all branches
  /// the org has marked "all-access". Used by branch-scoped queries.
  defaultBranchId  String?
  /// Communication: the staff member's Telegram chat id, set when they link the
  /// bot. Lets event-driven notifications reach a staff member over Telegram.
  telegramChatId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  roles           Role[]         @relation("UserRoles")
  refreshTokens   RefreshToken[]
  tasksAssigned   Task[]         @relation("TaskAssignee")
  tasksSupervised Task[]         @relation("TaskSupervisor")
  tasksVerified   Task[]         @relation("TaskVerifier")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Role {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean   @default(false)
  permissions    String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  users User[] @relation("UserRoles")

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RefreshToken {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  tokenHash      String
  expiresAt      DateTime
  revokedAt      DateTime?
  /// D4-4: when this token is rotated, the new refresh token's id goes here.
  /// Allows audit chains ("this token replaced by X, which replaced by Y").
  replacedById   String?
  /// Optional human-readable device label for the active-sessions UI.
  deviceLabel    String?
  /// IP and user-agent captured at login. Audit-friendly.
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tokenHash])
  @@index([organizationId])
  @@index([userId])
}

/// Idempotency cache (M-Day1-2). Stores the response of money-mutating POSTs
/// keyed on the caller's `Idempotency-Key` header. A retry with the same key
/// + same body returns the cached response without re-running the handler,
/// preventing duplicate invoices / duplicate GL posts / duplicate stock issues.
model IdempotencyRecord {
  id             String    @id @default(uuid())
  organizationId String
  key            String
  requestHash    String
  method         String
  path           String
  statusCode     Int
  responseJson   Json
  /// `pending` while the handler is running; `completed` once we stored the
  /// response. A second request that finds `pending` returns 409 (the first
  /// request is still in flight).
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([organizationId, key])
  @@index([organizationId, createdAt])
}

// ------------------------------- Kernel -------------------------------------

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String
  entity         String
  entityId       String
  action         AuditAction
  oldValues      Json?
  newValues      Json?
  actorId        String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  @@index([organizationId, entity, entityId])
  @@index([organizationId, createdAt])
}

/// Phase B1: tracks every login attempt for brute-force detection and
/// forensic review. Persists even failed attempts.
model LoginAttempt {
  id             String   @id @default(uuid())
  organizationId String?
  email          String
  success        Boolean
  /// When MFA was required but not yet verified.
  mfaRequired    Boolean  @default(false)
  ipAddress      String?
  userAgent      String?
  /// Failure reason if `success = false`.
  reason         String?
  createdAt      DateTime @default(now())

  @@index([email, createdAt])
  @@index([organizationId, createdAt])
  @@index([ipAddress, createdAt])
}

/// Settings at system (organizationId null), organization, or module scope.
///
/// Hierarchical config (ADR-005): a setting resolves most-specific-first
/// product -> category -> warehouse -> organization. `scopeType` names the level
/// and `scopeId` the target id at that level ("" = the whole organization, so the
/// unique constraint stays NULL-free — Postgres treats NULLs as distinct, which
/// would let duplicate org-level rows slip through). Legacy `scope`/`module`
/// columns are retained for backward compatibility.
model Setting {
  id             String   @id @default(uuid())
  organizationId String?
  scope          String   @default("organization")
  module         String?
  /// organization | warehouse | category | product
  scopeType      String   @default("organization")
  /// Target id at scopeType level; "" means the whole organization.
  scopeId        String   @default("")
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, scopeType, scopeId, key])
  @@index([organizationId])
  @@index([organizationId, scopeType, scopeId])
}

// ---------------------------- Master data -----------------------------------

model Partner {
  id                      String        @id @default(uuid())
  organizationId          String
  code                    String
  name                    String
  isCompany               Boolean       @default(false)
  isCustomer              Boolean       @default(false)
  isSupplier              Boolean       @default(false)
  isEmployee              Boolean       @default(false)
  email                   String?
  phone                   String?
  /// Communication: normalized E.164 form of `phone` (e.g. +256701234567), used
  /// for inbound WhatsApp/SMS sender → Partner resolution. `phone` is kept as the
  /// human-entered display value; this is the machine key. Nullable because not
  /// every partner has a valid mobile number.
  phoneE164               String?
  /// Communication: the partner has consented to be contacted over chat channels
  /// (WhatsApp/Telegram). Defaults false — business-initiated outbound must never
  /// assume consent.
  chatOptIn               Boolean       @default(false)
  website                 String?
  taxNumber               String?
  membershipLevel         String?
  /// Per-customer automatic discount %, applied on every line when this partner
  /// is attached to a POS sale. 0 = none. Highest priority in the customer
  /// discount cascade (wins over category + membership tier). See
  /// PartnerDiscountService.resolve().
  discountPercentOverride Decimal       @default(0) @db.Decimal(9, 4)
  gender                  String?
  receivableAccountId     String?
  payableAccountId        String?
  /// AR credit control: limit (0 = none) and a manual hold flag that blocks new
  /// credit sales when set. paymentTermId drives invoice due-date derivation.
  creditLimit             Decimal       @default(0) @db.Decimal(20, 2)
  creditHold              Boolean       @default(false)
  paymentTermId           String?
  status                  PartnerStatus @default(active)
  categoryId              String?
  notes                   String?
  customFields            Json          @default("{}")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  createdBy               String?
  updatedBy               String?
  deletedAt               DateTime?

  category         PartnerCategory?      @relation(fields: [categoryId], references: [id])
  contacts         Contact[]
  addresses        Address[]
  documents        Document[]
  payments         Payment[]
  purchaseOrders   PurchaseOrder[]       @relation("PurchaseOrder_partner")
  purchaseRequests PurchaseRequest[]     @relation("PurchaseRequest_partner")
  debitNotes       DebitNote[]           @relation("DebitNote_partner")
  deals            Deal[]                @relation("PartnerDeals")
  activities       Activity[]            @relation("PartnerActivities")
  suppliedProducts Product[]             @relation("ProductSupplier")
  rentalAgreements RentalAgreement[]
  rentalDeposits   RentalDeposit[]
  rentalScores     RentalCustomerScore[]
  // School vertical (H): the 1:1 back-relations to the profile that treats this
  // Partner as its AR account. The FK already lived on the profile as a bare
  // scalar; these formalize it so `include: { partner: true }` works.
  schoolStudent    StudentProfile?       @relation("StudentPartner")
  schoolStaff      StaffProfile?         @relation("StaffPartner")
  sponsorships     Sponsorship[]
  frontDeskLogs    FrontDeskLog[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, phoneE164])
}

model PartnerCategory {
  id                      String    @id @default(uuid())
  organizationId          String
  name                    String
  parentId                String?
  /// Group discount % inherited by all partners in this category (unless the
  /// partner has their own override). 0 = inherit from the nearest ancestor
  /// category with a non-zero value (walked via parentId).
  discountPercentOverride Decimal   @default(0) @db.Decimal(9, 4)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdBy               String?
  updatedBy               String?
  deletedAt               DateTime?

  parent   PartnerCategory?  @relation("PartnerCategoryTree", fields: [parentId], references: [id])
  children PartnerCategory[] @relation("PartnerCategoryTree")
  partners Partner[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Organization-defined membership tier (Bronze/Silver/Gold…). When a Partner's
/// `membershipLevel` string matches a tier `name`, the tier's discount auto-
/// applies on POS sale attach — the lowest-priority source in the customer
/// discount cascade (a per-partner or category override wins over this).
model MembershipTier {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  discountPercent  Decimal  @default(0) @db.Decimal(9, 4)
  /// Lifetime-spend threshold for auto-promotion into this tier (informational
  /// in Phase 1; not auto-enforced yet).
  minLifetimeSpend Decimal  @default(0) @db.Decimal(20, 6)
  color            String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Contact {
  id             String    @id @default(uuid())
  organizationId String
  partnerId      String
  firstName      String
  lastName       String?
  position       String?
  email          String?
  phone          String?
  isPrimary      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // H3: school guardianships that point at this Contact (see StudentGuardian).
  guardianships StudentGuardian[] @relation("GuardianContact")

  @@index([organizationId])
  @@index([partnerId])
}

model Address {
  id             String      @id @default(uuid())
  organizationId String
  partnerId      String
  type           AddressType @default(billing)
  line1          String
  line2          String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  isPrimary      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([partnerId])
}

model Product {
  id                            String             @id @default(uuid())
  organizationId                String
  code                          String
  sku                           String?
  /// EAN-13 / UPC for POS barcode scanning. Org-scoped unique when present.
  barcode                       String?
  name                          String
  description                   String?
  /// Image URL for the product (shown in POS terminal tiles).
  image                         String?
  productType                   ProductType        @default(stockable)
  costingMethod                 CostingMethod      @default(AVCO)
  categoryId                    String?
  brandId                       String?
  /// Default vendor for reorder/PO suggestions. Reuses the Partner master
  /// (a Partner flagged as a supplier) — we do NOT introduce a separate
  /// Supplier table.
  supplierId                    String?
  uomId                         String?
  /// F.8 dual-unit: how the product is PURCHASED (case, kg, bottle). Defaults
  /// to `uomId` (stock unit) when null. `uomConversion` = stockUnits per 1
  /// purchaseUnit (e.g. 1 case = 24 pcs → 24).
  purchaseUomId                 String?
  uomConversion                 Decimal            @default(1) @db.Decimal(18, 6)
  /// Additional UOM roles. Normally within the base unit's category (convert via
  /// UOM factors); cross-category needs a ProductUomConversion bridge. Null →
  /// falls back to the base `uomId`. salesUom = how the cashier sells (cup/glass),
  /// recipeUom = default recipe-line unit, productionUom = manufacturing unit.
  salesUomId                    String?
  recipeUomId                   String?
  productionUomId               String?
  /// Manufacturing classification (raw / semi_finished / finished). Nullable and
  /// ADVISORY ONLY — the engine never branches on it (the source of truth for
  /// "can this be produced" is an active Bom on this product). Drives UI pickers
  /// and excludes finished goods from purchase suggestions. Do NOT extend
  /// ProductType instead: retyping a product breaks the POS COGS path, which
  /// keys on productType ∈ {stockable, consumable}.
  manufacturingRole             ManufacturingRole?
  /// Sale rules enforced at POS. minSaleQty/maxSaleQty are in the sales unit.
  allowFractionalSale           Boolean            @default(true)
  minSaleQty                    Decimal?           @db.Decimal(20, 6)
  maxSaleQty                    Decimal?           @db.Decimal(20, 6)
  taxId                         String?
  salesPrice                    Decimal?           @db.Decimal(18, 6)
  costPrice                     Decimal?           @db.Decimal(18, 6)
  trackInventory                Boolean            @default(true)
  batchTracking                 Boolean            @default(false)
  /// When true, batches require an expiry date on receipt and FEFO picking is
  /// meaningful. Implies batchTracking (expiry is stored on InventoryBatch).
  expiryTracking                Boolean            @default(false)
  /// When true, each physical unit is tracked as an InventorySerial (captured on
  /// receipt, selected on issue). Enables SERIAL picking + SPECIFIC costing.
  serialTracking                Boolean            @default(false)
  /// Default strategy DeductStock/issue uses for batch/serial-tracked products
  /// when the transaction does not override it (dto.distStrategy).
  pickingStrategy               PickingStrategy    @default(FEFO)
  hasVariants                   Boolean            @default(false)
  // — Per-product inventory account overrides (optional; null = inherit) —
  incomeAccountOverrideId       String?
  expenseAccountOverrideId      String?
  inventoryAccountOverrideId    String?
  cogsAccountOverrideId         String?
  shrinkageAccountOverrideId    String?
  damageAccountOverrideId       String?
  expiryAccountOverrideId       String?
  varianceGainAccountOverrideId String?
  /// Reorder qty expressed in PURCHASE units (par-based reorder report).
  reorderQty                    Decimal            @default(0) @db.Decimal(20, 6)
  /// POS P5 / KDS: the KitchenStation.code the KDS should route tickets for
  /// this product to. Stored as the station's stable `code` string (not an
  /// enum) so each org can define its own stations (Coffee/Bakery/Grill/…).
  /// Defaults to "cafe" (a seeded default station) so legacy products route.
  station                       String             @default("cafe")
  minQuantity                   Decimal            @default(0) @db.Decimal(20, 6)
  /// Upper stock target (0 = none). Feeds the reorder report's suggested
  /// order-up-to quantity and over-stock alerts.
  maxQuantity                   Decimal            @default(0) @db.Decimal(20, 6)
  /// POS Phase P9: how the cashier flow handles an attempted sale that
  /// exceeds on-hand stock. Default 'silent' = current behaviour.
  stockPolicy                   PosStockPolicy     @default(silent)
  /// POS Phase P10: when true, the line's `unitPrice` is the GROSS amount
  /// (VAT included). The DocumentBuilderService splits it as
  ///   net = unitPrice / (1 + taxRate/100)
  ///   tax = unitPrice - net
  /// and the receipt prints "(incl. tax)" beside the line. The customer's
  /// menu still shows the same headline number; only the GL split changes.
  /// Default false (additive VAT) for backward compat.
  taxInclusive                  Boolean            @default(false)
  /// Beverage Control (bar alcohol) — how remaining stock is measured. Only
  /// `digital_weight` products appear in the bottle-weighing count. For live ml
  /// deduction the stock UoM should be ml and each drink's recipe
  /// (MenuProduct.quantity) is the pour in ml.
  measurementMethod             MeasurementMethod  @default(count)
  containerVolumeMl             Decimal?           @db.Decimal(20, 6)
  emptyBottleWeightG            Decimal?           @db.Decimal(20, 6)
  /// Optional measured tare override (glass weight varies bottle-to-bottle);
  /// used instead of the nominal emptyBottleWeightG when set.
  actualEmptyWeightG            Decimal?           @db.Decimal(20, 6)
  fullBottleWeightG             Decimal?           @db.Decimal(20, 6)
  /// Computed at setup = fullBottleWeightG - effectiveEmptyWeightG.
  liquidWeightG                 Decimal?           @db.Decimal(20, 6)
  /// Computed at setup = containerVolumeMl / liquidWeightG (ml per gram).
  conversionFactorMlPerG        Decimal?           @db.Decimal(20, 10)
  standardPourMl                Decimal?           @db.Decimal(20, 6)
  allowPartialBottle            Boolean            @default(true)
  /// Per-product variance tolerance in grams; falls back to the org default.
  varianceToleranceG            Decimal?           @db.Decimal(20, 6)
  // — Rental Management capability (orthogonal to productType — an item can be
  // sold, rented, or both). Checkout is an internal transfer, never an issue:
  // the shop still owns the asset, so no COGS and no inventory relief. —
  isRentable                    Boolean            @default(false)
  /// When true the product books against a quantity pool (chairs, plates,
  /// decor); when false each physical unit is a RentalUnit (garments, cameras).
  rentalIsPooled                Boolean            @default(false)
  rentalDepositAmount           Decimal?           @db.Decimal(20, 6)
  rentalReplacementCost         Decimal?           @db.Decimal(20, 6)
  rentalLateFeePerPeriod        Decimal?           @db.Decimal(20, 6)
  rentalDefaultPeriod           RentalRatePeriod?
  rentalMinPeriods              Int?
  rentalMaxPeriods              Int?
  /// Turnaround time between return and next availability (cleaning window).
  rentalBufferDays              Int                @default(0)
  rentalRequiresCleaning        Boolean            @default(false)
  isActive                      Boolean            @default(true)
  customFields                  Json               @default("{}")
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  createdBy                     String?
  updatedBy                     String?
  deletedAt                     DateTime?

  category               ProductCategory?        @relation(fields: [categoryId], references: [id])
  brand                  Brand?                  @relation(fields: [brandId], references: [id])
  supplier               Partner?                @relation("ProductSupplier", fields: [supplierId], references: [id])
  uom                    UnitOfMeasure?          @relation("ProductStockUom", fields: [uomId], references: [id])
  purchaseUom            UnitOfMeasure?          @relation("ProductPurchaseUom", fields: [purchaseUomId], references: [id])
  salesUom               UnitOfMeasure?          @relation("ProductSalesUom", fields: [salesUomId], references: [id])
  recipeUom              UnitOfMeasure?          @relation("ProductRecipeUom", fields: [recipeUomId], references: [id])
  productionUom          UnitOfMeasure?          @relation("ProductProductionUom", fields: [productionUomId], references: [id])
  packagings             ProductPackaging[]
  uomConversions         ProductUomConversion[]
  tax                    Tax?                    @relation(fields: [taxId], references: [id])
  variants               ProductVariant[]
  stockItems             StockItem[]
  stockBatches           InventoryBatch[]
  stockLedger            InventoryLedger[]
  stockSerials           InventorySerial[]
  modifierGroups         ProductModifierGroup[]
  comboItems             ComboItem[]
  menuProducts           MenuProduct[]
  rentalRates            RentalRate[]
  rentalUnits            RentalUnit[]
  rentalPackages         RentalPackage[]
  rentalPackageItems     RentalPackageItem[]
  rentalAgreementLines   RentalAgreementLine[]
  rentalReservationLines RentalReservationLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, brandId])
  @@index([organizationId, supplierId])
}

/// F.8 — Product brand (manufacturer / label). Optional master.
model Brand {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  logoUrl        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// F.8 — Product-level variant (size/colour/pack) carrying its own stock.
/// Distinct from MenuItemVariant (which is a menu-facing price override).
/// Non-variant products keep variantId = null on stock/batch/ledger rows.
model ProductVariant {
  id             String    @id @default(uuid())
  organizationId String
  productId      String
  sku            String?
  barcode        String?
  name           String // "Large", "300ml", "Red"
  attributes     Json      @default("{}")
  salesPrice     Decimal?  @db.Decimal(18, 6)
  costPrice      Decimal?  @db.Decimal(18, 6)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItems    StockItem[]
  stockBatches  InventoryBatch[]
  ledgerEntries InventoryLedger[]
  stockSerials  InventorySerial[]

  @@unique([organizationId, productId, name])
  @@index([organizationId])
  @@index([productId])
}

model ProductCategory {
  id                    String    @id @default(uuid())
  organizationId        String
  name                  String
  parentId              String?
  incomeAccountId       String?
  expenseAccountId      String?
  // — Inventory accounting defaults (M3: per-category posting rule overrides) —
  inventoryAccountId    String?
  cogsAccountId         String?
  shrinkageAccountId    String?
  damageAccountId       String?
  expiryAccountId       String?
  varianceGainAccountId String?
  promoExpenseAccountId String?
  internalUseAccountId  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("ProductCategoryTree")
  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// A group of units that convert into one another (Weight, Volume, Quantity…).
/// Conversion is only allowed WITHIN a category; `referenceUom` is the factor-1
/// unit every other member is expressed against.
model UomCategory {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// The reference (factor = 1) unit for this category.
  referenceUomId String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  units        UnitOfMeasure[] @relation("UomCategoryUnits")
  referenceUom UnitOfMeasure?  @relation("UomCategoryReference", fields: [referenceUomId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

model UnitOfMeasure {
  id                String    @id @default(uuid())
  organizationId    String
  code              String
  name              String
  /// Short display symbol (kg, g, L, pc). Optional.
  symbol            String?
  /// FK to the UOM category. Nullable during backfill; `category` (legacy free-text)
  /// is retained until every unit is migrated.
  categoryId        String?
  category          String    @default("unit")
  /// Base (reference) units per 1 of THIS unit. Reference unit = 1. e.g. with a
  /// gram reference: kg.factor = 1000. Convert: baseQty = qty * factor;
  /// convert(qty, from, to) = qty * from.factor / to.factor. Backfilled from `ratio`.
  factor            Decimal   @default(1) @db.Decimal(18, 6)
  /// Legacy conversion field (== factor); kept for backfill/back-compat.
  ratio             Decimal   @default(1) @db.Decimal(18, 6)
  /// Rounding step for quantities in this unit (1 = whole units, 0.001 = milli).
  roundingPrecision Decimal   @default(0.000001) @db.Decimal(18, 6)
  /// Informational: bigger | reference | smaller than the category reference.
  uomType           String    @default("reference")
  isBase            Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  categoryRef            UomCategory?           @relation("UomCategoryUnits", fields: [categoryId], references: [id])
  referenceForCategories UomCategory[]          @relation("UomCategoryReference")
  products               Product[]              @relation("ProductStockUom")
  purchaseProducts       Product[]              @relation("ProductPurchaseUom")
  salesProducts          Product[]              @relation("ProductSalesUom")
  recipeProducts         Product[]              @relation("ProductRecipeUom")
  productionProducts     Product[]              @relation("ProductProductionUom")
  uomConversionsFrom     ProductUomConversion[] @relation("UomConversionFrom")
  uomConversionsTo       ProductUomConversion[] @relation("UomConversionTo")
  menuLines              MenuProduct[]          @relation("MenuProductUom")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, categoryId])
}

/// A named pack of a product = a quantity of its BASE unit, optionally with its
/// own barcode (scan the case barcode → add `quantity` base units). Packaging is
/// separate from UOM: it does not participate in the category/factor engine.
model ProductPackaging {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  name           String
  /// How many BASE units one pack contains (e.g. Carton = 24).
  quantity       Decimal  @default(1) @db.Decimal(20, 6)
  barcode        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, barcode])
  @@index([organizationId, productId])
}

/// Optional per-product bridge for cross-category conversion (density): e.g. this
/// product converts 1 L (from) = 1.03 kg (to). `factor` = `to` units per 1 `from` unit.
model ProductUomConversion {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  fromUomId      String
  toUomId        String
  factor         Decimal  @db.Decimal(20, 10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUom UnitOfMeasure @relation("UomConversionFrom", fields: [fromUomId], references: [id])
  toUom   UnitOfMeasure @relation("UomConversionTo", fields: [toUomId], references: [id])

  @@unique([organizationId, productId, fromUomId, toUomId])
  @@index([organizationId, productId])
}

model Tax {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  code           String?
  type           TaxType   @default(vat)
  rate           Decimal   @default(0) @db.Decimal(9, 6)
  isInclusive    Boolean   @default(false)
  isCompound     Boolean   @default(false)
  /// VAT-return classification, distinct from `rate = 0` ambiguity:
  /// standard | zero_rated | exempt | out_of_scope. Lets returns separate
  /// zero-rated (taxable at 0%, input recoverable) from exempt (not taxable).
  vatCategory    String    @default("standard")
  accountId      String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FiscalPeriod {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         FiscalPeriodStatus @default(open)
  /// D2-2: timestamp set by PeriodCloseService.close().
  closedAt       DateTime?
  /// User who closed the period.
  closedBy       String?
  /// D2-2: timestamp set by PeriodCloseService.lock(). After this point
  /// PostingService.assertOpen rejects any date in the period.
  lockedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Master list of cost / profit centers for financial dimension filtering.
/// The `costCenterId` on journal lines / transactions is a free-text reference
/// to this table (no FK constraint, so existing data is never orphaned).
model CostCenter {
  id             String    @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           String    @default("cost") /// "cost" | "profit"
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model Branch {
  id             String    @id @default(uuid())
  organizationId String
  code           String
  name           String
  timezone       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  purchaseOrders   PurchaseOrder[]    @relation("PurchaseOrder_branch")
  purchaseRequests PurchaseRequest[]  @relation("PurchaseRequest_branch")
  goodsReceipts    GoodsReceiptNote[] @relation("GoodsReceipt_branch")
  tasks            Task[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// =============================================================================
// Phase 2 — General Ledger engine
// =============================================================================

/// Top-level accounting nature of an account. Drives the BS-vs-P&L split.
enum AccountClassification {
  asset
  liability
  equity
  revenue
  expense
  off_balance
}

enum NormalBalance {
  debit
  credit
}

enum CashFlowClass {
  operating
  investing
  financing
  none
}

/// Statement line-group. Single source of truth for financial report layout.
enum ReportSection {
  current_assets
  non_current_assets
  current_liabilities
  long_term_liabilities
  equity
  revenue
  contra_revenue
  cogs
  operating_expense
  other_income
  other_expense
  off_balance
}

/// Accounting *behavior* of an account — how the engine treats it, and which
/// module may auto-discover it. Global (system-wide) — seeded with canonical
/// `key`s (`isSystem`), shared by every tenant.
///
/// Deliberately distinct from the `Account.parentAccountId` tree, which exists
/// purely for reporting and navigation. Modules resolve accounts by category
/// `key` (or an AccountMapping key) — never by account name, code range, or
/// position in the hierarchy.
model AccountCategory {
  id          String  @id @default(uuid())
  key         String
  name        String
  description String?

  classification AccountClassification
  normalBalance  NormalBalance
  reportSection  ReportSection
  /// Cash-flow statement classification. Reporting default — the engine resolves
  /// `isCashEquivalent` to pick payment and cash accounts; this field only sets
  /// which section (operating / investing / financing) the balance falls under.
  cashFlowClass  CashFlowClass         @default(operating)

  /// Contra accounts carry the opposite normal balance of their classification.
  isContra         Boolean @default(false)
  /// Counts toward cash & cash equivalents (cash-flow statement, treasury).
  isCashEquivalent Boolean @default(false)

  /// Behavior defaults. Each is overridable per account via a nullable column.
  allowReconciliation Boolean @default(false)
  allowManualPosting  Boolean @default(true)
  allowBudgeting      Boolean @default(false)

  /// Categories are system-managed: there is no tenant CRUD. They are created
  /// and upgraded solely by the boot seeder from ACCOUNT_CATEGORY_SEED.
  isSystem  Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// Version of this category's accounting contract. The boot seeder only
  /// rewrites a row when the shipped template declares a higher version, which
  /// makes upgrades deterministic and re-runnable.
  systemVersion Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  accounts Account[]

  @@unique([key])
  @@index([classification])
}

/// Subledger control account type. `null` = not a control account.
enum ControlAccountType {
  ar
  ap
  inventory
  fixed_assets
  payroll
  tax
}

enum JournalType {
  general
  sales
  purchase
  cash
  bank
  adjustment
  opening
  closing
}

enum JournalEntryStatus {
  draft
  posted
  reversed
}

/// Chart of accounts. `isPostable` accounts accept journal postings; summary
/// nodes (headers) set this to `false`.
model Account {
  id             String @id @default(uuid())
  organizationId String
  code           String
  name           String

  /// Accounting behavior. Source of truth — every module resolves against this.
  categoryId    String?
  /// Denormalized from the category. Service-maintained, never client-writable;
  /// reports and raw SQL need it per row without a join.
  normalBalance NormalBalance @default(debit)

  /// Reporting / navigation hierarchy ONLY. Nothing in posting or account
  /// determination traverses this tree.
  parentAccountId String?
  sortOrder       Int     @default(0)

  currencyId  String?
  isPostable  Boolean @default(true)
  isActive    Boolean @default(true)
  description String?

  /// Per-account behavior overrides. `null` = inherit the category default.
  allowReconciliation Boolean?
  allowManualPosting  Boolean?
  allowBudgeting      Boolean?
  /// Per-account report-section override. `null` = inherit `category.reportSection`.
  reportSection       ReportSection?

  /// Subledger control account type. `null` = not a control account.
  /// Replaces the former `isControlAccount` boolean.
  controlAccountType ControlAccountType?
  /// Soft-retire: hidden from pickers and blocks NEW postings, history preserved.
  deprecatedAt       DateTime?
  /// Per-account cash-flow override. `null` = inherit `category.cashFlowClass`.
  cashFlowCategory   String?
  /// Payment account fields — bank/provider name and account/phone number.
  bankName           String?
  accountNumber      String?
  /// Marks this as the default account for its type (used in POS tender selection).
  isDefault          Boolean             @default(false)
  /// System accounts are created by the seed / posting engine (Retained Earnings,
  /// Rounding, control accounts). They cannot be deleted. `isProtected` additionally
  /// blocks deletion of accounts wired into an AccountMapping.
  isSystem           Boolean             @default(false)
  isProtected        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  category      AccountCategory? @relation(fields: [categoryId], references: [id])
  parent        Account?         @relation("AccountTree", fields: [parentAccountId], references: [id])
  children      Account[]        @relation("AccountTree")
  journalLines  JournalLine[]
  documentLines DocumentLine[]
  mappings      AccountMapping[]
  bankAccount   BankAccount?     @relation("Account_bankAccount")
  cashRegisters CashRegister[]   @relation("CashRegisterDefaultAccount")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@index([organizationId, parentAccountId])
}

model Journal {
  id                     String      @id @default(uuid())
  organizationId         String
  code                   String
  name                   String
  journalType            JournalType @default(general)
  defaultDebitAccountId  String?
  defaultCreditAccountId String?
  sequencePrefix         String?
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  createdBy              String?
  updatedBy              String?
  deletedAt              DateTime?

  entries JournalEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Immutable once posted. Corrections are made via reversing entries (ADR-009).
model JournalEntry {
  id              String             @id @default(uuid())
  organizationId  String
  journalId       String
  entryNumber     String
  postingDate     DateTime
  description     String?
  status          JournalEntryStatus @default(draft)
  currencyId      String?
  sourceType      String?
  sourceId        String?
  /// Classifies the posting for the source document: "primary" (the original
  /// posting), "reversal", "partial_refund", etc. Descriptive; drives the
  /// posting monitor and lets one source have several legitimate postings.
  postingType     String             @default("primary")
  /// GL-layer idempotency token. When set, PostingService replays the existing
  /// entry instead of writing a duplicate journal (defence-in-depth beyond the
  /// HTTP Idempotency-Key). Left NULL for postings that are legitimately
  /// repeatable for one source (e.g. successive partial refunds) — NULLs are
  /// distinct in Postgres so they never collide on the unique index below.
  postingKey      String?
  /// Reporting dimensions (multi-branch / cost-center accounting). Optional so
  /// single-outlet orgs are unaffected; set by the posting caller.
  branchId        String?
  costCenterId    String?
  reversedEntryId String? // the reversal entry that voids this one
  reversalOfId    String? // set when this entry IS a reversal of another
  /// Phase 3 — extensible financial dimensions (generic segmentation without a
  /// column per dimension): e.g. { cashierId, cashSessionId, registerId, campus,
  /// term, department, project }. Branch/costCenter stay typed columns; this bag
  /// carries the rest. Copied to each line (line-level overrides win).
  dimensions      Json?
  postedAt        DateTime?
  postedBy        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       String?

  journal Journal       @relation(fields: [journalId], references: [id])
  lines   JournalLine[]

  @@unique([organizationId, entryNumber])
  @@unique([organizationId, postingKey])
  @@index([organizationId])
  @@index([organizationId, postingDate])
  @@index([organizationId, branchId, postingDate])
  @@index([sourceType, sourceId])
  @@index([organizationId, postingType])
}

model JournalLine {
  id             String   @id @default(uuid())
  organizationId String
  journalEntryId String
  accountId      String
  partnerId      String?
  description    String?
  debit          Decimal  @default(0) @db.Decimal(20, 6)
  credit         Decimal  @default(0) @db.Decimal(20, 6)
  currencyId     String?
  exchangeRate   Decimal  @default(1) @db.Decimal(18, 8)
  baseDebit      Decimal  @default(0) @db.Decimal(20, 6)
  baseCredit     Decimal  @default(0) @db.Decimal(20, 6)
  lineNumber     Int      @default(0)
  /// Reporting dimensions inherited from the entry (or overridden per line).
  branchId       String?
  costCenterId   String?
  /// Phase 3 — extensible financial dimensions (see JournalEntry.dimensions).
  /// Inherited from the entry unless the line supplies its own.
  dimensions     Json?
  createdAt      DateTime @default(now())

  entry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([organizationId])
  @@index([journalEntryId])
  @@index([organizationId, accountId])
  @@index([organizationId, branchId])
}

/// Org-level account determination defaults (key -> account). See ADR-009.
model AccountMapping {
  id             String    @id @default(uuid())
  organizationId String
  key            String
  accountId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  account Account @relation(fields: [accountId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, accountId])
}

/// Removed in D1-1 — replaced by Postgres-native SEQUENCE objects.
/// Sequence numbers are now generated via `SELECT nextval('seq_<orgId>_<key>')`
/// inside the active transaction (see kernel/sequence/sequence.service.ts).
/// This eliminates the row-level upsert race that could crash concurrent first-time
/// callers and removes the hot-row bottleneck under load.

model BankAccount {
  id             String    @id @default(uuid())
  organizationId String
  accountId      String    @unique
  name           String
  bankName       String?
  accountNumber  String?
  currencyId     String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  /// Back-reference for `Account.bankAccount`.
  account Account? @relation("Account_bankAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

// =============================================================================
// Phase 3 — Document framework + Accounts Receivable
// =============================================================================

enum DocumentType {
  sales_invoice
  credit_note
  vendor_bill
  debit_note
  proforma_invoice
}

enum DocumentStatus {
  draft
  submitted
  approved
  rejected
  confirmed
  posted
  paid
  issued
  active
  expired
  terminated
  revoked
  cancelled
  closed
  archived
}

enum PaymentStatus {
  not_paid
  partial
  paid
  overpaid
}

enum PaymentDirection {
  inbound
  outbound
}

/// Universal financial document. POS/School/Hotel etc. create these; the
/// accounting engine posts them. Residual lives here (NOT a separate ledger).
model Document {
  id                   String                  @id @default(uuid())
  organizationId       String
  documentNumber       String
  /// Legacy enum mirror (ADR-014): retained until consumers migrate; the DMS
  /// registry (DocumentTypeDef) is the source of truth for what a document is.
  documentType         DocumentType            @default(sales_invoice)
  /// Registry FK — the source of truth (ADR O4, one-shot migration).
  documentTypeId       String
  partnerId            String
  currencyId           String?
  exchangeRate         Decimal                 @default(1) @db.Decimal(18, 8)
  issueDate            DateTime
  dueDate              DateTime?
  /// Payment term selected at sale time (loose ref to core PaymentTerm master).
  paymentTermId        String?
  /// Snapshot of the term name so invoice history survives a later rename/archive.
  paymentTermName      String?
  /// Fiscal position (loose ref to core FiscalPosition master) + name snapshot.
  fiscalPositionId     String?
  fiscalPositionName   String?
  /// Invoicing journal chosen at sale time (loose ref to Journal master) + snapshot.
  invoicingJournalId   String?
  invoicingJournalName String?
  /// Salesperson on the sale (loose ref to HrEmployee) + name snapshot.
  salespersonId        String?
  salespersonName      String?
  /// Delivery intent (Odoo Other Info): expected delivery date, delivery
  /// address snapshot, Incoterm + location.
  deliveryDate         DateTime?
  deliveryAddress      String?
  incoterm             String?
  incotermLocation     String?
  /// Source document reference (SO/PO/quotation number) typed by the user.
  sourceDocument       String?
  status               DocumentStatus          @default(draft)
  reference            String?
  notes                String?
  /// §5.3 document-owned content (terms/clauses/conditions) — amend-only,
  /// never domain fields.
  data                 Json                    @default("{}")
  subtotal             Decimal                 @default(0) @db.Decimal(20, 6)
  discountTotal        Decimal                 @default(0) @db.Decimal(20, 6)
  taxAmount            Decimal                 @default(0) @db.Decimal(20, 6)
  totalAmount          Decimal                 @default(0) @db.Decimal(20, 6)
  amountPaid           Decimal                 @default(0) @db.Decimal(20, 6)
  amountResidual       Decimal                 @default(0) @db.Decimal(20, 6)
  /// Cumulative amount FORGIVEN on this document (waivers, bad-debt write-offs).
  /// Distinct from `amountPaid`, which is realized payment consideration only.
  /// Booking a waiver as payment (the P0-3 defect) made every "collections"
  /// figure overstate actual money received. FINANCIAL_INVARIANTS §Document.
  amountWaived         Decimal                 @default(0) @db.Decimal(20, 6)
  paymentStatus        PaymentStatus           @default(not_paid)
  /// POS Order→Invoice split: how this invoice is/was settled. NULL until a
  /// bill is generated. `credit` = postpaid house account (AR), settled later.
  paymentMode          InvoicePaymentMode?
  /// POS Order→Invoice split: settlement lifecycle independent of paymentStatus.
  /// For cash/card it tracks the balance; for `credit` it is driven by AR.
  settlementStatus     InvoiceSettlementStatus @default(unsettled)
  journalEntryId       String?
  reversedDocumentId   String? // credit note -> original invoice
  /// Phase F: the branch this document was created from. Used by
  /// branch-scoped reports + permissions. Optional for backward compat.
  branchId             String?
  sourceType           String?
  sourceId             String?
  /// POS Tables (Phase T1): legacy denormalised cache of which table a Document
  /// sale belonged to. POS tabs now live on `Order` (see `PosTableOrder.orderId`
  /// + `Order.tableId`); this column is retained only for historical Document rows.
  tableId              String?
  postedAt             DateTime?
  postedBy             String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  createdBy            String?
  updatedBy            String?
  /// Optimistic lock (G7): every lifecycle mutation bumps version
  /// (UPDATE ... WHERE version = N; mismatch -> 409).
  version              Int                     @default(1)

  /// Print lifecycle (Phase T5)
  billPrintCount       Int       @default(0)
  billLastPrintedAt    DateTime?
  receiptPrintCount    Int       @default(0)
  receiptLastPrintedAt DateTime?
  lastPrintedById      String?
  kotPrintCount        Int       @default(0)

  partner         Partner             @relation(fields: [partnerId], references: [id])
  documentTypeDef DocumentTypeDef     @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  lines           DocumentLine[]
  printLogs       DocumentPrintLog[]
  allocations     PaymentAllocation[]
  actions         DocumentAction[]

  /// Phase 4/5 — snapshots, relations, sources, amendments, attachments.
  snapshots    DocumentSnapshot[]
  sources      DocumentSource[]
  versions     DocumentVersion[]
  attachments  DocumentAttachment[]
  relationsOut DocumentRelation[]   @relation("RelationFrom")
  relationsIn  DocumentRelation[]   @relation("RelationTo")

  // School vertical (P0.2): a fee invoice can be the source of a late-payment
  // penalty, and the penalty itself is issued as its own Document.
  penaltyAsSource PenaltyAssessment[] @relation("PenaltySource")
  penaltyDocument PenaltyAssessment?  @relation("PenaltyDocument")

  @@unique([organizationId, documentNumber])
  @@index([organizationId])
  @@index([organizationId, partnerId])
  @@index([organizationId, documentType, status])
  @@index([organizationId, documentTypeId, status])
  @@index([organizationId, branchId])
  @@index([organizationId, tableId])
}

model DocumentLine {
  id              String  @id @default(uuid())
  organizationId  String
  documentId      String
  productId       String?
  /// Menu-based sale: the sellable MenuItem this line represents (its recipe is
  /// what decremented stock). Null for legacy product / non-menu lines.
  menuItemId      String?
  accountId       String?
  description     String
  quantity        Decimal @default(1) @db.Decimal(20, 6)
  unitPrice       Decimal @default(0) @db.Decimal(20, 6)
  discountPercent Decimal @default(0) @db.Decimal(9, 4)
  taxId           String?
  subtotal        Decimal @default(0) @db.Decimal(20, 6)
  taxAmount       Decimal @default(0) @db.Decimal(20, 6)
  total           Decimal @default(0) @db.Decimal(20, 6)
  lineNumber      Int     @default(0)
  /// Odoo-style line types: 'product' (itemized) | 'section' | 'note' (display-only).
  lineType        String  @default("product")
  /// POS P10 — the line's price was tax-inclusive at invoice time, so receipts
  /// and reports can render "(incl. tax)" without re-deriving it. Persisted by
  /// DocumentBuilderService (migration 20260627000100_pos_p10_doc_line_tax_inclusive).
  taxInclusive    Boolean @default(false)

  document  Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  account   Account?               @relation(fields: [accountId], references: [id])
  modifiers DocumentLineModifier[]
  printLogs DocumentPrintLog[]

  /// Print lifecycle (Phase T5)
  kitchenPrintCount      Int       @default(0)
  kitchenLastPrintedAt   DateTime?
  /// Quantity that was last sent to kitchen (for delta tracking).
  kitchenPrintedQty      Decimal?  @db.Decimal(20, 6)
  cancelPrintCount       Int       @default(0)
  cancelLastPrintedAt    DateTime?
  lastKitchenPrintedById String?
  /// Timestamp when this line was last included on a printed bill.
  billPrintedAt          DateTime?

  @@index([organizationId])
  @@index([documentId])
  @@index([menuItemId])
}

/// Print event log for the document lifecycle (KOT, BILL, RECEIPT, CANCEL).
/// Each row is one print or reprint action. Derive current status from the
/// latest log per (documentLineId, type) plus the counter on the line/doc.
model DocumentPrintLog {
  id             String   @id @default(uuid())
  organizationId String
  /// One of documentId / invoiceId is set (R2: POS prints reference the
  /// separate Invoice; legacy/manual prints reference the generic Document).
  documentId     String?
  invoiceId      String?
  /// Null when the print is at document level (bill, receipt).
  documentLineId String?
  /// KOT | BILL | RECEIPT | CANCEL
  type           String
  /// PRINT | REPRINT
  action         String   @default("PRINT")
  copies         Int      @default(1)
  printedById    String?
  /// Required for REPRINT actions.
  reason         String?
  /// Printer host:port or station name at time of print.
  printer        String?
  /// Unique key — prevents duplicate print jobs on retry.
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  document     Document?     @relation(fields: [documentId], references: [id])
  documentLine DocumentLine? @relation(fields: [documentLineId], references: [id])

  @@index([organizationId])
  @@index([documentId])
  @@index([invoiceId])
  @@index([documentLineId])
  @@index([type])
  @@index([idempotencyKey])
}

// =============================================================================
// DMS — Generic Document Management System (Phase 1: registry)
// See docs/architecture/dms-architecture.md. Registry tables are GLOBAL
// (no organizationId); per-org behaviour rides on OrganizationDocumentType.
// =============================================================================

/// Global registry root: one row per document type. Adding a document type is
/// a seed row here (+ templates) — zero core-engine code (guardrail G2).
model DocumentTypeDef {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  /// pos | retail | rental | school | finance | procurement | custom
  category    String  @default("custom")
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  /// SequenceService key + prefix + padding for numbering (C: configuration).
  numberingKey     String?
  numberingPrefix  String?
  numberingPadding Int     @default(6)

  lifecycleId        String?
  /// Policy JSON — classification (C)onfig / (P)olicy / (R)eference ONLY,
  /// never business logic (docs/architecture/dms-architecture.md §2.1).
  approvalPolicy     Json?
  postingPolicy      Json?
  paymentPolicy      Json?
  cancellationPolicy Json?
  /// EDITABLE | VERSIONED | IMMUTABLE_AFTER_ISSUE (R).
  editPolicy         String  @default("EDITABLE")
  snapshotPolicy     Json?
  printProfile       Json?
  businessEffects    Json?
  /// { basePermission: "document", visibility: "org" | "branch" | "doc", ... }
  security           Json?

  isFinancial         Boolean @default(false)
  isInventoryRelevant Boolean @default(false)
  requiresPosting     Boolean @default(false)

  lifecycle  DocumentLifecycle?         @relation(fields: [lifecycleId], references: [id], onDelete: Restrict)
  documents  Document[]
  orgConfigs OrganizationDocumentType[]
  templates  TemplateDefinition[]
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
}

/// Per-org activation/config override (ADR O2). Absent row => type active
/// with global defaults; isActive=false hides the type for that org.
model OrganizationDocumentType {
  id              String   @id @default(uuid())
  organizationId  String
  documentTypeId  String
  isActive        Boolean  @default(true)
  configOverrides Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documentType DocumentTypeDef @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, documentTypeId])
  @@index([organizationId])
}

/// Lifecycle definition: the state subset (of the superset DocumentStatus
/// enum) a family of types may occupy. States validated at seed time.
model DocumentLifecycle {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  /// Subset of DocumentStatus values (validated at seed time).
  states       String[]
  initialState String
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  types       DocumentTypeDef[]
  transitions DocumentTransition[]
}

/// One allowed transition. guardJson is a FIXED declarative vocabulary, never
/// code (G4): permission (R), requiresApproval (P), requiresReason (P),
/// requiresPaid (P), requiresSnapshot (P), allowsAnyState (P).
model DocumentTransition {
  id          String  @id @default(uuid())
  lifecycleId String
  fromState   String
  toState     String
  /// submit | approve | reject | confirm | issue | activate | expire | revoke |
  /// post | pay | close | cancel | reverse | terminate | archive
  action      String
  guardJson   Json?
  isSystem    Boolean @default(false)

  lifecycle DocumentLifecycle @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)

  @@unique([lifecycleId, fromState, action])
  @@index([lifecycleId])
}

/// Relation semantics registry (rev 4 review): direction, allowed category
/// pairs, cardinality, implicit inverse, duplicate policy — validated at
/// relation creation time (Phase 5).
model DocumentRelationType {
  id                      String   @id @default(uuid())
  code                    String   @unique
  name                    String
  description             String?
  /// out | both
  direction               String   @default("out")
  /// [] = any category
  allowedSourceCategories String[]
  allowedTargetCategories String[]
  /// one | many (per source document)
  cardinality             String   @default("many")
  inverseImplicit         Boolean  @default(false)
  duplicatesAllowed       Boolean  @default(false)
  isSystem                Boolean  @default(false)

  relations DocumentRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Phase 8 — Workflow hook ledger. Each DMS domain event handler writes an
/// idempotent row so downstream POS hooks (inventory, billing, ledger) can be
/// re-played without double effects. Per-org scoped (RLS tenant_isolation).
model DMSWorkflowLedger {
  id               String   @id @default(uuid())
  organizationId   String
  documentId       String
  documentTypeCode String
  action           String
  payload          Json     @default("{}")
  createdAt        DateTime @default(now())

  @@unique([documentId, action])
  @@index([organizationId])
  @@index([documentTypeCode, action])
}

/// Command idempotency log (G6): every lifecycle action writes a row keyed on
/// (documentId, action, idempotencyKey). A retry with the same key replays the
/// original result instead of re-executing side effects.
model DocumentAction {
  id             String   @id @default(uuid())
  organizationId String
  documentId     String
  action         String
  idempotencyKey String
  requestedById  String?
  /// completed | duplicate | failed
  status         String   @default("completed")
  result         Json?
  error          String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentId, action, idempotencyKey])
  @@index([documentId, action])
}

// =============================================================================
// Phase 4/5 — snapshots, templates (rendering), relations, sources, versions,
// attachments. See docs/architecture/dms-architecture.md §3.5/§3.7.
// =============================================================================

/// Template for rendering a document type (Phase 4). GLOBAL registry row —
/// per-org overrides arrive via OrganizationDocumentType.configOverrides.
model TemplateDefinition {
  id             String   @id @default(uuid())
  templateKey    String
  documentTypeId String
  /// a4 | thermal | email | html | plain
  format         String
  /// puppeteer | escpos | handlebars | plain
  engine         String   @default("plain")
  version        Int      @default(1)
  name           String
  /// HTML/CSS (a4/html) | ESC/POS template (thermal) | plain text; {{placeholders}}.
  content        String
  headerFooter   Json     @default("{}")
  isActive       Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documentType DocumentTypeDef @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([templateKey, version])
  @@index([documentTypeId])
  @@index([templateKey, format])
}

/// Immutable historical representation of what a document SAID at a point in
/// time (§3.7) — assembled from Document + DocumentLine + template only, never
/// domain tables. seal = sha256(data JSON + templateVersionId) — a doc whose
/// domain state changed later still renders byte-identically from the seal.
model DocumentSnapshot {
  id                String   @id @default(uuid())
  organizationId    String
  documentId        String
  /// Document status at capture time.
  state             String
  /// Document-owned representation (header + lines + totals).
  data              Json
  templateVersionId String?
  /// File role GENERATED_OUTPUT — only when keepRenderedFile / snapshotOnPrint.
  renderedFileId    String?
  /// sha256(data + templateVersionId) — reproducibility check.
  seal              String?
  /// issue | post | amend | print | reverse
  reason            String   @default("post")
  generatedAt       DateTime @default(now())
  createdById       String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId, generatedAt])
}

/// Typed relation between two documents, validated against DocumentRelationType
/// semantics (§3.3): direction, allowed categories, cardinality, implicit
/// inverse, duplicates. reversedDocumentId stays operational and mirrors
/// CANCELS (the reversal engine writes both).
model DocumentRelation {
  id             String   @id @default(uuid())
  organizationId String
  fromDocumentId String
  toDocumentId   String
  relationTypeId String
  payload        Json     @default("{}")
  createdById    String?
  createdAt      DateTime @default(now())

  fromDocument Document             @relation("RelationFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument   Document             @relation("RelationTo", fields: [toDocumentId], references: [id], onDelete: Cascade)
  relationType DocumentRelationType @relation(fields: [relationTypeId], references: [id], onDelete: Restrict)

  @@unique([fromDocumentId, toDocumentId, relationTypeId])
  @@index([organizationId])
  @@index([fromDocumentId])
  @@index([toDocumentId])
  @@index([relationTypeId])
}

/// External source that produced a document (RentalAgreement, Order, Student,
/// …). per-sourceType validators are registered by the owning domain module
/// (ownership principle, §5.1) — the DMS never validates domain rules.
model DocumentSource {
  id             String   @id @default(uuid())
  organizationId String
  documentId     String
  sourceType     String
  sourceId       String
  /// primary | related
  relationship   String   @default("primary")
  createdById    String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sourceType, sourceId])
  @@index([organizationId])
  @@index([sourceType, sourceId])
}

/// Amendment history for VERSIONED types only (§5.3). data is restricted to
/// document-owned content (terms, notes, clauses, conditions) — financial docs
/// are never versioned (reversal instead). versionNo mirrors the document's
/// optimistic-lock version at write time.
model DocumentVersion {
  id             String   @id @default(uuid())
  organizationId String
  documentId     String
  versionNo      Int
  /// DOCUMENT-OWNED content only (§3.7) — reviewed on every version write.
  data           Json
  changeNote     String?
  changedById    String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@index([organizationId])
  @@index([documentId])
}

/// File link with a role: ATTACHMENT (user upload) | GENERATED_OUTPUT
/// (engine-rendered) | SIGNED_COPY (signature capture) | SOURCE_FILE (origin).
/// Storage stays in File (G3 — no second storage system).
model DocumentAttachment {
  id             String   @id @default(uuid())
  organizationId String
  documentId     String
  fileId         String
  /// ATTACHMENT | GENERATED_OUTPUT | SIGNED_COPY | SOURCE_FILE
  role           String   @default("ATTACHMENT")
  kind           String?
  version        Int      @default(1)
  metadata       Json     @default("{}")
  createdById    String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  file     File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId, role])
  @@index([fileId])
}

/// M-D — structured per-line modifier/add-on selections (the order_item_modifiers
/// equivalent). Each selected modifier persists as a queryable row so modifier
/// sales can be reported, independent of the price already folded into
/// DocumentLine.unitPrice.
model DocumentLineModifier {
  id               String   @id @default(uuid())
  organizationId   String
  documentLineId   String
  /// Source Modifier id when known (null if the catalogue row was later removed).
  modifierId       String?
  name             String
  /// Kitchen-print text snapshot. Falls back to `name` when null.
  kitchenPrintName String?
  priceDelta       Decimal  @default(0) @db.Decimal(20, 6)
  createdAt        DateTime @default(now())

  documentLine DocumentLine @relation(fields: [documentLineId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentLineId])
  @@index([modifierId])
}

// ============================================================================
// POS Phase A additions (sell loop): held orders / open tabs.
//
// A PosHold is a lightweight, parking-spot snapshot of a cart. The cashier
// builds lines, taps "Hold", and the cart is parked under a friendly name
// (e.g. "Sarah / table 3") until it's recalled and tendered. At recall time
// the POS vertical materialises the hold into a real `Document` (sales_invoice)
// + `Payment` through the existing `DocumentBuilderService` — no new money
// primitives are introduced.
//
// Lives next to `Document`/`DocumentLine` because that's the conceptual
// neighbourhood; not soft-deleted (status='open'|'recalled'|'cancelled' is the
// source of truth).
// ============================================================================

/// How a stockable product's POS behaves when the cart requests more units
/// than the warehouse has on hand. Read at checkout time by PosService.
///   block  — refuse the sale; the cashier must reduce the qty or re-stock.
///   warn   — allow the sale, but the response carries a low-stock warning
///            that the UI shows as a toast (Phase P9).
///   silent — allow the sale; the shortage is recorded in the inventory
///            dashboard and fixed up later (default for backward compat).
enum PosStockPolicy {
  block
  warn
  silent
}

enum PosHoldStatus {
  open
  recalled
  cancelled
}

model PosHold {
  id             String        @id @default(uuid())
  organizationId String
  /// Friendly name the cashier sees in the Open Tickets rail
  /// (e.g. "Sarah / table 3", "Order #14"). Not the same as a customer record.
  name           String
  /// Optional customer reference. If null we use the WALKIN partner at recall.
  partnerId      String?
  /// Optional branch and active cash session context, so we can filter "open
  /// holds on this register" quickly and stamp the recalled sale correctly.
  branchId       String?
  cashSessionId  String?
  /// Total pre-tax at park time. We recompute on recall because lines can be
  /// edited; the snapshot is for the rail's price preview.
  totalAmount    Decimal       @default(0) @db.Decimal(20, 6)
  status         PosHoldStatus @default(open)
  /// Free-form notes (e.g. "called away, will return").
  notes          String?
  heldById       String?
  recalledById   String?
  recalledAt     DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines PosHoldLine[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, cashSessionId, status])
  @@index([organizationId, branchId, status])
}

model PosHoldLine {
  id              String  @id @default(uuid())
  organizationId  String
  holdId          String
  productId       String?
  description     String
  quantity        Decimal @default(1) @db.Decimal(20, 6)
  unitPrice       Decimal @default(0) @db.Decimal(20, 6)
  discountPercent Decimal @default(0) @db.Decimal(9, 4)
  taxId           String?
  lineNumber      Int     @default(0)
  /// Free-form note for kitchen/bar ("no sugar", "extra hot")
  note            String?

  hold PosHold @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([holdId])
}

// ============================================================================
// POS Phase D additions: Modifiers + Combos (P4) and KDS station routing (P5).
//
// Modifiers are add-ons for products (e.g. "Oat milk +UGX 700" on a latte).
// Combos are fixed meal deals (e.g. "Breakfast = Croissant + Latte for UGX 18k")
// that expand into their component lines on the receipt so inventory decrements
// per-component.
// ============================================================================

/// NOTE: the former `PosStation` enum (bar/kitchen/cafe) was retired in favour
/// of the configurable `KitchenStation` table (see below). A product's station
/// is now stored as the station's `code` string, so an org can define any set
/// of stations (Coffee, Bakery, Grill, Pizza, Dessert, …). The three original
/// values are seeded as default KitchenStation rows so nothing breaks.

model ModifierGroup {
  id             String            @id @default(uuid())
  organizationId String
  /// Display label, e.g. "Milk options", "Size", "Extras".
  name           String
  /// Optional category for grouping modifiers in the admin UI, e.g. "Prep", "Milk", "Size".
  category       String?
  /// Description shown in the modifier picker tooltip.
  description    String?
  /// Hex colour for the admin UI badge, e.g. "#4f46e5".
  color          String?
  /// Icon name/identifier for the admin UI.
  icon           String?
  /// ADD_ON = paid extras prominently shown as "What extra is added?"
  /// MODIFIER = preparation instructions shown as "How is it prepared?"
  groupType      ModifierGroupType @default(ADD_ON)
  /// Customer must select at least this many modifiers. 0 = optional.
  minSelect      Int               @default(0)
  /// Max selections. 1 = radio, 2+ = checkbox.
  maxSelect      Int               @default(1)
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  version        Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  modifiers Modifier[]
  products  ProductModifierGroup[]
  menuItems MenuItemModifierGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Modifier {
  id               String    @id @default(uuid())
  organizationId   String
  groupId          String
  /// e.g. "Oat milk", "Extra shot", "Large".
  name             String
  /// Text printed on kitchen tickets. Falls back to `name` when null.
  kitchenPrintName String?
  /// Description shown in the modifier picker tooltip.
  description      String?
  /// Signed UGX added to the line price when this modifier is selected.
  /// Negative for "discount" modifiers (e.g. "No syrup" = -500).
  priceDelta       Decimal   @default(0) @db.Decimal(20, 6)
  /// Optional: links this modifier to a Product so selecting it depletes stock
  /// (mirrors AccompanimentOption.inventoryItemId). Best-effort at sale time.
  inventoryItemId  String?
  isDefault        Boolean   @default(false)
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([groupId])
  @@index([organizationId, deletedAt])
}

/// M-N: which modifier groups are available on a product. `sortOrder`
/// controls the order the cashier sees them in the AddOns dialog.
model ProductModifierGroup {
  id              String    @id @default(uuid())
  organizationId  String
  productId       String
  modifierGroupId String
  sortOrder       Int       @default(0)
  deletedAt       DateTime?

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

/// A combo meal: a fixed set of products sold together for one price.
/// When the cashier sells a combo, pos.checkout expands it into one
/// DocumentLine per ComboItem so inventory still decrements per-component
/// (and the receipt shows every line item clearly).
model Combo {
  id             String   @id @default(uuid())
  organizationId String
  /// Display name, e.g. "Breakfast Deal", "Lunch Combo".
  name           String
  /// Fixed combo price in UGX.
  price          Decimal  @db.Decimal(20, 6)
  /// Optional short description shown on the menu card and receipt.
  description    String?
  isActive       Boolean  @default(true)
  /// Optional product image for the menu card.
  imageUrl       String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ComboItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ComboItem {
  id             String @id @default(uuid())
  organizationId String
  comboId        String
  productId      String
  /// How many units of this product the combo includes (e.g. 1 croissant + 1 latte).
  quantity       Int    @default(1)

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([comboId, productId])
  @@index([organizationId])
  @@index([comboId])
}

// ============================================================================
// POS — Menu Management (per spec section #1).
//
// The spec distinguishes two concepts the existing schema collapsed into
// `Product`:
//   - Product    = master data (what's in inventory, costs, stockable).
//   - MenuItem   = what's on the menu / what customers order. Built from one
//                  or more products (a Cappuccino = 1 Espresso + 200ml Milk).
//                  Has its own price, image, prep time, availability.
// MenuCategory is an optional sub-tree grouping menu items inside the menu
// (e.g. "Hot Drinks", "Cold Drinks"). It sits *next to* ProductCategory —
// products stay organised by accounting/inventory concerns; menu items stay
// organised by what the customer sees.
//
// Customers never order Products directly — they order MenuItems. This module
// is the source of truth for the POS terminal's "menu" panel and for the
// digital-menu public catalog.
// ============================================================================

/// Optional sub-category for menu items. Independent from ProductCategory so
/// the menu presentation can be re-shaped without touching inventory/accounting.
model MenuCategory {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// Self-referencing tree so menu sections can nest (Drinks → Hot → Espresso-based).
  parentId       String?
  image          String?
  icon           String?
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  parent   MenuCategory?  @relation("MenuCategoryTree", fields: [parentId], references: [id])
  children MenuCategory[] @relation("MenuCategoryTree")
  items    MenuItem[]

  @@unique([organizationId, name, parentId])
  @@index([organizationId])
  @@index([parentId])
}

/// What's actually sold to the customer. Built from one or more products via
/// MenuProduct (e.g. Cappuccino = Espresso ×1 + Milk ×200). Has its own price
/// which may differ from the sum of its product costs.
model MenuItem {
  id                 String    @id @default(uuid())
  organizationId     String
  /// Optional: SKUs the cashier can punch in if the barcode scanner fires.
  code               String?
  name               String
  description        String?
  categoryId         String?
  /// Price the customer sees. Stored as Decimal(20,6) so it can be in any
  /// currency minor unit. NULL means "derive from MenuProduct sum" (rare).
  basePrice          Decimal?  @db.Decimal(20, 6)
  /// When true (default), this item deducts stock of its recipe ingredients
  /// (MenuProduct rows) on sale. Set false for service/fee items that consume
  /// no inventory. When true, at least one MenuProduct row is required.
  isInventoryTracked Boolean   @default(true)
  /// Optional tax category for this menu item. A menu item has no single stock
  /// product to inherit tax from, so this is resolved server-side at order time
  /// (a client-sent taxId still wins). NULL = untaxed unless the cart specifies one.
  taxId              String?
  image              String?
  /// Prep time hint for KDS — does not enforce anything, just a UI signal.
  preparationTime    Int?
  /// Optional KitchenStation.code override. A menu item's station is normally
  /// derived from its recipe (MenuProduct → Product.station); set this to route
  /// a recipe-less item (or override the derived station) directly.
  stationCode        String?
  isAvailable        Boolean   @default(true)
  displayOrder       Int       @default(0)
  /// Optional JSONB for chef-only notes, allergen tags, etc. Keeps the model
  /// flexible without forcing schema churn for every new attribute.
  customFields       Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  category            MenuCategory?                @relation(fields: [categoryId], references: [id])
  ingredients         MenuProduct[]
  modifierGroups      MenuItemModifierGroup[]
  /// Variants that replace the base price (e.g. Small $10 / Medium $13 / Large $16).
  /// Empty = use basePrice directly.
  variants            MenuItemVariant[]
  /// Accompaniment groups for mutually-exclusive required choices (e.g. "Choose 1 Side").
  accompanimentGroups MenuItemAccompanimentGroup[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, deletedAt])
}

/// Modifier groups (Size, Milk, Extras) attached to a sellable MenuItem. The
/// menu-based POS resolves a menu item's options from here (mirrors the legacy
/// product-scoped ProductModifierGroup).
model MenuItemModifierGroup {
  id              String    @id @default(uuid())
  organizationId  String
  menuItemId      String
  modifierGroupId String
  sortOrder       Int       @default(0)
  deletedAt       DateTime?

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([organizationId])
  @@index([menuItemId])
  @@index([organizationId, deletedAt])
}

/// Join: how much of which Product goes into a MenuItem. One MenuItem can be
/// built from many Products (a combo-on-the-menu), and one Product can be in
/// many MenuItems (Espresso → Espresso, Cappuccino, Americano, Lungo…).
model MenuProduct {
  id             String  @id @default(uuid())
  organizationId String
  menuItemId     String
  productId      String
  /// Quantity of the product used per single sale of this menu item, expressed in
  /// `uomId` when set (e.g. 18 g), else in the ingredient's base stock unit. The
  /// deduction path converts this to the ingredient's base unit before issuing.
  quantity       Decimal @default(1) @db.Decimal(20, 6)
  /// Recipe-line unit (e.g. grams for a kg-based coffee). Null → the product's base unit.
  uomId          String?

  menuItem MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])
  uom      UnitOfMeasure? @relation("MenuProductUom", fields: [uomId], references: [id])

  @@unique([menuItemId, productId])
  @@index([organizationId])
  @@index([productId])
}

// ============================================================================
// POS — Variants + Accompaniments (optional configuration layers on MenuItem).
//
// Every layer is optional — a MenuItem with no variants, no accompaniments,
// and no modifiers is still fully sellable at its basePrice.
//
//   Variant       → "What version is it?"   — REPLACES basePrice
//   Accompaniment → "What comes with it?"   — mutually-exclusive choice
//   Add-on        → "What extra is added?"  — paid extras (ModifierGroup.ADD_ON)
//   Modifier      → "How is it prepared?"   — prep instructions (ModifierGroup.MODIFIER)
//
// Add-ons and Modifiers share the existing ModifierGroup + Modifier models
// distinguished by ModifierGroup.groupType.
// ============================================================================

/// A variant replaces the MenuItem's base price with its own price.
/// When a MenuItem has variants, the cashier MUST select one before adding
/// to cart. If no variants exist, basePrice is used directly.
///
/// Example: Beef Steak
///   - Small  (150g)  $10
///   - Medium (250g)  $13   ← selected → unitPrice becomes $13
///   - Large  (350g)  $16
model MenuItemVariant {
  id             String    @id @default(uuid())
  organizationId String
  menuItemId     String
  /// Display label, e.g. "Small (150g)", "Medium (250g)".
  name           String
  /// Absolute per-unit price for this variant. NOT a delta — this REPLACES
  /// the MenuItem.basePrice when selected.
  price          Decimal   @db.Decimal(20, 6)
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, menuItemId, name])
  @@index([organizationId])
  @@index([menuItemId])
  @@index([organizationId, deletedAt])
}

/// A group of mutually-exclusive options the customer picks from.
/// These are the "Beef Steak includes 1 Side" choices:
///   - Rice        (included)
///   - Vegetables  (included)
///   - Fries       (+$1)
///
/// isRequired=true means the cashier cannot add the item to cart without
/// selecting at least minSelect options from this group.
/// Accompaniment groups (global, organization-scoped). Assigned to MenuItems
/// through the MenuItemAccompanimentGroup join table — same pattern as ModifierGroup.
model AccompanimentGroup {
  id             String    @id @default(uuid())
  organizationId String
  /// Display label, e.g. "Choose 1 Side", "Beverage".
  name           String
  /// Optional category for organising groups, e.g. "Side", "Drink".
  category       String?
  /// When true the POS enforces this selection before allowing add-to-cart.
  isRequired     Boolean   @default(true)
  /// Minimum selections required (default 1 when isRequired).
  minSelect      Int       @default(1)
  /// Maximum selections allowed. 1 = radio, 2+ = checkbox.
  maxSelect      Int       @default(1)
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  options   AccompanimentOption[]
  menuItems MenuItemAccompanimentGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

/// Join table: which AccompanimentGroups are attached to which MenuItems.
model MenuItemAccompanimentGroup {
  id                   String    @id @default(uuid())
  organizationId       String
  menuItemId           String
  accompanimentGroupId String
  sortOrder            Int       @default(0)
  deletedAt            DateTime?

  menuItem           MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  accompanimentGroup AccompanimentGroup @relation(fields: [accompanimentGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, accompanimentGroupId])
  @@index([organizationId])
  @@index([menuItemId])
  @@index([organizationId, deletedAt])
}

/// One selectable option within an AccompanimentGroup. Each option either is
/// included (priceImpact = 0) or carries an upcharge (priceImpact > 0).
model AccompanimentOption {
  id              String    @id @default(uuid())
  organizationId  String
  groupId         String
  /// Display label, e.g. "Rice", "Fries".
  name            String
  /// Price impact of selecting this option. 0 = included; >0 = upcharge.
  /// E.g. Rice=0, Fries=1 means Fries costs $1 extra.
  priceImpact     Decimal   @default(0) @db.Decimal(20, 6)
  /// Pre-selected when the dialog opens (only if within min/max bounds).
  isDefault       Boolean   @default(false)
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  /// Optional: links this accompaniment to a Product for BOM / stock tracking.
  inventoryItemId String?
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  group AccompanimentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([organizationId, groupId, name])
  @@index([organizationId])
  @@index([groupId])
  @@index([organizationId, deletedAt])
}

// ============================================================================
// POS P5: KDS — Kitchen Display System.
//
// A KitchenTicket is created by pos.checkout (one per station) when a sale is
// tendered. Items list is denormalised (JSON) so the KDS can render the
// ticket without joining 4 tables per request. Lifecycle:
//   new → preparing → ready → served
// ============================================================================

enum KdsTicketStatus {
  new
  preparing
  ready
  served
  cancelled
}

/// KDS ticket urgency. Drives colour, sort order and the alert sound.
enum KdsPriority {
  normal
  rush
  vip
}

/// A configurable kitchen/prep station (Coffee, Bakery, Grill, Bar, …). Replaces
/// the old fixed `PosStation` enum so each org defines its own stations. Products
/// route to a station by its stable `code`; the KDS renders one screen/column per
/// station. Soft-deleted (deletedAt) so historical tickets keep resolving.
model KitchenStation {
  id             String    @id @default(uuid())
  organizationId String
  /// Human label shown on the KDS and admin (e.g. "Coffee Bar").
  name           String
  /// Stable routing key stored on Product.station and KitchenTicket.station.
  /// Immutable after creation (rename touches `name`, not `code`).
  code           String
  /// Hex/tailwind token for the station's colour accent on the board.
  color          String?
  /// Optional lucide icon name for the station tab.
  icon           String?
  /// Sort order of station tabs / columns.
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  /// Exactly one station per org is the fallback when a product has no valid
  /// station code (e.g. the routed station was deleted).
  isDefault      Boolean   @default(false)
  /// Optional printer to mirror this station's KOT to (loose ref, no FK).
  printerId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model KitchenTicket {
  id             String          @id @default(uuid())
  organizationId String
  /// The originating sale. Multiple tickets (one per station) can point to the
  /// same invoice when a single sale has both bar and kitchen items.
  /// Nullable for pre-payment "Send To Kitchen" tickets.
  invoiceId      String?
  /// POS Order→Invoice split: the operational Order that fired this ticket.
  /// Tickets are created from Orders now; invoiceId is kept for back-compat.
  orderId        String?
  /// Human-readable label for the screen, e.g. "Order #42 — Sarah".
  label          String
  /// Short kitchen queue number, e.g. "K-001" (daily-reset sequence). Chefs
  /// call this out ("K-001 ready") instead of the table. Nullable for legacy
  /// tickets created before queue numbering.
  ticketNo       String?
  /// The KitchenStation.code this ticket routes to (was the PosStation enum).
  station        String
  status         KdsTicketStatus @default(new)
  /// Urgency — colour, sort and alert on the board.
  priority       KdsPriority     @default(normal)
  /// Denormalised Order.orderType (dine_in/takeaway/delivery) for a screen tag.
  orderType      String?
  /// Denormalised items so the KDS renders without N+1 joins.
  items          Json
  /// When the kitchen started preparing this order.
  startedAt      DateTime?
  /// When the order was marked ready.
  readyAt        DateTime?
  /// When the runner / customer picked it up.
  servedAt       DateTime?
  /// Chef identity captured from KDS transitions (userId of whoever tapped).
  startedBy      String?
  readyBy        String?
  /// Chef who claimed / was assigned this ticket (P3).
  assignedTo     String?
  /// Recall (ready → preparing) tracking for the recurring-cause report.
  recallCount    Int             @default(0)
  recallReason   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, station, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, priority, status])
  @@index([invoiceId])
  @@index([orderId])
}

// ============================================================================
// POS P7: Loyalty + Store Credit + Customer Tabs (the "membership economy").
//
//   LoyaltyProgram  — org-level config: 1 point per X UGX, 1 UGX per Y points.
//   LoyaltyLedger   — append-only point transactions (earn, redeem, expire, adjust).
//   StoreCredit     — partner-scoped balance (e.g. gift cards, refunds-to-credit).
//   StoreCreditLedger — append-only credit transactions.
//   CustomerTab     — running "house tab" for a regular, paid periodically.
//   CustomerTabLedger — append-only tab charges + payments.
//
// All five tables are org-scoped (added to ORG_SCOPED).
// ============================================================================

model LoyaltyProgram {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  /// E.g. 1 = 1 point per UGX spent. Use 0.01 for 1 point per 100 UGX.
  pointsPerCurrency Decimal  @default(1) @db.Decimal(20, 6)
  /// UGX value of a single point when redeeming. E.g. 100 = 1 point = UGX 100.
  currencyPerPoint  Decimal  @default(100) @db.Decimal(20, 6)
  /// Optional minimum points before a redemption is allowed.
  minPointsToRedeem Int      @default(50)
  /// Points expire after N days of inactivity. 0 = never.
  pointsExpireDays  Int      @default(365)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LoyaltyLedger {
  id             String    @id @default(uuid())
  organizationId String
  partnerId      String
  /// Earned (+) or redeemed (−) or adjusted manually.
  delta          Decimal   @db.Decimal(20, 6)
  /// Snapshot of the partner's running balance after this entry.
  balanceAfter   Decimal   @db.Decimal(20, 6)
  /// Earning source: the invoice (sale) that produced the points, or
  /// 'manual' for an admin adjustment, 'redemption' for a use, 'expire'.
  reason         String
  documentId     String?
  /// Optional: when the points expire (NULL = never).
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  createdBy      String?

  @@index([organizationId, partnerId, createdAt])
  @@index([organizationId, partnerId, reason])
  @@index([expiresAt])
}

model StoreCredit {
  id             String    @id @default(uuid())
  organizationId String
  partnerId      String
  /// Signed balance. Positive = customer has credit; negative = customer
  /// owes the café (rare; usually we use CustomerTab for that).
  balance        Decimal   @default(0) @db.Decimal(20, 6)
  /// Optional: nil = never expires. Stale credit auto-forfeited via cron.
  expiresAt      DateTime?
  /// Optional: original source (refund id, gift-card purchase, etc.)
  source         String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ledger StoreCreditLedger[]

  @@unique([organizationId, partnerId])
  @@index([organizationId])
  @@index([organizationId, partnerId])
}

model StoreCreditLedger {
  id             String   @id @default(uuid())
  organizationId String
  storeCreditId  String
  /// Positive = credit added; negative = credit used.
  delta          Decimal  @db.Decimal(20, 6)
  balanceAfter   Decimal  @db.Decimal(20, 6)
  /// E.g. 'refund', 'gift_card_purchase', 'sale', 'manual_adjust', 'expire'.
  reason         String
  documentId     String?
  createdAt      DateTime @default(now())
  createdBy      String?

  storeCredit StoreCredit @relation(fields: [storeCreditId], references: [id], onDelete: Cascade)

  @@index([organizationId, storeCreditId, createdAt])
}

model CustomerTab {
  id             String    @id @default(uuid())
  organizationId String
  partnerId      String
  /// Signed running balance. Positive = customer owes this much.
  balance        Decimal   @default(0) @db.Decimal(20, 6)
  /// Max balance the customer is allowed to run. 0 = no limit.
  creditLimit    Decimal   @default(0) @db.Decimal(20, 6)
  /// Optional: link to a specific cash session so the cashier can settle
  /// the tab to a particular register at end of shift.
  cashSessionId  String?
  isOpen         Boolean   @default(true)
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ledger CustomerTabLedger[]

  @@unique([organizationId, partnerId])
  @@index([organizationId])
}

model CustomerTabLedger {
  id             String   @id @default(uuid())
  organizationId String
  tabId          String
  /// Positive = charge added to the tab; negative = payment received.
  delta          Decimal  @db.Decimal(20, 6)
  balanceAfter   Decimal  @db.Decimal(20, 6)
  reason         String
  /// For charges: the invoice that was added to the tab.
  /// For payments: the payment row that settled the tab.
  documentId     String?
  paymentId      String?
  createdAt      DateTime @default(now())
  createdBy      String?

  tab CustomerTab @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@index([organizationId, tabId, createdAt])
}

// ============================================================================
// Digital Menu (Phase 1 MVP) — customer-facing ordering channel.
//
// A MenuQrSession is the lightweight "we trust this device / this table" grant
// that the QR code encodes. It allows anonymous (no-login) orders on a
// specific table/branch for a limited window. The customer-facing menu page
// is a separate, no-auth route at /menu/:branchId/:tableId?token=xxx.
//
// OnlineOrder is the order a customer placed from the menu page. The cashier
// sees it as a normal Document (sales_invoice) on the terminal with
// sourceType='online_menu', and a KDS ticket is auto-created.
// ============================================================================

enum OnlineOrderStatus {
  received
  accepted
  preparing
  ready
  served
  completed
  cancelled
}

model MenuQrSession {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  /// Optional table number, e.g. "5" or "T-12". Free-form string.
  tableNumber    String?
  /// Short opaque token embedded in the QR URL. The customer-facing page
  /// passes it as ?token=... and the backend validates it.
  token          String    @unique
  expiresAt      DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  orders OnlineOrder[]

  @@index([organizationId, branchId])
  @@index([organizationId, isActive])
}

model OnlineOrder {
  id             String            @id @default(uuid())
  organizationId String
  /// The QR session that authorised this order. NULL = walk-in online.
  sessionId      String?
  /// Customer info captured during checkout (no auth required).
  customerName   String
  customerPhone  String?
  customerEmail  String?
  /// 'dine_in' | 'takeaway' | 'pickup' (digital menu: no delivery in MVP)
  orderType      String            @default("dine_in")
  /// Denormalised line items so the customer's tracking page renders
  /// without joining 4 tables per request.
  items          Json
  subtotal       Decimal           @db.Decimal(20, 6)
  taxAmount      Decimal           @default(0) @db.Decimal(20, 6)
  totalAmount    Decimal           @db.Decimal(20, 6)
  /// After the cashier settles the order, the resulting sales_invoice
  /// document id. NULL = not yet tendered (still in cart, or pending).
  invoiceId      String?
  /// 'mobile_money' | 'card' | 'cash_on_pickup' | 'wallet' | 'qr'
  paymentMethod  String?
  /// Raw mobile-money / card reference the customer supplied.
  paymentRef     String?
  status         OnlineOrderStatus @default(received)
  /// Free-form note from the customer ("no onions please", etc.)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  session MenuQrSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, sessionId])
  @@index([organizationId, customerPhone])
}

model Payment {
  id                String           @id @default(uuid())
  organizationId    String
  paymentNumber     String
  direction         PaymentDirection @default(inbound)
  partnerId         String
  paymentDate       DateTime
  paymentMethod     String           @default("cash")
  journalId         String?
  accountId         String?
  currencyId        String?
  exchangeRate      Decimal          @default(1) @db.Decimal(18, 8)
  amount            Decimal          @default(0) @db.Decimal(20, 6)
  allocatedAmount   Decimal          @default(0) @db.Decimal(20, 6)
  unallocatedAmount Decimal          @default(0) @db.Decimal(20, 6)
  /// Free-text narration. A bursar may legitimately type the same value on
  /// every receipt ("CASH"), so this is NEVER constrained — see externalReference.
  reference         String?
  /// Machine-issued idempotency key: MoMo/bank/card transaction id, or an
  /// import row reference. Unique per (org, type, value, direction) — the
  /// database guarantee FINANCIAL_INVARIANTS §Idempotency requires, which an
  /// application existence check under READ COMMITTED cannot provide (P0-B).
  externalReference     String?
  /// mobile_money_txn | bank_txn | card_txn | import_row
  externalReferenceType String?
  status            DocumentStatus   @default(posted)
  /// Phase F: branch this payment was made at.
  branchId          String?
  journalEntryId    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         String?
  updatedBy         String?

  partner       Partner             @relation(fields: [partnerId], references: [id])
  allocations   PaymentAllocation[]
  cashMovements CashMovement[]

  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, externalReferenceType, externalReference, direction])
  @@index([organizationId])
  @@index([organizationId, partnerId])
  @@index([organizationId, branchId])
  @@index([organizationId, externalReference])
}

model PaymentAllocation {
  id             String   @id @default(uuid())
  organizationId String
  paymentId      String
  /// Exactly one of documentId / invoiceId is set: documentId for the generic
  /// AR/AP ledger (manual invoices, bills), invoiceId for POS sales invoices.
  documentId     String?
  invoiceId      String?
  amount         Decimal  @default(0) @db.Decimal(20, 6)
  /// Cached projection of whether a PaymentAllocationReversal row exists:
  /// posted | reversed. The reversal ROW is authoritative — exactly as
  /// FeeCredit.remaining projects FeeCreditAllocation (ADR-013).
  status         String   @default("posted")
  createdAt      DateTime @default(now())

  payment  Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id])
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])
  reversal PaymentAllocationReversal?

  @@index([organizationId])
  @@index([paymentId])
  @@index([documentId])
  @@index([invoiceId])
  @@index([organizationId, status])
}

/// A reversal is a NEW economic event, never an edit of the original allocation
/// (FINANCIAL_INVARIANTS §Immutability). Reallocation = reverse then re-create.
/// Unique on paymentAllocationId: reversing twice would restore AR twice.
model PaymentAllocationReversal {
  id                  String   @id @default(uuid())
  organizationId      String
  paymentAllocationId String   @unique
  amount              Decimal  @db.Decimal(20, 6)
  reason              String
  journalEntryId      String?
  reversedById        String?
  approvedById        String?
  reversedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  allocation PaymentAllocation @relation(fields: [paymentAllocationId], references: [id])

  @@index([organizationId])
}

// =============================================================================
// Phase 4 — Inventory (stock of Products; optional batch/expiry, kept simple)
// =============================================================================

enum LocationType {
  warehouse
  store
  virtual
  // Restaurant-specific (additive, F.8)
  main_kitchen
  bar
  storage_room
  walkin_fridge
  freezer
  dry_storage
  front_counter
  branch
  // Manufacturing (additive) — a bakery/prep-kitchen production floor. Raw
  // materials transfer in and are consumed here; finished goods land elsewhere.
  production
}

enum StockMoveType {
  receipt
  issue
  adjustment_in
  adjustment_out
  transfer_in
  transfer_out
  opening_balance
  // F.8 — restaurant inventory engine (additive)
  waste
  return_in
  return_to_supplier
  expiry_write_off
  internal_use
  promo_sample
  // Manufacturing (additive) — consume relieves raw materials into WIP, output
  // receives finished goods from WIP. Keep in sync with STOCK_MOVE_TYPES in
  // packages/shared/src/enums.ts (IssueStockDto.moveType validates against it).
  production_consume
  production_output
}

/// Configurable inventory movement types for the posting rule engine.
/// These map one-to-many to StockMoveType and drive GL account resolution.
/// Seeded on org creation with sensible defaults.
enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  STOCK_TRANSFER_OUT
  STOCK_TRANSFER_IN
  ADJUSTMENT_GAIN
  ADJUSTMENT_LOSS
  WASTE
  EXPIRY_WRITE_OFF
  RETURN_RESTOCK
  RETURN_TO_SUPPLIER
  INTERNAL_CONSUMPTION
  PROMO_SAMPLE
  PRODUCTION_CONSUME
  PRODUCTION_OUTPUT
  REVALUATION
  /// Squares up COGS/valuation after a receipt lands on negative on-hand
  /// (goods sold before they were received). Configurable so the correction can
  /// be routed to its own account rather than plain COGS.
  COGS_CORRECTION
}

/// Lifecycle for the new stock document wrappers (StockOut, WasteRecord,
/// StockAdjustmentDoc, StockTransferDoc). Posting to the ledger happens on
/// transition to `approved`/`completed` and is idempotent (postedAt guard).
enum StockDocStatus {
  draft
  pending
  approved
  rejected
  completed
  cancelled
}

enum StockOutCategory {
  general_use
  kitchen_testing
  training
  damaged
  sample
  expired
  complimentary
  other
}

enum WasteCategory {
  expired
  spoiled
  burnt
  contaminated
  breakage
  other
  // Manufacturing scrap reasons (Phase 2) — root-cause reporting on production loss.
  overmixed
  packaging_defect
  qc_rejection
}

enum StockAdjustmentReason {
  cycle_count
  damaged
  expired
  theft
  found
  initial_count
  other
}

model InventoryLocation {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           LocationType @default(warehouse)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  stockItems    StockItem[]
  batches       InventoryBatch[]
  ledgerEntries InventoryLedger[]
  serials       InventorySerial[]
  cashRegisters CashRegister[]
  goodsReceipts GoodsReceiptNote[]
  stockOuts     StockOut[]
  wasteRecords  WasteRecord[]
  adjustments   StockAdjustment[]
  transfersFrom StockTransfer[]         @relation("StockTransferFrom")
  transfersTo   StockTransfer[]         @relation("StockTransferTo")
  countSessions InventoryCountSession[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// On-hand quantity per product (+ optional variant) per location (the "quant").
model StockItem {
  id                 String   @id @default(uuid())
  organizationId     String
  productId          String
  /// F.8 — null for non-variant products.
  variantId          String?
  /// Non-null mirror of variantId ("" when null) so the unique index keeps its
  /// one-row-per-(product,variant,location) guarantee. Postgres treats NULLs as
  /// distinct, which would otherwise allow duplicate non-variant quants.
  variantKey         String   @default("")
  locationId         String
  quantity           Decimal  @default(0) @db.Decimal(20, 6)
  /// Running weighted-average cost per unit. Updated on every receipt (AVCO
  /// products only). For FIFO products this stays 0; for STANDARD products this
  /// stays 0 (the cost is Product.costPrice). See CostResolverService.
  runningAverageCost Decimal  @default(0) @db.Decimal(20, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])
  location InventoryLocation @relation(fields: [locationId], references: [id])

  @@unique([organizationId, productId, variantKey, locationId])
  @@index([organizationId])
  @@index([productId])
  @@index([locationId])
}

/// Optional batch/lot with optional expiry — only used when product.batchTracking.
model InventoryBatch {
  id             String    @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  locationId     String
  batchNumber    String
  quantity       Decimal   @default(0) @db.Decimal(20, 6)
  unitCost       Decimal?  @db.Decimal(20, 6)
  expiryDate     DateTime?
  /// Manufacturing date (optional). Captured on receipt for shelf-life reporting.
  mfgDate        DateTime?
  receivedAt     DateTime  @default(now())
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?   @relation(fields: [variantId], references: [id])
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  ledgerEntries InventoryLedger[]
  serials       InventorySerial[]

  @@index([organizationId])
  @@index([productId, locationId])
  @@index([expiryDate])
}

/// Reservation status: active holds ATP; released frees it; consumed = fulfilled.
enum StockReservationStatus {
  active
  released
  consumed
}

/// Soft stock reservation (available-to-promise). A source document (order /
/// invoice / manual) holds quantity at a location without moving the ledger;
/// available = on-hand - sum(active). No hard FK relations so it stays decoupled
/// from the heavily-shared Product/Location models; org scoping via tenancy.
model StockReservation {
  id             String                 @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  variantKey     String                 @default("")
  locationId     String
  quantity       Decimal                @db.Decimal(20, 6)
  status         StockReservationStatus @default(active)
  /// 'order' | 'invoice' | 'pos_tab' | 'manual'
  sourceType     String
  sourceId       String
  reason         String?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  releasedAt     DateTime?
  consumedAt     DateTime?

  @@index([organizationId, productId, variantKey, locationId, status])
  @@index([organizationId, sourceType, sourceId])
}

/// Due-date computation method for a PaymentTerm (Odoo-style).
enum PaymentTermMethod {
  /// Due on the invoice date itself.
  immediate
  /// Due `netDays` after the invoice date.
  net_days
  /// Due at the end of the month FOLLOWING the invoice month, plus a `netDays`
  /// offset (covers both "End of the following month" and "N days after end of
  /// the following month").
  end_of_following_month
}

/// Payment term (net-N with optional early-payment discount). Referenced by
/// Partner.paymentTermId; drives invoice due-date derivation + dunning.
model PaymentTerm {
  id              String            @id @default(uuid())
  organizationId  String
  code            String
  name            String
  /// Due-date computation method; `netDays` is the numeric offset it applies.
  method          PaymentTermMethod @default(net_days)
  /// Days applied by `method` (net days, or days after end of the month).
  netDays         Int               @default(0)
  /// Optional early-payment discount: percent if paid within discountDays.
  discountDays    Int?
  discountPercent Decimal?          @db.Decimal(9, 4)
  isActive        Boolean           @default(true)
  /// Display order in pickers (Immediate → longest terms).
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

/// Odoo-style fiscal position: a label applied to sales invoices that adapts
/// tax treatment (e.g. intra-community, export, domestic). Kept as a
/// configurable master; the invoice stores a loose id + name snapshot.
model FiscalPosition {
  id             String    @id @default(uuid())
  organizationId String
  code           String
  name           String
  isActive       Boolean   @default(true)
  /// Display order in pickers.
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

/// Immutable stock ledger — every movement (receipt/issue/adjustment/transfer).
model InventoryLedger {
  id             String        @id @default(uuid())
  organizationId String
  ledgerCode     String
  productId      String
  variantId      String?
  locationId     String
  batchId        String?
  /// F.8+: links a movement to the specific serialized unit it moved (serial-tracked
  /// products). Null for non-serial movements.
  serialId       String?
  type           StockMoveType
  /// Location on-hand BEFORE this movement (qtyAfter = balanceAfter).
  qtyBefore      Decimal       @default(0) @db.Decimal(20, 6)
  quantityChange Decimal       @db.Decimal(20, 6)
  balanceAfter   Decimal       @db.Decimal(20, 6)
  unitCost       Decimal       @default(0) @db.Decimal(20, 6)
  totalValue     Decimal       @default(0) @db.Decimal(20, 6)
  referenceType  String?
  referenceId    String?
  notes          String?
  performedBy    String?
  createdAt      DateTime      @default(now())

  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])
  location InventoryLocation @relation(fields: [locationId], references: [id])
  batch    InventoryBatch?   @relation(fields: [batchId], references: [id])
  serial   InventorySerial?  @relation(fields: [serialId], references: [id])

  @@index([organizationId, ledgerCode])
  @@index([organizationId])
  @@index([productId])
  @@index([locationId])
  @@index([organizationId, createdAt])
}

/// One row per serialized physical unit (only when product.serialTracking).
/// Captured on receipt (status in_stock) and consumed on issue (status issued),
/// carrying its own actual receipt unitCost so SPECIFIC costing is exact.
model InventorySerial {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  locationId     String
  serialNumber   String
  /// Optional link to the batch this unit belongs to (batch + serial together).
  batchId        String?
  /// Actual receipt cost of this unit (basis for SPECIFIC costing).
  unitCost       Decimal?     @db.Decimal(20, 6)
  status         SerialStatus @default(in_stock)
  receivedAt     DateTime     @default(now())
  issuedAt       DateTime?
  /// sourceType:sourceId of the receipt / issue that moved this unit.
  receiptRef     String?
  issueRef       String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?   @relation(fields: [variantId], references: [id])
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  batch         InventoryBatch?   @relation(fields: [batchId], references: [id])
  ledgerEntries InventoryLedger[]

  @@unique([organizationId, productId, serialNumber])
  @@index([organizationId])
  @@index([organizationId, productId, locationId, status])
  @@index([batchId])
}

// =============================================================================
// F.8 — Stock document wrappers (StockOut / Waste / Adjustment / Transfer).
// These are auditable headers + lines that the StockDocService posts into the
// existing engine (StockService.issue/receive/transfer) on approval. Posting is
// idempotent via postedAt. They do NOT replace the engine — they wrap it.
// =============================================================================

/// Non-sale stock-out (internal use, testing, samples, comps). Posts ISSUE.
model StockOut {
  id             String           @id @default(uuid())
  organizationId String
  outCode        String
  locationId     String
  category       StockOutCategory @default(general_use)
  status         StockDocStatus   @default(draft)
  reason         String?
  notes          String?
  performedById  String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  totalValue     Decimal          @default(0) @db.Decimal(20, 6)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      String?
  updatedBy      String?

  location InventoryLocation @relation(fields: [locationId], references: [id])
  items    StockOutItem[]

  @@unique([organizationId, outCode])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
}

model StockOutItem {
  id             String  @id @default(uuid())
  organizationId String
  stockOutId     String
  productId      String
  variantId      String?
  productName    String
  unit           String?
  qty            Decimal @db.Decimal(20, 6)
  unitCost       Decimal @default(0) @db.Decimal(20, 6)
  totalCost      Decimal @default(0) @db.Decimal(20, 6)
  batchNumber    String?
  distStrategy   String? @default("FEFO")

  stockOut StockOut @relation(fields: [stockOutId], references: [id], onDelete: Cascade)

  @@index([organizationId, stockOutId])
}

/// Spoilage / expiry / breakage. Posts WASTE (or EXPIRY_WRITE_OFF).
model WasteRecord {
  id             String         @id @default(uuid())
  organizationId String
  wasteCode      String
  locationId     String
  category       WasteCategory  @default(other)
  status         StockDocStatus @default(draft)
  notes          String?
  reportedById   String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  totalValue     Decimal        @default(0) @db.Decimal(20, 6)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?
  updatedBy      String?

  location InventoryLocation @relation(fields: [locationId], references: [id])
  items    WasteItem[]

  @@unique([organizationId, wasteCode])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
}

model WasteItem {
  id             String  @id @default(uuid())
  organizationId String
  wasteId        String
  productId      String
  variantId      String?
  productName    String
  unit           String?
  qty            Decimal @db.Decimal(20, 6)
  unitCost       Decimal @default(0) @db.Decimal(20, 6)
  totalCost      Decimal @default(0) @db.Decimal(20, 6)
  batchNumber    String?
  /// true → post EXPIRY_WRITE_OFF instead of WASTE.
  isExpiry       Boolean @default(false)

  waste WasteRecord @relation(fields: [wasteId], references: [id], onDelete: Cascade)

  @@index([organizationId, wasteId])
}

/// Cycle-count correction document with approval. Posts ADJUSTMENT_IN/OUT.
model StockAdjustment {
  id             String                @id @default(uuid())
  organizationId String
  adjCode        String
  locationId     String
  reason         StockAdjustmentReason @default(cycle_count)
  status         StockDocStatus        @default(draft)
  notes          String?
  performedById  String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      String?
  updatedBy      String?

  location InventoryLocation     @relation(fields: [locationId], references: [id])
  items    StockAdjustmentItem[]

  @@unique([organizationId, adjCode])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
}

model StockAdjustmentItem {
  id             String  @id @default(uuid())
  organizationId String
  adjId          String
  productId      String
  variantId      String?
  productName    String
  unit           String?
  qtySystem      Decimal @db.Decimal(20, 6)
  qtyActual      Decimal @db.Decimal(20, 6)
  qtyDiff        Decimal @db.Decimal(20, 6)
  unitCost       Decimal @default(0) @db.Decimal(20, 6)
  batchNumber    String?

  adj StockAdjustment @relation(fields: [adjId], references: [id], onDelete: Cascade)

  @@index([organizationId, adjId])
}

/// Inter-location transfer document with status workflow. Posts TRANSFER_OUT/IN.
model StockTransfer {
  id             String         @id @default(uuid())
  organizationId String
  transferCode   String
  fromLocId      String
  toLocId        String
  status         StockDocStatus @default(draft)
  notes          String?
  performedById  String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?
  updatedBy      String?

  fromLoc InventoryLocation   @relation("StockTransferFrom", fields: [fromLocId], references: [id])
  toLoc   InventoryLocation   @relation("StockTransferTo", fields: [toLocId], references: [id])
  items   StockTransferItem[]

  @@unique([organizationId, transferCode])
  @@index([organizationId, status])
}

model StockTransferItem {
  id             String  @id @default(uuid())
  organizationId String
  transferId     String
  productId      String
  variantId      String?
  productName    String
  unit           String?
  qtyRequested   Decimal @db.Decimal(20, 6)
  qtyTransferred Decimal @default(0) @db.Decimal(20, 6)
  batchNumber    String?
  distStrategy   String? @default("FEFO")
  unitCost       Decimal @default(0) @db.Decimal(20, 6)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([organizationId, transferId])
}

// =============================================================================
// Inventory Count Sessions — guided physical stock count (opening / closing).
// A supervisor counts all items; on submit the variance lines are turned into a
// StockAdjustment which posts ADJUSTMENT_IN/OUT to the ledger. Stock is NEVER
// overwritten directly — the count is the immutable "what we physically found",
// the adjustment is the audited correction it produces.
// =============================================================================

/// Beverage Control — how a product's remaining stock is measured.
enum MeasurementMethod {
  count
  manual_volume
  digital_weight
}

enum InventoryCountType {
  opening
  closing
}

enum InventoryCountStatus {
  draft
  submitted
  cancelled
}

/// Header for one physical count. Resumable while `draft`; terminal once
/// `submitted` (links to the generated StockAdjustment) or `cancelled`.
model InventoryCountSession {
  id             String               @id @default(uuid())
  organizationId String
  countCode      String
  name           String?
  locationId     String
  countType      InventoryCountType   @default(opening)
  status         InventoryCountStatus @default(draft)
  notes          String?
  startedById    String?
  startedAt      DateTime             @default(now())
  submittedById  String?
  submittedAt    DateTime?
  /// StockAdjustment generated on submit (audit link). Null until submitted, or
  /// when the count had no variances to post.
  adjustmentId   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  location InventoryLocation    @relation(fields: [locationId], references: [id])
  lines    InventoryCountLine[]

  @@unique([organizationId, countCode])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
}

/// One product row in a count — the physical count vs the system snapshot taken
/// when the session started. `countedQty` is null until the supervisor enters it.
model InventoryCountLine {
  id                String    @id @default(uuid())
  organizationId    String
  sessionId         String
  productId         String
  variantId         String?
  productName       String
  parentProductId   String?
  parentProductName String?
  unit              String?
  systemQty         Decimal   @db.Decimal(20, 6)
  countedQty        Decimal?  @db.Decimal(20, 6)
  variance          Decimal   @default(0) @db.Decimal(20, 6)
  reason            String?
  countedById       String?
  countedAt         DateTime?

  session InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionId])
  @@index([sessionId])
}

// =============================================================================
// Beverage Control — digital-weight alcohol measurement (bar shrinkage control).
// A separate, alcohol-only physical count: bartenders weigh open bottles, the
// system converts grams -> remaining ml, reconciles against live system stock
// (which POS sales already deducted in ml), and on submit posts ONLY the variance
// as a StockAdjustment — reusing the same adjustment -> ledger -> GL -> audit path
// as the generic inventory count. productId / locationId are stored as scalar ids
// (no Prisma relation) so the beverage tables stay self-contained.
// =============================================================================

model BottleCountSession {
  id             String    @id @default(uuid())
  organizationId String
  countCode      String
  name           String?
  locationId     String
  countType      String    @default("closing") // opening | closing
  status         String    @default("draft") // draft | submitted | cancelled
  notes          String?
  startedById    String?
  startedAt      DateTime  @default(now())
  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  /// StockAdjustment generated on submit (audit link). Null until submitted, or
  /// when the count had no variance to post.
  adjustmentId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  lines BottleCountLine[]

  @@unique([organizationId, countCode])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
}

model BottleCountLine {
  id              String    @id @default(uuid())
  organizationId  String
  sessionId       String
  productId       String
  productName     String
  unit            String?
  /// Live system remaining (StockItem quantity, in ml) snapshotted at start.
  systemMl        Decimal   @db.Decimal(20, 6)
  /// Sealed / unopened full bottles counted (whole units).
  sealedFullCount Decimal   @default(0) @db.Decimal(20, 6)
  /// sealedFullCount * containerVolumeMl + Σ(reading.remainingMl).
  countedMl       Decimal?  @db.Decimal(20, 6)
  varianceMl      Decimal   @default(0) @db.Decimal(20, 6)
  varianceG       Decimal   @default(0) @db.Decimal(20, 6)
  expectedShots   Decimal?  @db.Decimal(20, 6)
  soldShots       Decimal?  @db.Decimal(20, 6)
  reason          String?
  confidence      String    @default("GOOD") // GOOD | SUSPICIOUS | OUT_OF_RANGE
  countedById     String?
  countedAt       DateTime?

  session  BottleCountSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  readings BottleCountReading[]

  @@index([organizationId, sessionId])
  @@index([sessionId])
}

model BottleCountReading {
  id              String   @id @default(uuid())
  organizationId  String
  lineId          String
  /// Optional physical bottle identifier for high-value liquor traceability.
  bottleNumber    String?
  measuredWeightG Decimal  @db.Decimal(20, 6)
  expectedWeightG Decimal? @db.Decimal(20, 6)
  remainingMl     Decimal  @db.Decimal(20, 6)
  confidence      String   @default("GOOD") // GOOD | SUSPICIOUS | OUT_OF_RANGE

  line BottleCountLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([organizationId, lineId])
  @@index([lineId])
}

/// Immutable weighing log — one row per physical measurement (count or ad-hoc
/// spot check). Powers bottle history + variance/yield reports. Grams are stored
/// alongside ml because managers read grams faster than millilitres.
model BottleMeasurement {
  id                String   @id @default(uuid())
  organizationId    String
  productId         String
  bottleNumber      String?
  locationId        String
  sessionId         String?
  openingWeightG    Decimal? @db.Decimal(20, 6)
  expectedWeightG   Decimal? @db.Decimal(20, 6)
  measuredWeightG   Decimal  @db.Decimal(20, 6)
  remainingMl       Decimal  @db.Decimal(20, 6)
  varianceMl        Decimal  @default(0) @db.Decimal(20, 6)
  varianceG         Decimal  @default(0) @db.Decimal(20, 6)
  /// MANUAL | SCALE | BLUETOOTH | USB | IMPORT | API
  measurementSource String   @default("MANUAL")
  confidence        String   @default("GOOD")
  measuredById      String?
  measuredAt        DateTime @default(now())
  remarks           String?
  createdAt         DateTime @default(now())

  @@index([organizationId, productId])
  @@index([organizationId, locationId])
  @@index([sessionId])
}

// =============================================================================
// M5 — Cash sessions / cash registers (foundation for POS + School canteen)
// =============================================================================

enum CashSessionStatus {
  open
  closed
  reconciled
}

enum CashMovementType {
  sale
  refund
  pay_in
  pay_out
  adjustment
}

/// Metadata about a till. `defaultAccountId` is the cash GL account used for
/// the session's opening float and movements. `locationId` is optional and
/// links the till to a physical InventoryLocation (e.g. a store).
model CashRegister {
  id               String    @id @default(uuid())
  organizationId   String
  code             String
  name             String
  locationId       String?
  defaultAccountId String
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  defaultAccount Account            @relation("CashRegisterDefaultAccount", fields: [defaultAccountId], references: [id])
  location       InventoryLocation? @relation(fields: [locationId], references: [id])
  sessions       CashSession[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([locationId])
}

/// An open shift at a CashRegister. `openingFloat` is the starting cash;
/// `closingCounted` is what was actually counted; `closingExpected` is what
/// the system computed (= opening + sales + pay-ins − pay-outs − refunds);
/// `closingDifference = counted − expected` and is the variance.
model CashSession {
  id                  String            @id @default(uuid())
  organizationId      String
  cashRegisterId      String
  /// Phase F: redundant cache of the register's branch, for branch-scoped
  /// reports without joining back to the register.
  branchId            String?
  userId              String
  status              CashSessionStatus @default(open)
  /// Offline-first (P1): PosDevice that ran this session offline.
  deviceId            String?
  openedAt            DateTime          @default(now())
  closedAt            DateTime?
  openingFloat        Decimal           @default(0) @db.Decimal(20, 6)
  closingCounted      Decimal?          @db.Decimal(20, 6)
  closingExpected     Decimal?          @db.Decimal(20, 6)
  closingDifference   Decimal?          @db.Decimal(20, 6)
  /// Variance investigation trail: user-supplied reason for the discrepancy.
  varianceReason      String?
  /// null = unexamined, 'pending_review' = flagged, 'approved' / 'rejected' = resolved.
  varianceStatus      String?
  /// How much was banked from this session and where.
  bankedAmount        Decimal?          @db.Decimal(20, 6)
  bankName            String?
  /// C3: manager who approved a variance (must differ from `userId` — SoD).
  approvedById        String?
  /// Medium: reopen audit trail. A closed (not reconciled) session may be
  /// reopened by a manager; reconciled sessions are immutable.
  reopenedAt          DateTime?
  reopenedById        String?
  /// Medium: denomination breakdowns (note/coin counts) captured at open/close.
  /// Shape: { "50000": 3, "20000": 5, ... } → face-value → count.
  openingDenomination Json?
  closingDenomination Json?
  /// Medium: frozen per-tender totals (cash/card/mobile_money/…) at close, so a
  /// reprinted summary doesn't drift when invoices are later voided/edited.
  closingByMethod     Json?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id])
  movements    CashMovement[]

  @@index([organizationId])
  @@index([cashRegisterId])
  @@index([userId])
  @@index([status])
  @@index([organizationId, branchId])
}

/// Every in/out during a session. For sales/refunds the corresponding
/// `Payment` is linked via `paymentId` so the cash session reconciles with the
/// ledger.
model CashMovement {
  id             String           @id @default(uuid())
  organizationId String
  cashSessionId  String
  movementType   CashMovementType
  amount         Decimal          @db.Decimal(20, 6)
  paymentId      String?
  reason         String?
  performedBy    String?
  createdAt      DateTime         @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([organizationId])
  @@index([cashSessionId])
  @@index([paymentId])
}

/// Immutable snapshot of a POS Z-report. Written once when the cash session
/// is closed so the report can be reprinted later even after movements age.
model PosReportSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  cashSessionId  String   @unique
  /// Frozen report data (JSON — same shape as XReport/ZReport response).
  reportData     Json
  /// 'z' is the only kind today; extensible for future report types.
  kind           String   @default("z")
  generatedAt    DateTime @default(now())

  @@index([organizationId, cashSessionId])
  @@index([organizationId, generatedAt])
}

// =============================================================================
// D3 � Reporting snapshots (Trial Balance / P&L / Balance Sheet / AP Aging)
// =============================================================================

/// Trial Balance snapshot. One row per (organization, asOf, account) carrying
/// the running debit / credit / balance from posted entries. Reports read from
/// this instead of live JournalLine so a 1M-row tenant returns in <500ms.
model ReportTrialBalanceSnapshot {
  id                 String   @id @default(uuid())
  organizationId     String
  asOf               DateTime
  accountId          String
  accountCode        String
  accountName        String
  /// @deprecated legacy mirror — read `accountCategoryKey` / `classification`.
  accountType        String
  accountCategoryKey String?
  classification     String?
  normalBalance      String?
  debit              Decimal  @db.Decimal(20, 6)
  credit             Decimal  @db.Decimal(20, 6)
  balance            Decimal  @db.Decimal(20, 6)
  builtAt            DateTime @default(now())
  /// Rows written before the AccountCategory migration are v1 and are treated as
  /// stale by readers, which fall back to the live query and enqueue a rebuild.
  schemaVersion      Int      @default(2)

  @@unique([organizationId, asOf, accountId])
  @@index([organizationId, asOf])
}

/// Profit & Loss snapshot. One row per (organization, asOf) carrying the
/// revenue / contra-revenue / cogs / expense / net-income totals.
model ReportPnLSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  asOf           DateTime
  revenue        Decimal  @db.Decimal(20, 6)
  contraRevenue  Decimal  @db.Decimal(20, 6)
  cogs           Decimal  @db.Decimal(20, 6)
  expense        Decimal  @db.Decimal(20, 6)
  netIncome      Decimal  @db.Decimal(20, 6)
  builtAt        DateTime @default(now())

  @@unique([organizationId, asOf])
  @@index([organizationId, asOf])
}

/// Balance Sheet snapshot. One row per (organization, asOf, account) carrying the
/// cumulative balance for balance-sheet accounts. Reports sum revenue/expense
/// lines through retained earnings automatically.
model ReportBalanceSheetSnapshot {
  id                 String   @id @default(uuid())
  organizationId     String
  asOf               DateTime
  accountId          String
  accountCode        String
  accountName        String
  /// @deprecated legacy mirror — read `accountCategoryKey` / `classification`.
  accountType        String
  accountCategoryKey String?
  classification     String?
  normalBalance      String?
  reportSection      String?
  balance            Decimal  @db.Decimal(20, 6)
  builtAt            DateTime @default(now())
  /// See ReportTrialBalanceSnapshot.schemaVersion.
  schemaVersion      Int      @default(2)

  @@unique([organizationId, asOf, accountId])
  @@index([organizationId, asOf])
}

/// AP Aging snapshot. One row per (organization, asOf, partner) with the unpaid
/// vendor-bill balances bucketed by age.
model ReportApAgingSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  asOf           DateTime
  partnerId      String
  partnerName    String
  total          Decimal  @db.Decimal(20, 6)
  current        Decimal  @db.Decimal(20, 6)
  b1_30          Decimal  @db.Decimal(20, 6)
  b31_60         Decimal  @db.Decimal(20, 6)
  b61_90         Decimal  @db.Decimal(20, 6)
  b90p           Decimal  @db.Decimal(20, 6)
  builtAt        DateTime @default(now())

  @@unique([organizationId, asOf, partnerId])
  @@index([organizationId, asOf])
}

/// AR/AP tie-out snapshot � written nightly by TieOutService. Compares the GL
/// AR/AP control account balance to the sum of open invoice/bill residuals. A
/// variance > .01 means the books are out of sync.
model ReportTieoutSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  asOf           DateTime
  arBalanced     Boolean
  arVariance     Decimal  @db.Decimal(20, 6)
  apBalanced     Boolean
  apVariance     Decimal  @db.Decimal(20, 6)
  arDetails      Json
  apDetails      Json
  builtAt        DateTime @default(now())

  @@unique([organizationId, asOf])
  @@index([organizationId, asOf])
}

// =============================================================================
// D4-3 — Transactional outbox for domain events
// =============================================================================

/// Outbox row written inside the same $transaction as the business write, so
/// events never get lost on commit failure and never fire on rollback. The
/// OutboxWorker polls pending rows and dispatches them to handlers.
model EventOutbox {
  id             String    @id @default(uuid())
  organizationId String
  eventName      String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?
  /// D4-3 / Multi-instance safety: a uuid set by the worker when it claims a
  /// row. Two workers that read the same pending row will see the same claim
  /// token; the UPDATE ... WHERE claimToken = ? pattern guarantees only one
  /// wins. Cleared on success.
  claimToken     String?
  claimedAt      DateTime?
  createdAt      DateTime  @default(now())
  shippedAt      DateTime?

  @@index([status, createdAt])
  @@index([organizationId, status])
}

// =============================================================================
// Phase F.5 — Notifications (in-app, email, SMS, push)
// =============================================================================

enum NotificationChannel {
  in_app
  email
  sms
  push
}

enum NotificationStatus {
  pending
  sent
  failed
  read
}

/// A user-facing notification. In-app notifications are always written; the
/// optional channel push is best-effort (worker dispatches email/SMS/push via
/// the configured provider).
model Notification {
  id             String              @id @default(uuid())
  organizationId String
  /// Null when the notification targets a whole org (e.g. system maintenance).
  userId         String?
  channel        NotificationChannel @default(in_app)
  category       String              @default("general")
  title          String
  body           String
  payload        Json                @default("{}")
  status         NotificationStatus  @default(pending)
  /// When the in-app notification was acknowledged.
  readAt         DateTime?
  /// When the channel delivery succeeded.
  sentAt         DateTime?
  /// Failure reason (provider response, etc.).
  error          String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, userId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId, readAt])
}

/// User-level notification preferences. Falls back to org defaults when
/// missing. Per-channel opt-out; per-category frequency caps.
model NotificationPreference {
  id             String              @id @default(uuid())
  organizationId String
  userId         String
  channel        NotificationChannel
  category       String              @default("general")
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, userId, channel, category])
  @@index([organizationId])
}

// =============================================================================
// Phase F.5 — File storage abstraction
// =============================================================================

enum FileVisibility {
  private
  org
  public
}

/// Logical file record. The bytes live in the configured storage driver (local
/// disk in dev, S3-compatible in prod). Download is via short-lived signed URL.
model File {
  id             String         @id @default(uuid())
  organizationId String
  uploadedById   String?
  filename       String
  contentType    String
  byteSize       Int
  storageKey     String         @unique
  visibility     FileVisibility @default(private)
  /// Free-form owner pointer (e.g. "Partner:abc" or "Expense:xyz").
  ownerType      String?
  ownerId        String?
  checksum       String?
  /// Internal: encrypted-at-rest (provider-side or app-side).
  encrypted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?

  documentAttachments DocumentAttachment[]

  // School vertical (P0.3): student/applicant paperwork goes through the
  // platform file service rather than a bare fileUrl string, so birth
  // certificates and medical records inherit its access control and checksums.
  studentDocuments     StudentDocument[]     @relation("studentDocuments")
  applicationDocuments ApplicationDocument[] @relation("applicationDocuments")
  schoolDocs           SchoolDoc[]           @relation("schoolDocFile")
  schoolDocSignatures  SchoolDoc[]           @relation("schoolDocSignature")

  @@index([organizationId, ownerType, ownerId])
  @@index([organizationId, createdAt])
}

// =============================================================================
// Phase F.5 — Password reset / email verification
// =============================================================================

enum OneTimeTokenPurpose {
  password_reset
  email_verification
  invite
}

/// Generic one-time-use token with TTL. Replaces the previous "abuse of
/// IdempotencyRecord" pattern with a dedicated, typed table.
model OneTimeToken {
  id             String              @id @default(uuid())
  organizationId String?
  userId         String?
  /// SHA-256 hash of the presented token. The raw token is sent to the user.
  tokenHash      String              @unique
  purpose        OneTimeTokenPurpose
  expiresAt      DateTime
  consumedAt     DateTime?
  /// Optional context (e.g. IP that requested the reset).
  payload        Json                @default("{}")
  createdAt      DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// =============================================================================
// Phase F.5 — Approvals (generic, state machine driven)
// =============================================================================

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

/// A request awaiting decision(s). Each ApprovalRequest can require N
/// approvals from N distinct approvers (e.g. 2-of-3). Configurable per
/// document type via ApprovalPolicy.
model ApprovalRequest {
  id             String         @id @default(uuid())
  organizationId String
  /// What is being approved, e.g. "expense:123" or "vendor_bill:abc".
  entityType     String
  entityId       String
  /// Free-form snapshot for the UI (amount, partner, etc.).
  snapshot       Json
  policyId       String?
  /// F.5b — which ordered workflow drives this request (null = legacy policy-driven).
  workflowId     String?
  /// Cursor: the stepOrder currently awaiting decisions.
  currentStep    Int            @default(1)
  status         ApprovalStatus @default(pending)
  requiredCount  Int            @default(1)
  decidedAt      DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  policy    ApprovalPolicy?    @relation(fields: [policyId], references: [id])
  workflow  ApprovalWorkflow?  @relation(fields: [workflowId], references: [id])
  decisions ApprovalDecision[]

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status])
}

model ApprovalDecision {
  id             String         @id @default(uuid())
  organizationId String
  requestId      String
  approverId     String
  /// Which workflow step this decision satisfied (matches ApprovalRequest.currentStep at decision time).
  stepOrder      Int            @default(1)
  status         ApprovalStatus
  comment        String?
  decidedAt      DateTime       @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepOrder, approverId])
  @@index([organizationId])
}

/// @deprecated F.5b — superseded by ApprovalWorkflow + ApprovalStep. Kept for
/// backward-compat / data-migration source; the engine no longer reads it.
/// Per-org rules for which documents require approval, who decides, and how
/// many approvals are needed.
model ApprovalPolicy {
  id                  String   @id @default(uuid())
  organizationId      String
  name                String
  entityType          String
  /// Optional amount threshold above which approval is required.
  minAmount           Decimal? @db.Decimal(20, 6)
  /// Permissions required to act as an approver.
  approverPermissions String[] @default([])
  requiredCount       Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  requests ApprovalRequest[]

  @@index([organizationId, entityType, isActive])
}

// =============================================================================
// Phase F.5b — Multi-step approval workflows (sequential chains + amount bands)
// =============================================================================

/// Ordered approval chain for an entityType. Supersedes ApprovalPolicy.
/// A request must clear every step whose [minAmount, maxAmount) band contains
/// the document amount, in stepOrder order.
model ApprovalWorkflow {
  id                       String   @id @default(uuid())
  organizationId           String
  name                     String
  entityType               String
  /// Whole workflow applies only if amount >= this (null = any amount).
  minAmount                Decimal? @db.Decimal(20, 6)
  /// SoD: block an approver from deciding more than one step of the same request.
  enforceDistinctApprovers Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  @@index([organizationId, entityType, isActive])
}

model ApprovalStep {
  id                  String   @id @default(uuid())
  organizationId      String
  workflowId          String
  stepOrder           Int
  name                String
  /// Any-of; permissions allowed to decide this step.
  approverPermissions String[] @default([])
  /// N-of-M distinct approvers required within this step.
  requiredCount       Int      @default(1)
  /// Step is active only when amount is in [minAmount, maxAmount).
  minAmount           Decimal? @db.Decimal(20, 6)
  maxAmount           Decimal? @db.Decimal(20, 6)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@index([organizationId, workflowId])
}

// =============================================================================
// Phase F.5 — Recurring documents (invoices / expenses)
// =============================================================================

enum RecurringFrequency {
  daily
  weekly
  monthly
  quarterly
  yearly
}

enum RecurringStatus {
  active
  paused
  ended
}

model RecurringDocument {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  /// sales_invoice | vendor_bill | credit_note
  documentType   DocumentType
  /// Template payload (partnerId, lines, etc.). Generated children copy from this.
  template       Json
  frequency      RecurringFrequency
  /// Next date a child should be generated (UTC midnight).
  nextRunAt      DateTime
  /// Last successfully generated child (for back-fill detection).
  lastRunAt      DateTime?
  endDate        DateTime?
  status         RecurringStatus    @default(active)
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  runs RecurringDocumentRun[]

  @@index([organizationId, status, nextRunAt])
}

model RecurringDocumentRun {
  id             String    @id @default(uuid())
  organizationId String
  recurringId    String
  scheduledFor   DateTime
  /// When the worker actually ran this slot.
  ranAt          DateTime?
  documentId     String? // -> Document.id when generated
  status         String    @default("pending") // pending | generated | failed | skipped
  error          String?

  recurring RecurringDocument @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, scheduledFor])
  @@index([organizationId, status, scheduledFor])
}

// =============================================================================
// Phase F.5 — Outbound webhooks
// =============================================================================

enum WebhookEventStatus {
  pending
  succeeded
  failed
  dead
}

/// Outbound webhook delivery. Signed (HMAC-SHA256) so receivers can verify
/// origin. Retries with exponential backoff up to N attempts.
model WebhookEndpoint {
  id             String    @id @default(uuid())
  organizationId String
  url            String
  /// Events to subscribe to. Empty array = all events.
  events         String[]  @default([])
  /// HMAC secret used to sign deliveries (rotated by creating a new endpoint).
  signingSecret  String
  isActive       Boolean   @default(true)
  description    String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  deliveries WebhookDelivery[]

  @@index([organizationId, isActive])
}

model WebhookDelivery {
  id             String             @id @default(uuid())
  organizationId String
  endpointId     String
  eventName      String
  payload        Json
  status         WebhookEventStatus @default(pending)
  attempts       Int                @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  succeededAt    DateTime?
  responseStatus Int?
  responseBody   String?
  error          String?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextAttemptAt])
  @@index([endpointId])
}

// =============================================================================
// Phase F.5 — Per-tenant feature flags
// =============================================================================

/// Sparse flag table: a row exists only when the flag is explicitly enabled.
/// Absence = default (off). The vertical scaffolding sets these per tenant
/// during onboarding or via the in-app "Modules" page.
model FeatureFlag {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  enabled        Boolean  @default(true)
  /// Optional JSON payload (e.g. limit overrides).
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// =============================================================================
// Phase F.5 — Saved reports / scheduled report runs
// =============================================================================

model SavedReport {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  /// e.g. "trial-balance", "ar-aging", "profit-and-loss".
  reportKey      String
  /// Free-form parameter snapshot (period, accountIds, etc.).
  parameters     Json     @default("{}")
  schedule       String? // cron expression, optional
  /// CSV | PDF | both.
  format         String   @default("csv")
  emailTo        String[] @default([])
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runs SavedReportRun[]

  @@index([organizationId, reportKey])
}

model SavedReportRun {
  id             String    @id @default(uuid())
  organizationId String
  reportId       String
  scheduledFor   DateTime
  ranAt          DateTime?
  status         String    @default("pending") // pending | running | succeeded | failed
  fileId         String? // -> File.id (CSV or PDF)
  error          String?

  report SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, scheduledFor])
}

// =============================================================================
// Phase F.5 — Vertical module enablement per organization
// =============================================================================

model OrganizationModule {
  id             String    @id @default(uuid())
  organizationId String
  moduleName     String // 'pos' | 'school' | 'hospital' | …
  isActive       Boolean   @default(true)
  /// Per-tenant config (e.g. POS: enableTips, school: enableBoarding).
  config         Json      @default("{}")
  enabledAt      DateTime  @default(now())
  disabledAt     DateTime?

  @@unique([organizationId, moduleName])
  @@index([organizationId, isActive])
}

// =============================================================================
// Phase F.6 — Procurement chain (PR → RFQ → PO → GRN → Bill)
// =============================================================================

enum PurchaseRequestStatus {
  draft
  submitted
  approved
  rejected
  cancelled
  converted // converted to one or more POs
}

enum PurchaseOrderStatus {
  draft
  submitted
  approved
  sent // sent to supplier
  acknowledged
  partially_received
  received
  billed
  closed
  cancelled
  /// Simplified flow: PO is live and awaiting receipt.
  active
}

enum PaymentType {
  cash
  credit
}

enum GoodsReceiptStatus {
  draft
  posted
  cancelled
}

enum MatchStatus {
  pending
  matched
  partial
  mismatch
  blocked
}

enum DebitNoteReason {
  price_adjustment
  returned_goods
  overcharge
  correction
  other
}

/// A request for goods or services. Not a financial document — drives PO
/// creation once approved. May have multiple lines (product / qty / desired
/// delivery / estimated price). Workflow: draft → submitted → approved →
/// converted (to one or more POs).
model PurchaseRequest {
  id             String                @id @default(uuid())
  organizationId String
  requestNumber  String
  requestedById  String?
  partnerId      String? // preferred supplier (optional)
  branchId       String?
  description    String?
  neededBy       DateTime?
  status         PurchaseRequestStatus @default(draft)
  approvedAt     DateTime?
  approvedById   String?
  rejectedReason String?
  /// Free-form JSON snapshot of the request at submit time (for audit).
  snapshot       Json?
  customFields   Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  lines     PurchaseRequestLine[]
  orders    PurchaseOrder[]
  createdBy String?
  updatedBy String?

  partner Partner? @relation("PurchaseRequest_partner", fields: [partnerId], references: [id], onDelete: SetNull)
  branch  Branch?  @relation("PurchaseRequest_branch", fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@index([organizationId, neededBy])
}

model PurchaseRequestLine {
  id                 String   @id @default(uuid())
  organizationId     String
  purchaseRequestId  String
  productId          String?
  description        String
  quantity           Decimal  @db.Decimal(20, 6)
  unitOfMeasureId    String?
  estimatedUnitPrice Decimal? @db.Decimal(20, 6)
  notes              String?
  lineNumber         Int      @default(0)

  request PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, purchaseRequestId])
}

/// A purchase order to a supplier. Once approved + sent, it cannot be edited —
/// corrections happen via new revisions. PO is the source of truth for
/// "what we agreed to receive"; the GRN records "what we actually received";
/// the bill records "what the supplier claims". Three-way match reconciles them.
model PurchaseOrder {
  id                   String              @id @default(uuid())
  organizationId       String
  orderNumber          String
  partnerId            String
  branchId             String?
  description          String?
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  currencyCode         String              @default("USD")
  exchangeRate         Decimal             @default(1) @db.Decimal(18, 8)
  subtotal             Decimal             @default(0) @db.Decimal(20, 6)
  taxAmount            Decimal             @default(0) @db.Decimal(20, 6)
  totalAmount          Decimal             @default(0) @db.Decimal(20, 6)
  status               PurchaseOrderStatus @default(active)
  approvedAt           DateTime?
  approvedById         String?
  sentAt               DateTime?
  /// Simple flow: how this PO will be paid.
  paymentType          PaymentType         @default(cash)
  /// Tracks credit-purchase payment status.
  paymentStatus        PaymentStatus?      @default(not_paid)
  totalPaid            Decimal             @default(0) @db.Decimal(20, 6)
  /// Optimistic lock version — incremented on every write. Used by the
  /// service layer to detect concurrent edits and prevent lost updates.
  version              Int                 @default(0)
  notes                String?
  terms                String?
  /// Free-form snapshot at approve/send for audit.
  snapshot             Json?
  customFields         Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  requestId     String? // PR that drove this PO (nullable: ad-hoc POs allowed)
  parentOrderId String? // revision chain

  lines         PurchaseOrderLine[]
  receipts      GoodsReceiptNote[]
  bills         VendorBillLink[] // via join table to support multiple partial bills
  matchStatuses ThreeWayMatch[]
  payments      PurchasePayment[]
  createdBy     String?
  updatedBy     String?

  request PurchaseRequest? @relation(fields: [requestId], references: [id])

  partner Partner? @relation("PurchaseOrder_partner", fields: [partnerId], references: [id], onDelete: Restrict)
  branch  Branch?  @relation("PurchaseOrder_branch", fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, orderNumber])
  @@index([organizationId, partnerId])
  @@index([organizationId, status])
  @@index([organizationId, orderDate])
}

/// A payment recorded against a purchase order (for credit purchases). Each
/// payment partially or fully settles the PO's outstanding balance.
model PurchasePayment {
  id              String   @id @default(uuid())
  organizationId  String
  purchaseOrderId String
  amount          Decimal  @db.Decimal(20, 6)
  paidAt          DateTime @default(now())
  paidById        String?
  reference       String? // e.g. transaction ID, cheque number
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, paidAt])
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  organizationId   String
  purchaseOrderId  String
  productId        String?
  description      String
  quantity         Decimal @db.Decimal(20, 6)
  receivedQuantity Decimal @default(0) @db.Decimal(20, 6) // running total
  billedQuantity   Decimal @default(0) @db.Decimal(20, 6)
  unitOfMeasureId  String?
  unitPrice        Decimal @db.Decimal(20, 6)
  taxRate          Decimal @default(0) @db.Decimal(9, 6)
  taxId            String?
  subtotal         Decimal @default(0) @db.Decimal(20, 6)
  lineNumber       Int     @default(0)
  notes            String?
  /// Optimistic lock version.
  version          Int     @default(0)

  order    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receipts GoodsReceiptLine[]

  @@index([organizationId, purchaseOrderId])
}

/// A goods receipt note — what was actually received against a PO. Each GRN
/// line references the PO line it fulfilled. Posting the GRN issues stock-in
/// moves to the warehouse via the existing StockService.receive().
model GoodsReceiptNote {
  id              String             @id @default(uuid())
  organizationId  String
  receiptNumber   String
  purchaseOrderId String?
  partnerId       String?
  branchId        String?
  warehouseId     String? // location where goods arrived
  receivedAt      DateTime           @default(now())
  status          GoodsReceiptStatus @default(draft)
  notes           String?
  postedAt        DateTime?
  postedById      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  lines     GoodsReceiptLine[]
  order     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  warehouse InventoryLocation? @relation(fields: [warehouseId], references: [id])
  branch    Branch?            @relation("GoodsReceipt_branch", fields: [branchId], references: [id], onDelete: SetNull)
  createdBy String?
  updatedBy String?

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, status])
}

model GoodsReceiptLine {
  id                  String    @id @default(uuid())
  organizationId      String
  goodsReceiptId      String
  purchaseOrderLineId String?
  productId           String?
  description         String
  quantity            Decimal   @db.Decimal(20, 6)
  unitCost            Decimal   @default(0) @db.Decimal(20, 6)
  batchNumber         String?
  expiryDate          DateTime?
  notes               String?
  lineNumber          Int       @default(0)

  receipt GoodsReceiptNote   @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLine  PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([organizationId, goodsReceiptId])
}

/// Links a vendor bill (Document of type vendor_bill) to one or more POs. A
/// single bill can be split across POs (e.g. consolidated monthly statement).
model VendorBillLink {
  id              String   @id @default(uuid())
  organizationId  String
  vendorBillId    String // -> Document.id
  purchaseOrderId String
  amount          Decimal  @db.Decimal(20, 6) // portion of the bill allocated to this PO
  notes           String?
  createdAt       DateTime @default(now())

  order PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([vendorBillId, purchaseOrderId])
  @@index([organizationId, vendorBillId])
  @@index([organizationId, purchaseOrderId])
}

/// Computed three-way match result per PO line. Updated whenever a GRN is
/// posted or a bill is linked. Status determines whether AP can post the bill.
model ThreeWayMatch {
  id                  String      @id @default(uuid())
  organizationId      String
  purchaseOrderId     String
  purchaseOrderLineId String
  productId           String?
  /// Quantities snapshot at last computation.
  orderedQuantity     Decimal     @db.Decimal(20, 6)
  receivedQuantity    Decimal     @default(0) @db.Decimal(20, 6)
  billedQuantity      Decimal     @default(0) @db.Decimal(20, 6)
  /// Price snapshot.
  orderedUnitPrice    Decimal     @db.Decimal(20, 6)
  billedUnitPrice     Decimal?    @db.Decimal(20, 6)
  /// Variances (positive = over-billed/over-received).
  quantityVariance    Decimal     @default(0) @db.Decimal(20, 6)
  priceVariance       Decimal     @default(0) @db.Decimal(20, 6)
  /// Computed: matched / partial / mismatch / blocked.
  status              MatchStatus @default(pending)
  /// Variance threshold per org (absolute quantity + price %). When the
  /// variance exceeds the threshold, the bill cannot be posted without
  /// explicit approval (status=blocked).
  thresholdExceeded   Boolean     @default(false)
  notes               String?
  lastCheckedAt       DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  order PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderLineId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, status])
}

/// Debit note — issued to a customer (or received from a supplier) to
/// INCREASE the amount owed. Use cases:
///   - Customer underpaid → debit note increases their AR
///   - Supplier overcharged → supplier-issued debit note reduces our AP
/// The direction is "outbound" when WE issue (customer AR +), "inbound" when
/// we RECEIVE one (vendor AP +).
model DebitNote {
  id             String          @id @default(uuid())
  organizationId String
  noteNumber     String
  /// 'outbound' = we issued to a customer (increases AR)
  /// 'inbound'  = received from a supplier (increases AP / decreases expense)
  direction      String          @default("outbound")
  partnerId      String
  /// Optional: linked customer invoice (outbound) or vendor bill (inbound)
  documentId     String?
  reason         DebitNoteReason @default(other)
  reasonNote     String?
  issueDate      DateTime        @default(now())
  currencyCode   String          @default("USD")
  exchangeRate   Decimal         @default(1) @db.Decimal(18, 8)
  subtotal       Decimal         @default(0) @db.Decimal(20, 6)
  taxAmount      Decimal         @default(0) @db.Decimal(20, 6)
  totalAmount    Decimal         @default(0) @db.Decimal(20, 6)
  status         String          @default("draft") // draft | posted | cancelled
  postedAt       DateTime?
  postedById     String?
  notes          String?
  customFields   Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  lines     DebitNoteLine[]
  partner   Partner?        @relation("DebitNote_partner", fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy String?
  updatedBy String?

  @@unique([organizationId, noteNumber])
  @@index([organizationId, partnerId])
  @@index([organizationId, direction, status])
}

model DebitNoteLine {
  id             String  @id @default(uuid())
  organizationId String
  debitNoteId    String
  productId      String?
  description    String
  quantity       Decimal @db.Decimal(20, 6)
  unitPrice      Decimal @db.Decimal(20, 6)
  taxId          String?
  taxAmount      Decimal @default(0) @db.Decimal(20, 6)
  subtotal       Decimal @default(0) @db.Decimal(20, 6)
  total          Decimal @default(0) @db.Decimal(20, 6)
  lineNumber     Int     @default(0)
  notes          String?

  debitNote DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@index([organizationId, debitNoteId])
}

// =============================================================================
// Phase F.6 — Push notification subscriptions (web push)
// =============================================================================

model PushSubscription {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  /// Web Push endpoint URL (from PushSubscription.endpoint).
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?

  @@index([organizationId, userId])
}

// =============================================================================
// Phase F.6 — Audit log persistence helpers (immutable journal event log)
// =============================================================================

/// A non-undoable ledger of all material domain events. Backed by an
/// append-only Postgres table (no UPDATE / DELETE allowed at the DB level
/// via a trigger installed in the migration). Separate from AuditLog because
/// AuditLog is fine for UI display; this table is the SOX / IFRS audit-trail.
model DomainEventLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String
  eventName      String
  entityType     String
  entityId       String
  actorId        String?
  payload        Json
  occurredAt     DateTime @default(now())

  @@index([organizationId, occurredAt])
  @@index([organizationId, entityType, entityId])
}

// =============================================================================
// Phase F.7 — CRM pipeline (deals, activities, tasks)
// =============================================================================

enum DealStage {
  lead
  qualified
  proposal
  negotiation
  won
  lost
}

enum ActivityType {
  call
  email
  meeting
  note
  task
  deal_stage_change
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

/// A deal in the sales pipeline. Linked to a customer Partner; optional PO/Invoice
/// links can be added later via customFields.
model Deal {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  partnerId      String
  ownerId        String? // User.id of the salesperson
  stage          DealStage @default(lead)
  amount         Decimal   @default(0) @db.Decimal(20, 6)
  currencyCode   String    @default("USD")
  expectedClose  DateTime?
  notes          String?
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  partner    Partner?   @relation("PartnerDeals", fields: [partnerId], references: [id], onDelete: Restrict)
  activities Activity[] @relation("DealActivities")

  @@index([organizationId, stage])
  @@index([organizationId, partnerId])
  @@index([organizationId, ownerId])
}

/// A logged activity: call, email, meeting, note, task, deal stage change.
/// Universal timeline that powers the customer 360 view.
model Activity {
  id             String       @id @default(uuid())
  organizationId String
  type           ActivityType
  /// Free-form polymorphic subject: deal, partner, invoice, etc.
  subjectType    String?
  subjectId      String?
  dealId         String?
  partnerId      String?
  /// When this activity happened (user-entered for past activities).
  occurredAt     DateTime     @default(now())
  duration       Int? // minutes (for calls/meetings)
  title          String
  body           String?
  completed      Boolean      @default(false)
  completedAt    DateTime?
  /// Optional task deadline when type='task'.
  dueAt          DateTime?
  status         TaskStatus   @default(todo)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  deal    Deal?    @relation("DealActivities", fields: [dealId], references: [id], onDelete: Cascade)
  partner Partner? @relation("PartnerActivities", fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, dealId])
  @@index([organizationId, partnerId])
  @@index([organizationId, dueAt])
  @@index([organizationId, status])
}

// ============================================================================
// POS Phase T1 — Tables Management (ADR-012).
//
// A PosTable is a physical seat (e.g. "Table 7 / VIP 01"). A PosTableOrder
// is the live link between a table and the open Document(s) currently being
// rung up on it; when the sale is tendered the Document is closed and the
// PosTableOrder row is marked closed. PosTableReservation captures bookings
// (with party size + time window) and drives automatic status flips from
// 'available' → 'reserved' → 'occupied'.
//
// Money still flows through `Document` / `Payment` / `KitchenTicket` — these
// three tables are operational metadata only. Hard delete is forbidden;
// `active=false` is the archive marker so history / audit stays intact.
// ============================================================================

enum PosTableStatus {
  available
  occupied
  reserved
  out_of_service
  cleaning
}

enum PosTableShape {
  square
  rectangle
  circle
}

enum PosReservationStatus {
  pending
  seated
  completed
  cancelled
  no_show
}

/// Per-organization dining area / table category (Indoor, Outdoor, Rooftop, ...).
/// `PosTable.zone` stores the zone `key` (stable slug). Config master — soft
/// deleted; a zone with active tables cannot be archived (409).
model PosTableZone {
  id             String    @id @default(uuid())
  organizationId String
  /// Stable slug referenced by PosTable.zone. Unique per org. Seeded values
  /// keep the legacy enum names ('indoor', 'outdoor', ...) so existing rows
  /// mapped 1:1 during the configurable-zones migration.
  key            String
  /// Human display label, e.g. "Indoor", "Rooftop Lounge".
  name           String
  /// Display order for the floor map + picker; lower sorts first, ties by name.
  sortOrder      Int       @default(0)
  /// Hex color for zone dots / chips (inline style — Tailwind cannot do
  /// dynamic class names, so colors are stored as raw hex).
  color          String    @default("#10b981")
  active         Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  @@unique([organizationId, key])
  @@index([organizationId, deletedAt])
  @@index([organizationId, sortOrder])
}

/// A physical table or seat group in the venue. Lifecycle: status field.
/// Soft-archive via `active=false`; rows are NEVER hard-deleted (FK from
/// PosTableOrder / PosTableReservation is `onDelete: Restrict`).
model PosTable {
  id               String         @id @default(uuid())
  organizationId   String
  /// Human display label, e.g. "Table 1", "VIP 01", "Patio 3".
  name             String
  /// Stable, cashier-readable identifier. Unique per org — the server uses
  /// this for "T<n>" badges in the terminal UI.
  number           Int
  /// Manual display order for the floor map; lower sorts first, ties broken by `number`.
  sortOrder        Int            @default(0)
  /// Number of seats (chairs). 0 = standing / counter spot.
  seats            Int            @default(2)
  /// Zone (dining area) this table belongs to — key of a PosTableZone row
  /// (e.g. 'indoor'). Configurable per organization via PosTableZonesService.
  zone             String         @default("indoor")
  /// Floor-plan geometry. Persisted so the layout survives a reload; the
  /// visual editor (next iteration) reads + writes these columns.
  shape            PosTableShape  @default(square)
  posX             Int            @default(40)
  posY             Int            @default(40)
  width            Int            @default(120)
  height           Int            @default(120)
  /// Current lifecycle state. Driven by PosTablesService; auto-flipped by
  /// reservations (pending → reserved) and by payment (occupied → dirty).
  status           PosTableStatus @default(available)
  notes            String?
  active           Boolean        @default(true)
  /// Waiter responsible for this table (free-form assignment; null = pool).
  assignedWaiterId String?
  /// URL for the table's QR code (used by seated guests to view menu / call waiter).
  qrCodeUrl        String?
  /// Self-FK: when this table was merged into another, points to the target
  /// table. `null` when not merged.
  mergedIntoId     String?
  mergedAt         DateTime?
  mergedById       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String?
  updatedBy        String?

  mergedInto   PosTable?             @relation("PosTableMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   PosTable[]            @relation("PosTableMerge")
  orders       PosTableOrder[]
  reservations PosTableReservation[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, zone])
  @@index([organizationId, active])
}

/// Live link between a table and the open Order being rung up on it.
/// One open sale == one row. `closedAt` is set when the Order is billed/closed so
/// reports can compute occupancy time. `@@unique([tableId, orderId])`
/// guarantees we can't double-link the same order.
model PosTableOrder {
  id             String    @id @default(uuid())
  organizationId String
  tableId        String
  /// The open tab Order rung up on this table. Nullable so historical occupancy
  /// rows (migrated from the legacy Document-linked tabs) survive without a link.
  orderId        String?
  /// Snapshot of customer info shown in the table picker (e.g. "Sarah, 4 pax").
  /// Not a hard FK — the customer may be a walk-in (no Partner record).
  customerName   String?
  guestCount     Int?
  /// Wall-clock the table was opened (first item rang). Used by reports for
  /// "average dining time".
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  /// Free-form waiter / cashier note shown in the order panel.
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  table PosTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  order Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([tableId, orderId])
  @@index([organizationId])
  @@index([organizationId, tableId, closedAt])
  @@index([organizationId, orderId])
  @@index([organizationId, openedAt])
}

/// A booking. When `status='seated'` the linked table flips to OCCUPIED and
/// an empty Order is opened (no items yet) so the cashier can start ringing.
/// The reservation worker flips `pending → no_show` after a 30-minute grace.
model PosTableReservation {
  id             String               @id @default(uuid())
  organizationId String
  tableId        String
  customerName   String
  phone          String?
  email          String?
  partySize      Int                  @default(2)
  /// Reservation start (guests expected to arrive).
  startAt        DateTime
  /// Reservation end (table must be freed for the next booking).
  endAt          DateTime
  status         PosReservationStatus @default(pending)
  notes          String?
  /// When the guest was seated; null until then.
  seatedAt       DateTime?
  /// Set when the guest is flagged as no-show by the worker.
  noShowAt       DateTime?
  cancelledAt    DateTime?
  /// Optional ref to the Order that was opened when the reservation was seated.
  /// Lets the cashier jump from the reservation list straight to the open ticket.
  seatedOrderId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdBy      String?
  updatedBy      String?

  table PosTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, tableId])
  @@index([organizationId, status, startAt])
  @@index([organizationId, startAt])
}

// ============================================================================
// POS — Order → Invoice → Receipt domain (DDD split).
//
// The operational Order is separate from the financial Invoice (Document):
//   Order   — what the customer is ordering (draft/open lifecycle, KOT,
//             table/waiter assignment). No GL/stock/cash effect while editing.
//   Invoice — the Document (sales_invoice) generated at bill time; inventory is
//             deducted and GL (AR) is posted then.
//   Receipt — typed print/issue log generated from a paid or credit invoice.
//
// Order numbers (ORD-YYYYMMDD-NNNNNN) are assigned at creation; Invoice numbers
// (INV-YYYY-NNNNNN) only at bill generation.
// ============================================================================

enum OrderType {
  dine_in
  takeaway
  delivery
}

/// Domain-neutral order lifecycle. An `Order` is the operational document for
/// ANY vertical (café, retail, rental, repair, manufacturing) — kitchen-specific
/// states live on `KitchenTicket.status` (`KdsTicketStatus`), not here.
///
/// Canonical states:
///   draft       — not yet confirmed (quotation landing state; see P5)
///   confirmed   — accepted, fulfillment not started
///   in_progress — at least one fulfillment document is active
///   completed   — fulfillment done, or the bill has been generated
///   closed      — invoice fully settled (terminal)
///   cancelled   — terminal
///
/// `open`/`preparing`/`served` are LEGACY aliases kept only for the Android
/// wire-compat window (deployed APKs still send/expect them). `ready` was never
/// written by any code path. All four are dropped by the cleanup migration one
/// release after the compat window closes — do not write them in new code.
/// Value order below matches the physical Postgres enum order.
enum OrderStatus {
  draft
  confirmed
  in_progress
  completed
  open
  preparing
  ready
  served
  closed
  cancelled
}

enum OrderItemKitchenStatus {
  pending
  sent
  preparing
  ready
  served
}

/// How an Invoice (Document) is/was settled. `credit` = postpaid house account.
enum InvoicePaymentMode {
  cash
  card
  mobile_money
  mixed
  credit
}

/// Settlement lifecycle, independent of the cash balance. For credit invoices
/// this is driven by accounting (AR), not by payment.
enum InvoiceSettlementStatus {
  unsettled
  partially_settled
  settled
  written_off
}

/// Receipt kind. A single invoice can produce several receipts over its life
/// (e.g. a credit-issue receipt at bill time, then a settlement receipt later).
enum ReceiptType {
  payment_receipt
  partial_payment_receipt
  credit_issue_receipt
  settlement_receipt
  merchant_copy
  reprint
}

/// Discount scope: line-item vs invoice-level.
enum DiscountType {
  percentage
  fixed_amount
}

/// Where a discount originated.
enum DiscountSource {
  manual
  promotion
  loyalty
  coupon
  customer_discount
  group_discount
  membership_discount
  global_promotion
}

/// Operational order — the restaurant-ops aggregate root. Created immediately
/// when the customer starts ordering; carries the kitchen + table lifecycle.
/// Billing is deferred: `invoiceId` is set only when the bill is generated.
/// `version` enables optimistic locking against concurrent edits.
model Order {
  id                         String         @id @default(uuid())
  organizationId             String
  orderNumber                String
  orderType                  OrderType      @default(dine_in)
  status                     OrderStatus    @default(confirmed)
  /// Transaction-kind axis (reporting): which module owns this order — `sale`
  /// (core), `rental`, `repair`, … Phase D turned this from the `SaleKind` enum
  /// into a free-text module code, validated at write time against the order
  /// kinds each module contributes via its manifest (ADR-005). Adding a vertical
  /// no longer means editing a shared enum. The service-mode axis stays on
  /// `orderType` (dine_in/takeaway/delivery).
  transactionKind            String         @default("sale")
  /// Polymorphic back-reference to the document that spawned this order (Phase D):
  /// `sourceDocumentType` is the module's code (`rental_agreement`, `repair_order`,
  /// …) and `sourceDocumentId` the row id. Replaces the per-vertical
  /// `rentalAgreementId` / `repairOrderId` columns, so a new vertical adds no new
  /// column. Precedent: `StockReservation.sourceType`/`sourceId`.
  sourceDocumentType         String?
  sourceDocumentId           String?
  /// @deprecated (Phase D) Superseded by `sourceDocumentType`/`sourceDocumentId`.
  /// Still dual-written for one release so any out-of-tree reader keeps working;
  /// dropped by the P1.6 cleanup migration.
  rentalAgreementId          String?
  /// @deprecated (Phase D) Superseded by `sourceDocumentType`/`sourceDocumentId`.
  repairOrderId              String?
  /// Loose refs (no FK) to keep the aggregate decoupled — mirrors the existing
  /// PosHold / Document.tableId pattern. Integrity enforced in the service layer.
  tableId                    String?
  partnerId                  String?
  /// Loose ref to the org's PaymentTerm master (no FK, like partnerId). Drives
  /// the invoice due-date derivation at bill time; the term is copied onto the
  /// Invoice when this order is billed.
  paymentTermId              String?
  /// Chosen settlement method for the eventual invoice (InvoicePaymentMode
  /// values: cash/card/mobile_money/mixed/credit). A pre-selection — the
  /// authoritative paymentMode is re-derived from tenders at settlement.
  paymentMethod              String?
  waiterId                   String?
  branchId                   String?
  cashSessionId              String?
  guestCount                 Int?
  notes                      String?
  sortOrder                  Int            @default(0)
  /// Set at bill generation. 1:1 with the financial Document (the Invoice).
  invoiceId                  String?        @unique
  /// Optimistic-lock token. Every item mutation bumps this; writers pass the
  /// expected value so two waiters can't clobber each other.
  version                    Int            @default(0)
  /// Offline-first (P1): number the device printed before sync (e.g. D1-000042).
  /// The final orderNumber is allocated at push; both stay searchable.
  provisionalNumber          String?
  /// Offline-first (P1): PosDevice that captured this order offline.
  deviceId                   String?
  /// Running snapshot of the order total (recomputed on each item change) so
  /// the table picker / order panel render without re-pricing.
  subtotal                   Decimal        @default(0) @db.Decimal(20, 6)
  discountTotal              Decimal        @default(0) @db.Decimal(20, 6)
  taxAmount                  Decimal        @default(0) @db.Decimal(20, 6)
  totalAmount                Decimal        @default(0) @db.Decimal(20, 6)
  /// Order-level discount (%) applied on top of line discounts at bill time.
  transactionDiscountPercent Decimal        @default(0) @db.Decimal(9, 4)
  transactionDiscountType    DiscountType   @default(percentage)
  transactionDiscountAmount  Decimal        @default(0) @db.Decimal(20, 6)
  discountReason             String?
  discountSource             DiscountSource @default(manual)
  openedAt                   DateTime       @default(now())
  closedAt                   DateTime?
  cancelledAt                DateTime?
  cancelReason               String?
  cancelledBy                String?
  /// @deprecated (Phase B) No longer written. The kitchen timeline is projected
  /// from `DomainEventLog` fulfillment facts as milestones — these columns had
  /// zero readers and were nulled on recall, destroying history. Dropped by the
  /// P1.6 cleanup migration.
  kitchenStartedAt           DateTime?
  kitchenStartedBy           String?
  kitchenCompletedAt         DateTime?
  kitchenCompletedBy         String?
  /// Bill / KOT print lifecycle for the OPEN tab (pre-settle). Receipt counters
  /// live on the Invoice once the tab is billed. Replaces the former
  /// Document.billPrintCount / kotPrintCount for POS tabs.
  billPrintCount             Int            @default(0)
  billLastPrintedAt          DateTime?
  kotPrintCount              Int            @default(0)
  lastPrintedById            String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  createdBy                  String?
  updatedBy                  String?

  items          OrderItem[]
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  posTableOrders PosTableOrder[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, tableId, status])
  @@index([organizationId, cashSessionId])
  @@index([organizationId, sourceDocumentType, sourceDocumentId])
}

/// A line on an Order. Carries its own kitchen lifecycle (each item can be
/// pending → sent → preparing → ready → served independently) and cancellation
/// flag (items can be voided before billing). Pricing mirrors DocumentLine.
model OrderItem {
  id                     String                 @id @default(uuid())
  organizationId         String
  orderId                String
  productId              String?
  menuItemId             String?
  comboId                String?
  variantId              String?
  variantName            String?
  description            String
  quantity               Decimal                @default(1) @db.Decimal(20, 6)
  unitPrice              Decimal                @default(0) @db.Decimal(20, 6)
  discountPercent        Decimal                @default(0) @db.Decimal(9, 4)
  discountType           DiscountType           @default(percentage)
  discountAmount         Decimal                @default(0) @db.Decimal(20, 6)
  discountReason         String?
  taxId                  String?
  taxInclusive           Boolean                @default(false)
  note                   String?
  /// Per-item kitchen state for the KDS / order panel.
  kitchenStatus          OrderItemKitchenStatus @default(pending)
  /// Course grouping for fire/hold (1=starter, 2=main, 3=dessert, …). NULL =
  /// uncoursed (fires immediately). Lets a waiter "Fire Main" without re-firing
  /// earlier courses. (P5)
  course                 Int?
  cancelled              Boolean                @default(false)
  cancelledAt            DateTime?
  cancelReason           String?
  voidedBy               String?
  lineNumber             Int                    @default(0)
  /// Free-text snapshot of selected accompaniments (display + KOT).
  accompanimentNames     String[]               @default([])
  /// Rental marker: when set, this line is a rental-fee line of the referenced
  /// RentalAgreementLine — it must NEVER issue stock or post COGS, and never
  /// hold ATP. Lines without it are ordinary sale lines. Rule 2: the
  /// rental/sale distinction is per line, not per order.
  rentalAgreementLineId  String?
  /// Which rental fee this line bills (rental/extension/late/damage/missing).
  rentalFeeType          String?
  /// Repair marker: when set, this line bills a repair order (labour or part
  /// line). Labour lines are service products and never hold ATP; part lines
  /// are real spare-part products and DO relieve stock at bill time.
  repairOrderLineId      String?
  /// Which repair charge this line bills (labour/part).
  repairFeeType          String?
  /// Selected AccompanimentOption ids (structured) so settlement can deplete
  /// each option's inventoryItemId; the names above stay for display/KOT.
  accompanimentOptionIds String[]               @default([])
  /// Kitchen print lifecycle (the order owns the kitchen flow now). Delta KOT
  /// logic compares printed vs current qty.
  kitchenPrintCount      Int                    @default(0)
  kitchenLastPrintedAt   DateTime?
  kitchenPrintedQty      Decimal?               @db.Decimal(20, 6)
  cancelPrintCount       Int                    @default(0)
  cancelLastPrintedAt    DateTime?
  lastKitchenPrintedById String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]

  @@index([organizationId])
  @@index([orderId])
  @@index([menuItemId])
  @@index([productId])
}

/// Structured per-item modifier selection (queryable for reporting), in
/// addition to the priceDelta already folded into OrderItem.unitPrice.
model OrderItemModifier {
  id               String   @id @default(uuid())
  organizationId   String
  orderItemId      String
  modifierId       String?
  name             String
  kitchenPrintName String?
  priceDelta       Decimal  @default(0) @db.Decimal(20, 6)
  createdAt        DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderItemId])
  @@index([modifierId])
}

/// A printed/issued receipt generated FROM an Invoice (Document). Non-financial:
/// it records WHAT was printed and WHEN, not money (money lives on Payment).
/// `type` distinguishes a normal payment receipt from a credit-issue receipt
/// (postpaid sale, no cash yet) or a later settlement receipt.
model Receipt {
  id                String      @id @default(uuid())
  organizationId    String
  invoiceId         String
  receiptNumber     String
  /// Offline-first (P1): number the device printed before sync.
  provisionalNumber String?
  /// Offline-first (P1): PosDevice that issued this receipt offline.
  deviceId          String?
  type              ReceiptType @default(payment_receipt)
  /// The payment this receipt acknowledges (null for credit-issue receipts).
  paymentId         String?
  copies            Int         @default(1)
  printedById       String?
  /// Required for reprints.
  reason            String?
  /// Printer host / station label at print time.
  printer           String?
  createdAt         DateTime    @default(now())

  invoice Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  items   ReceiptItem[]

  @@index([organizationId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, type])
  @@index([receiptNumber])
}

enum InvoiceStatus {
  draft
  posted
  paid
  cancelled
  refunded
}

/// POS financial Invoice — the sales document, fully separate from the generic
/// `Document` ledger. It posts its OWN journal entry (Dr AR / Cr Revenue+Tax)
/// to the shared GL, tracks its own AR balance, and is settled by Payments
/// allocated via PaymentAllocation.invoiceId. Generated from an Order at bill time.
model Invoice {
  id                   String                  @id @default(uuid())
  organizationId       String
  invoiceNumber        String
  /// Offline-first (P1): number the device printed before sync. Final
  /// invoiceNumber is allocated at push; both stay searchable.
  provisionalNumber    String?
  /// Offline-first (P1): PosDevice that captured this sale offline.
  deviceId             String?
  /// The operational Order this invoice was billed from (1:1; back-ref of Order.invoiceId).
  orderId              String?                 @unique
  partnerId            String
  branchId             String?
  cashSessionId        String?
  /// Denormalised for table/waiter revenue reports.
  waiterId             String?
  tableId              String?
  issueDate            DateTime                @default(now())
  dueDate              DateTime?
  currencyId           String?
  exchangeRate         Decimal                 @default(1) @db.Decimal(18, 8)
  subtotal             Decimal                 @default(0) @db.Decimal(20, 6)
  discountTotal        Decimal                 @default(0) @db.Decimal(20, 6)
  discountType         DiscountType            @default(percentage)
  discountValue        Decimal                 @default(0) @db.Decimal(20, 6)
  discountSource       DiscountSource          @default(manual)
  discountReason       String?
  discountAppliedBy    String?
  discountApprovedBy   String?
  discountApprovedAt   DateTime?
  taxAmount            Decimal                 @default(0) @db.Decimal(20, 6)
  totalAmount          Decimal                 @default(0) @db.Decimal(20, 6)
  amountPaid           Decimal                 @default(0) @db.Decimal(20, 6)
  amountResidual       Decimal                 @default(0) @db.Decimal(20, 6)
  /// Cash physically handed over for the settling cash payment (may exceed
  /// totalAmount). Change given = amountTendered − totalAmount. Null on
  /// non-cash tenders and legacy rows; drives the receipt's tendered/change lines.
  amountTendered       Decimal?                @db.Decimal(20, 6)
  /// Cumulative amount refunded across full + partial refunds (over-refund guard).
  amountRefunded       Decimal                 @default(0) @db.Decimal(20, 6)
  refundedBy           String?
  status               InvoiceStatus           @default(draft)
  paymentStatus        PaymentStatus           @default(not_paid)
  paymentMode          InvoicePaymentMode?
  settlementStatus     InvoiceSettlementStatus @default(unsettled)
  /// Loose ref to the org's PaymentTerm master (no FK, like partnerId), copied
  /// from Order.paymentTermId at bill time. Drives the due-date derivation —
  /// which is what makes a credit (pay-later) invoice chaseable.
  paymentTermId        String?
  /// Optimistic-lock token. Bumped on every settlement/refund mutation so two
  /// terminals can't double-settle the same invoice (see PosInvoiceService).
  version              Int                     @default(0)
  /// GL link — the journal entry posted when this invoice was finalised.
  journalEntryId       String?
  reference            String?
  notes                String?
  /// Print lifecycle (bill / receipt counters).
  billPrintCount       Int                     @default(0)
  billLastPrintedAt    DateTime?
  receiptPrintCount    Int                     @default(0)
  receiptLastPrintedAt DateTime?
  kotPrintCount        Int                     @default(0)
  lastPrintedById      String?
  postedAt             DateTime?
  postedBy             String?
  settledBy            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  createdBy            String?
  updatedBy            String?

  order       Order?
  items       InvoiceItem[]
  receipts    Receipt[]
  allocations PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, partnerId])
  @@index([organizationId, settlementStatus])
  @@index([organizationId, tableId])
  @@index([journalEntryId])
}

/// A line on a POS Invoice (mirrors DocumentLine but on the separate Invoice).
model InvoiceItem {
  id                     String         @id @default(uuid())
  organizationId         String
  invoiceId              String
  productId              String?
  menuItemId             String?
  variantId              String?
  variantName            String?
  /// Selected AccompanimentOption ids copied from the order line (stock + audit).
  accompanimentOptionIds String[]       @default([])
  /// Revenue account resolved at posting time (for the GL credit).
  accountId              String?
  description            String
  quantity               Decimal        @default(1) @db.Decimal(20, 6)
  unitPrice              Decimal        @default(0) @db.Decimal(20, 6)
  discountPercent        Decimal        @default(0) @db.Decimal(9, 4)
  discountType           DiscountType   @default(percentage)
  discountAmount         Decimal        @default(0) @db.Decimal(20, 6)
  discountReason         String?
  discountSource         DiscountSource @default(manual)
  discountAppliedBy      String?
  discountApprovedBy     String?
  discountApprovedAt     DateTime?
  taxId                  String?
  taxInclusive           Boolean        @default(false)
  subtotal               Decimal        @default(0) @db.Decimal(20, 6)
  taxAmount              Decimal        @default(0) @db.Decimal(20, 6)
  total                  Decimal        @default(0) @db.Decimal(20, 6)
  /// Cumulative quantity refunded across partial refunds (per-line over-refund guard).
  refundedQty            Decimal        @default(0) @db.Decimal(20, 6)
  lineNumber             Int            @default(0)
  createdAt              DateTime       @default(now())

  invoice   Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  modifiers InvoiceItemModifier[]

  @@index([organizationId])
  @@index([invoiceId])
  @@index([menuItemId])
  @@index([productId])
}

/// Structured per-item modifier selection on an invoice line (reporting parity).
model InvoiceItemModifier {
  id               String   @id @default(uuid())
  organizationId   String
  invoiceItemId    String
  modifierId       String?
  name             String
  kitchenPrintName String?
  priceDelta       Decimal  @default(0) @db.Decimal(20, 6)
  createdAt        DateTime @default(now())

  invoiceItem InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceItemId])
}

/// A line snapshot on a printed Receipt (what the customer's copy showed).
model ReceiptItem {
  id             String   @id @default(uuid())
  organizationId String
  receiptId      String
  invoiceItemId  String?
  description    String
  quantity       Decimal  @default(1) @db.Decimal(20, 6)
  unitPrice      Decimal  @default(0) @db.Decimal(20, 6)
  total          Decimal  @default(0) @db.Decimal(20, 6)
  lineNumber     Int      @default(0)
  createdAt      DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([receiptId])
}

// ─── Split Bills (dine-in bill splitting) ───────────────────────────────────
// Divide one table's open tab (an open Order) into multiple independently-
// payable bills WITHOUT duplicating the order or re-firing the kitchen. A
// SplitBillItem references a source OrderItem + a PARTIAL quantity; the sum
// of assigned quantities across non-void bills can never exceed the item qty.
// Each item-split bill settles into its OWN Invoice (reusing the Order→Invoice→
// Receipt bridge used by settleTab); the table closes only once every line is
// fully assigned to a settled bill. Loose refs (no FK) mirror Order.tableId.

enum SplitBillStatus {
  open
  settled
  void
}

enum SplitType {
  item
  even
  percent
}

model SplitBill {
  id             String          @id @default(uuid())
  organizationId String
  /// Loose ref to PosTable (integrity enforced in the service layer).
  tableId        String
  /// The open tab Order being split (its items are the source lines).
  sourceOrderId  String
  label          String
  splitType      SplitType       @default(item)
  /// Percent splits only — the share of the table total this bill owes.
  sharePercent   Decimal?        @db.Decimal(9, 4)
  partnerId      String?
  /// Set when the bill is paid: the Invoice this bill settled into (1:1).
  invoiceId      String?         @unique
  status         SplitBillStatus @default(open)
  subtotal       Decimal         @default(0) @db.Decimal(20, 6)
  totalAmount    Decimal         @default(0) @db.Decimal(20, 6)
  amountPaid     Decimal         @default(0) @db.Decimal(20, 6)
  settledAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?

  items SplitBillItem[]

  @@index([organizationId])
  @@index([organizationId, tableId])
  @@index([organizationId, sourceOrderId])
}

/// One assignment of a source OrderItem (whole or partial qty) to a SplitBill.
model SplitBillItem {
  id             String   @id @default(uuid())
  organizationId String
  splitBillId    String
  /// The OrderItem on the source tab this slice was taken from.
  sourceItemId   String
  quantity       Decimal  @db.Decimal(20, 6)
  createdAt      DateTime @default(now())

  splitBill SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, splitBillId])
  @@index([sourceItemId])
}

// ─── Standalone Expenses (petty-cash / operating expenses) ───────────────────
// A lightweight expense tracker that is SEPARATE from vendor bills (AP). Used
// for rent, utilities, salaries, ad-hoc cash-outs, etc. Posts its OWN cash
// journal entry on payment (Dr expense account / Cr cash-or-bank account) via
// PostingService, so it reconciles into the GL without double-counting bills.

enum ExpenseStatus {
  DRAFT
  APPROVED
  POSTED
  REJECTED
  CANCELLED
  VOID
}

enum ExpensePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ExpensePaymentType {
  CASH
  CREDIT
}

model ExpenseCategory {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  icon            String?
  description     String?
  /// Optional GL expense account this category debits when an expense is paid.
  /// Plain id (no relation) so the Account model needs no back-reference.
  ledgerAccountId String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  deletedAt       DateTime?

  expenses Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Expense {
  id             String               @id @default(uuid())
  organizationId String
  expenseCode    String
  title          String
  description    String?
  amount         Decimal              @db.Decimal(20, 6)
  status         ExpenseStatus        @default(APPROVED)
  paymentStatus  ExpensePaymentStatus @default(UNPAID)
  paymentType    ExpensePaymentType   @default(CREDIT)
  expenseDate    DateTime
  paidAt         DateTime?
  notes          String?
  approvalNotes  String?
  categoryId     String?
  /// Permanent snapshot of the category name (history-safe if the category is
  /// later renamed/deleted).
  categoryName   String?
  /// Plain ids (no relations) → no back-references on Partner / User / Account.
  supplierId     String?
  createdById    String?
  approvedById   String?
  amountPaid     Decimal              @default(0) @db.Decimal(20, 6)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  category ExpenseCategory? @relation(fields: [categoryId], references: [id])
  payments ExpensePayment[]

  @@unique([organizationId, expenseCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, expenseDate])
}

model ExpensePayment {
  id             String   @id @default(uuid())
  organizationId String
  expenseId      String
  amount         Decimal  @db.Decimal(20, 6)
  paymentMethod  String
  reference      String?
  paymentNotes   String?
  /// Cash/bank GL account that was credited (plain id).
  accountId      String?
  paidById       String?
  /// The GL journal entry this payment posted (null if GL was skipped because
  /// no postable accounts were resolvable). Used to reverse on void.
  journalEntryId String?
  status         String   @default("posted") // posted | void
  voidReason     String?
  createdAt      DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([expenseId])
}

/// ============================ Offline sync (P1) ============================

/// A registered offline-capable POS client (Android tablet, offline web
/// terminal). Registration is manager-gated; the device holds an opaque
/// long-lived token (stored hashed, same pattern as RefreshToken) sent as
/// `X-Device-Token` on /sync/* calls. Revoking kills sync on next contact.
model PosDevice {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  platform       String    @default("android") // android | web
  /// sha256 of the opaque device token (shown once at registration).
  tokenHash      String
  /// Short printable prefix for provisional numbers, e.g. "D1" → D1-000042.
  prefix         String
  registeredById String?
  lastSeenAt     DateTime?
  /// Highest deviceSeq successfully applied — lets the server detect gaps
  /// and lets a re-imaged device resume without replaying history.
  lastPushSeq    Int       @default(0)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, tokenHash])
  @@unique([organizationId, prefix])
  @@index([organizationId])
}

/// An offline sync operation the server could not apply (validation error,
/// missing dependency, poisoned payload). NEVER silently dropped — money ops
/// stay here until a human resolves them from the admin review screen.
model SyncOpDeadLetter {
  id             String    @id @default(uuid())
  organizationId String
  deviceId       String
  /// Client op id (the per-op idempotency key).
  opId           String
  deviceSeq      Int
  opType         String
  actorUserId    String?
  occurredAt     DateTime?
  payload        Json
  error          String
  httpStatus     Int?
  status         String    @default("open") // open | resolved | discarded
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, opId])
  @@index([organizationId, status])
  @@index([organizationId, deviceId])
}

/// Phase 1 (accounting hardening) — durable inventory posting.
/// One job per invoice whose stock deduction runs out-of-band. POS-sale stock
/// deduction used to run inline best-effort and drop silent audit markers on
/// failure; it now enqueues here (atomically with the invoice) and a worker
/// drains it with backoff. A whole-run failure (e.g. no warehouse) is retried
/// automatically because nothing was deducted; per-line failures surface as
/// InventoryException. Loosely coupled (no FK) like EventOutbox / SyncOpDeadLetter.
model StockPostingJob {
  id             String    @id @default(uuid())
  organizationId String
  /// Nullable since Phase C: a job enqueued before billing (e.g.
  /// `at_fulfillment_complete` in a café, where stock leaves when the last
  /// ticket is served) has no invoice yet. `orderId` is the load key for the
  /// lines; the invoice fields are back-reference only.
  invoiceId      String?
  invoiceNumber  String?
  orderId        String?
  /// The posting policy that enqueued this job (`inventory.stockPostingTiming`):
  /// at_invoice | at_fulfillment_complete | at_payment | at_confirmation | manual.
  postingTrigger String    @default("at_invoice")
  /// Exactly-once key across ALL triggers, replacing the invoice-only unique.
  /// Shape: `<trigger>:<orderId|invoiceId>`, so a replayed trigger event cannot
  /// enqueue a second job for the same order+policy.
  idempotencyKey String    @default("")
  status         String    @default("pending") // pending | processing | done | failed
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  /// Multi-instance claim token (same pattern as EventOutbox). Cleared on release.
  claimToken     String?
  claimedAt      DateTime?
  nextRetryAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@unique([organizationId, idempotencyKey])
  @@index([status, nextRetryAt])
  @@index([organizationId, status])
}

/// Phase 1 — structured inventory-exception work-queue (replaces the dead
/// `stock_reconcile_needed` audit marker). A specific sale line whose stock
/// could not be issued. Back-office assigns, then resolves via a manual stock
/// adjustment (safe) or discards — every decision is audited. NOT auto-re-issued:
/// a partially-deducted recipe cannot be blindly retried without double-counting
/// (same principle as SyncOpDeadLetter: a human decides). Never silently expires.
model InventoryException {
  id             String    @id @default(uuid())
  organizationId String
  invoiceId      String?
  invoiceNumber  String?
  locationId     String?
  productId      String?
  menuItemId     String?
  description    String?
  quantity       Decimal   @default(0) @db.Decimal(20, 6)
  /// menu_recipe | product | line_extras | whole_invoice
  kind           String
  reason         String
  stackTrace     String?
  /// Snapshot describing the failed line (ids + qty + reference) for diagnosis.
  payload        Json?
  status         String    @default("open") // open | resolved | discarded
  assignedToId   String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, status])
  @@index([organizationId, invoiceId])
}

// =============================================================================
// Configurable Inventory Posting Rules (M3 — Accounting Hardening)
// =============================================================================
//
// One rule line per movement type per product level. Resolution order:
//   1. Product override (productId set)
//   2. Category default (categoryId set)
//   3. Movement type default (productId + categoryId both null)
//   4. Fallback → AccountMapping for each accountSource key
//
// accountSource values:
//   'account_mapping'  → resolve via AccountMapping key (accountMappingKey)
//   'literal'           → use literalAccountId directly
//   'category_field'    → read from ProductCategory.{field} based on accountMappingKey
//   'product_field'     → read from Product.{field} based on accountMappingKey
//
model InventoryPostingRule {
  id                String                @id @default(uuid())
  organizationId    String
  movementType      InventoryMovementType
  lineIndex         Int                   @default(0)
  /// 'debit' | 'credit'
  debitOrCredit     String
  /// 'account_mapping' | 'literal' | 'category_field' | 'product_field'
  accountSource     String                @default("account_mapping")
  /// Only when accountSource='account_mapping': e.g. 'stock_valuation', 'cogs', 'stock_adjustment_expense'
  accountMappingKey String?
  /// Only when accountSource='literal': direct FK into Account
  literalAccountId  String?
  /// Scope: null = movement-type default; set = product or category override
  productId         String?
  categoryId        String?
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?

  @@unique([organizationId, movementType, lineIndex, productId, categoryId])
  @@index([organizationId, movementType, productId])
  @@index([organizationId, movementType, categoryId])
}

