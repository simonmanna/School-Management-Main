model Borrowing {
  id               String    @id @default(uuid())
  organizationId   String
  bookMetadataId   String
  bookCopyId       String
  studentProfileId String?
  staffProfileId   String?
  borrowedAt       DateTime  @default(now())
  dueAt            DateTime
  returnedAt       DateTime?
  /// 'borrowed' | 'returned' | 'overdue' | 'lost'.
  status           String    @default("borrowed")
  fineAmount       Decimal   @default(0) @db.Decimal(18, 6)
  fineInvoiceId    String? // FK to Document if a fine was issued
  notes            String?

  book     BookMetadata @relation(fields: [bookMetadataId], references: [id])
  bookCopy BookCopy     @relation(fields: [bookCopyId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([status])
  @@index([dueAt])
}

model Vehicle {
  id              String    @id @default(uuid())
  organizationId  String
  code            String
  plateNumber     String
  capacity        Int       @default(14)
  /// 'bus' | 'van' | 'car'.
  type            String    @default("bus")
  driverPartnerId String?
  isActive        Boolean   @default(true)
  customFields    Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  routeAssignments RouteAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([plateNumber])
}

model Route {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  monthlyFee     Decimal   @default(0) @db.Decimal(18, 6)
  /// FK to Product (service) used when invoicing the transport fee.
  feeProductId   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  stops            Stop[]
  assignments      StudentTransportAssignment[]
  routeAssignments RouteAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Stop {
  id             String   @id @default(uuid())
  organizationId String
  routeId        String
  name           String
  /// Pickup order (1 = first stop).
  order          Int      @default(1)
  pickupTime     String? // 'HH:mm'
  dropoffTime    String? // 'HH:mm'
  feeOverride    Decimal? @db.Decimal(18, 6)
  /// Geo: {lat, lng}
  location       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  route       Route                        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentTransportAssignment[]

  @@unique([organizationId, routeId, name])
  @@index([organizationId])
}

model RouteAssignment {
  id             String  @id @default(uuid())
  organizationId String
  routeId        String
  vehicleId      String
  /// Day of week 1..7 (1=Monday).
  dayOfWeek      Int
  pickupTime     String? // 'HH:mm'
  dropoffTime    String? // 'HH:mm'
  isActive       Boolean @default(true)

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([organizationId, routeId, vehicleId, dayOfWeek])
  @@index([organizationId])
}

model StudentTransportAssignment {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  routeId          String
  stopId           String
  termId           String?
  startDate        DateTime
  endDate          DateTime?
  monthlyFee       Decimal   @default(0) @db.Decimal(18, 6)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  route   Route          @relation(fields: [routeId], references: [id])
  stop    Stop           @relation(fields: [stopId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
}

model Dormitory {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  /// 'boys' | 'girls' | 'mixed'.
  gender          String    @default("mixed")
  capacity        Int       @default(40)
  wardenPartnerId String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  rooms Room[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Room {
  id             String    @id @default(uuid())
  organizationId String
  dormitoryId    String
  number         String
  /// 'single' | 'double' | 'triple' | 'quad'.
  type           String    @default("double")
  capacity       Int       @default(2)
  monthlyFee     Decimal   @default(0) @db.Decimal(18, 6)
  /// FK to Product (service) for invoicing.
  feeProductId   String?
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  beds      Bed[]

  @@unique([organizationId, dormitoryId, number])
  @@index([organizationId])
}

model Bed {
  id             String   @id @default(uuid())
  organizationId String
  roomId         String
  number         String
  /// 'available' | 'occupied' | 'reserved' | 'maintenance'.
  status         String   @default("available")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocation HostelAllocation?

  @@unique([organizationId, roomId, number])
  @@index([organizationId])
  @@index([status])
}

model HostelAllocation {
  id               String    @id @default(uuid())
  organizationId   String
  bedId            String    @unique
  studentProfileId String
  termId           String?
  startDate        DateTime
  endDate          DateTime?
  checkOutDate     DateTime?
  /// 'active' | 'ended' | 'cancelled'.
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bed     Bed            @relation(fields: [bedId], references: [id])
  student StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
}

model MealPlan {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// 'full' | 'half' | 'lunch_only' | 'breakfast_only'.
  type           String    @default("full")
  /// FK to Product (service) for invoicing.
  feeProductId   String?
  pricePerTerm   Decimal   @db.Decimal(18, 6)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  accounts MealAccount[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MealAccount {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String   @unique
  mealPlanId       String
  balance          Decimal  @default(0) @db.Decimal(20, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  mealPlan  MealPlan       @relation(fields: [mealPlanId], references: [id])
  purchases MealPurchase[]

  @@index([organizationId])
}

model MealPurchase {
  id             String   @id @default(uuid())
  organizationId String
  mealAccountId  String
  amount         Decimal  @db.Decimal(18, 6)
  description    String?
  paymentId      String?
  purchasedAt    DateTime @default(now())

  mealAccount MealAccount @relation(fields: [mealAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mealAccountId])
}

model SchoolDashboardCache {
  id             String   @id @default(uuid())
  organizationId String
  /// 'admin' | 'academic' | 'finance' | 'operational'.
  kind           String
  /// Date this snapshot covers (end-of-day).
  asOf           DateTime
  payload        Json
  builtAt        DateTime @default(now())

  @@unique([organizationId, kind, asOf])
  @@index([organizationId, asOf])
}
