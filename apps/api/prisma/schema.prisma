// =============================================================================
// Generic ERP Platform — Prisma schema (Phase 0 kernel + Phase 1 master data)
//
// Conventions (see docs/adr):
//  - Tenant tables carry `organizationId` (ADR-004). Tenancy is enforced in the
//    app layer by a Prisma Client Extension + AsyncLocalStorage context.
//  - Standard columns on business tables: id, organizationId, createdAt,
//    updatedAt, createdBy, updatedBy, deletedAt (soft delete).
//  - System/global tables (Organization, Permission, Currency) have NO
//    organizationId.
//  - Industry concepts (Student/Patient/...) do NOT appear here (ADR-008).
// =============================================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums ----------------------------------------

/// POS menu layer: distinguishes paid extras from free preparation instructions.
///   ADD_ON    = "What extra is added?" (Cheese +$1, Bacon +$2)
///   MODIFIER  = "How is it prepared?" (Well done, No salt)
enum ModifierGroupType {
  ADD_ON
  MODIFIER
}

enum OrganizationStatus {
  active
  suspended
  archived
}

enum PartnerStatus {
  active
  inactive
  archived
}

enum ProductType {
  stockable
  consumable
  service
  fee
  subscription
  asset
}

/// Per-product inventory costing policy (M3). AVCO is the Odoo-style default;
/// FIFO consumes batches in (expiry, received) order; STANDARD uses a fixed
/// Product.costPrice; SPECIFIC costs each issued unit/layer at its own actual
/// receipt cost (needs serial or batch tracking to identify the layer).
/// See apps/api/src/modules/inventory/costing/.
enum CostingMethod {
  AVCO
  FIFO
  STANDARD
  SPECIFIC
}

/// Per-product default strategy for picking batch/serial-tracked stock on issue.
/// Mirrors @erp/shared STOCK_DISTRIBUTION_STRATEGIES. FEFO = nearest expiry first;
/// FIFO = oldest receipt first; MANUAL = a named batch; SERIAL = selected serials.
enum PickingStrategy {
  FEFO
  FIFO
  MANUAL
  SERIAL
}

/// Lifecycle status of a single serialized stock unit (InventorySerial).
enum SerialStatus {
  in_stock
  issued
  returned
  scrapped
}

enum TaxType {
  vat
  gst
  sales_tax
  withholding
}

enum FiscalPeriodStatus {
  open
  closed
  locked
}

enum AddressType {
  billing
  shipping
  office
  branch
  home
}

enum AuditAction {
  create
  read
  update
  delete
  login
  logout
  approve
  reject
  post
  cancel
  receive
  issue
  adjust
  transfer
  reconcile
  // POS Tables Management (ADR-012)
  merge
  clean
  reserve
  reprint
  assign
  unassign
  restore
  // Beverage Control — a bottle weighing/measurement event.
  measure
  // Fees hardening (2026-08-24): reversal state machines. §Immutability
  // corrects a posted record only by compensating reversal, never by editing
  // it in place — so "reversed" and "reallocated" are distinct audited events,
  // not variants of 'update'. See allocation-reversal.service.ts.
  reverse
  reallocate
}

