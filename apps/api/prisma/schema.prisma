model CurriculumSubject {
  id             String  @id @default(uuid())
  /// P0.4: the fork left this join table without an organizationId, which made
  /// it the one school table the tenancy extension could not scope and RLS
  /// could not police. Added here per ROADMAP ground rule 4 ("company_id on
  /// every table from day one").
  organizationId String
  curriculumId   String
  subjectId      String
  periodsPerWeek Int     @default(4)
  isCore         Boolean @default(true)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
