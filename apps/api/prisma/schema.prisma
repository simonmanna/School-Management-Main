}

enum AcquisitionMethod {
  purchased
  donated
  leased
  constructed
  transferred_in
  gifted
}

enum DepreciationMethod {
  straight_line
  declining_balance
  double_declining
  units_of_production
  manual
}

enum DisposalMethod {
