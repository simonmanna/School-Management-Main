# Client demo on a shared host — copy to .env.demo on the server, chmod 600.
# Generate every secret there: openssl rand -base64 48 (JWT), -hex 24 (DB).
# Used with: docker compose -p school-demo --env-file .env.demo \
#              -f docker-compose.yml -f docker-compose.demo.yml ...

DEMO_WEB_URL=https://school-demo.almasiresidence.com
DEMO_PORTAL_URL=https://portal-demo.almasiresidence.com
# Portal on the server IP over plain HTTP (service portal-ip).
DEMO_PORTAL_IP_PORT=8095
DEMO_EXTRA_ORIGINS=http://169.58.5.88:8095

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_POS_SECRET=
METRICS_TOKEN=

# Postgres owner (restores the dump) and the two runtime roles.
DEMO_DB_OWNER_PASSWORD=
DEMO_DB_APP_PASSWORD=
DEMO_DB_SYSTEM_PASSWORD=

# Required by the base file's (disabled) caddy service; unused here.
SCHOOL_DOMAIN=unused.invalid
ACME_EMAIL=unused@unused.invalid
