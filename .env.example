# ----- Database -----
# The bundled docker-compose Postgres is published on host port 5433
# (to avoid clashing with a locally-installed PostgreSQL on 5432).
DATABASE_URL="postgresql://cafe-pos:cafe-pos@localhost:5433/cafe-pos?schema=public"

# ----- Row-Level Security -----
# Every org-scoped table carries a FORCEd `tenant_isolation` policy, but a
# Postgres SUPERUSER bypasses RLS unconditionally — connecting as `postgres`
# leaves those policies decorative. Provision a non-superuser role with:
#
#   pnpm --filter @erp/api rls:setup-role
#
# It creates two roles: `app` (NOBYPASSRLS — use it as DATABASE_URL) and
# `app_system` (BYPASSRLS — use it as SYSTEM_DATABASE_URL). The API sets
# `app.org_id` on every tenant-scoped statement, so RLS genuinely filters what
# `app` can see; `app_system` backs pre-tenant lookups (login, refresh, cron).
# SYSTEM_DATABASE_URL="postgresql://app_system:<password>@localhost:5433/cafe-pos?schema=public"
#
# In production the API refuses to boot on a superuser connection, and refuses
# to boot under the RLS role without SYSTEM_DATABASE_URL. Set this only to
# acknowledge running as superuser (RLS inert) and start anyway.
RLS_ALLOW_SUPERUSER=false
# Optional: role name and password used by rls:setup-role.
# RLS_APP_ROLE=app
# RLS_APP_PASSWORD=
# RLS_SYSTEM_ROLE=app_system
# RLS_SYSTEM_PASSWORD=
# Refuse routes that have no authorization policy (default in production).
# PERMISSIONS_FAIL_CLOSED=true

# Rows claimed per tick by the durable stock-posting worker.
STOCK_POSTING_BATCH=20

# ----- API -----
PORT=3003
NODE_ENV=development
# Comma-separated list of allowed web origins for CORS.
# The portal is a separate origin from the admin app — add it here, and add the
# real https:// hostnames before going public.
CORS_ORIGINS="http://localhost:5173,http://localhost:5175,http://localhost:3001,http://localhost:3000,http://localhost:5174,http://localhost:3003,http://127.0.0.1:5173,http://127.0.0.1:5175,http://127.0.0.1:3001,http://127.0.0.1:3000,http://127.0.0.1:3003"

# ----- Student / parent / teacher portal -----
# Where the portal is served. Invite and password-reset emails build their links
# from this, so an unset value emails a bare code with nowhere to type it.
PORTAL_URL="http://localhost:5175"

# Baked into the portal image at BUILD time (docker compose build args), so
# changing either means rebuilding the portal, not restarting it.
PORTAL_API_URL="http://localhost:3000"
PORTAL_ORG_CODE="DEMO"
PORTAL_SCHOOL_NAME="School Portal"

# ----- Public deployment (docker compose --profile public) -----
# DNS for portal./api./admin. must already point at this host before Caddy
# starts; it cannot obtain a certificate for a name that does not resolve to it.
SCHOOL_DOMAIN=""
ACME_EMAIL=""

# ----- Email (SMTP) -----
# Read by NotificationsService. With SMTP_HOST unset the API logs mail instead of
# sending it, which means portal invites are minted and never delivered.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@school.local"

# ----- Auth (REQUIRED, 32+ chars; refuse-to-start guard enforces) -----
# Generate each one separately:  openssl rand -base64 48
# They must all differ from each other — a shared key lets a token minted for
# one purpose verify for another.
JWT_ACCESS_SECRET="dev-access-secret-must-be-at-least-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-must-be-at-least-32-chars"
# Signs POS cashier tokens (PIN login, 12h). Optional — falls back to
# JWT_ACCESS_SECRET — but set it in production: the POS token carries the
# cashier's full permission set, so it should not share a key with the
# back-office access token.
JWT_POS_SECRET="dev-pos-secret-must-be-at-least-32-chars!"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_POS_TTL="12h"
MFA_ISSUER="Cafe POS"

# ----- Error responses -----
# In production a 500 returns only `requestId`; the cause is in the logs under
# the same id. Set true for a LAN deploy with no log access to put the exception
# message back in the HTTP response. Deliberate trade — leave unset if unsure.
# EXPOSE_ERROR_DETAIL=false

# Outside production, any private-network origin (10./172.16./192.168.) is
# allowed so LAN terminals work without config. In production it is off unless
# you opt in here — do that for an on-prem cafe LAN, never on an internet-facing
# host. Set "false" to force strict CORS_ORIGINS matching even in dev.
# CORS_ALLOW_LAN=true

# ----- Web (Vite) -----
VITE_API_URL="http://localhost:3000"

# ----- Storage -----
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./var/uploads"
UPLOAD_MAX_BYTES="26214400"

# ----- Body limit -----
BODY_LIMIT="2mb"

# SMTP_SECURE — set true for an implicit-TLS port (465). The SMTP_* block above
# is the live one; this is the only extra key.
# SMTP_SECURE="false"

# ----- Twilio SMS (optional) -----
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""

# ----- Redis (optional — required for multi-instance deploys) -----
# REDIS_URL="redis://localhost:6379"

# ----- Logging -----
LOG_LEVEL="info"

# ----- Metrics -----
# Shared bearer token for GET /api/v1/metrics (Prometheus scrapers cannot hold a
# session). Required in production — the endpoint refuses to serve without it.
# METRICS_TOKEN=""

# ----- Backup -----
# PostgreSQL bin directory (adjust version as needed)
PG_BIN="C:\\Program Files\\PostgreSQL\\18\\bin"
# PostgreSQL connection for backups (pg_dump/pg_restore/pg_basebackup)
# If not set, DATABASE_URL is parsed; set these explicitly if using different credentials/host for backups
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="POS-CAFE"
# Leave blank and set in your real .env — do not commit working credentials.
PGUSER=""
PGPASSWORD=""
# Backup destination directory (MUST be on separate physical media for 3-2-1)
BACKUP_DIR="D:\\backups\\pos-cafe"
# Retention in days for full backups
BACKUP_FULL_RETENTION_DAYS="30"
# Enable scheduled backups
BACKUP_CRON_ENABLED="true"
# Backup frequency: manual, every_hour, every_2_hours, every_4_hours, every_6_hours, every_12_hours, daily, weekly, monthly
BACKUP_FREQUENCY="daily"
# Backup time (HH:MM 24h) for daily/weekly
BACKUP_TIME="02:00"
# Encryption password for AES-256. Empty = backups written in PLAINTEXT, and a
# dump is a full copy of every tenant's data. Set this for any real deployment.
BACKUP_ENCRYPTION_PASSWORD=""
# Healthchecks.io ping URL for backup monitoring
BACKUP_HEALTHCHECKS_PING_URL=""
# Email notifications on failure (requires SMTP configured)
BACKUP_NOTIFY_EMAIL="admin@example.com"

# --- Optional module gates -------------------------------------------------
# Modules that ship in the schema but stay dark until a deployment turns them
# on. Registering a Nest module runs its OnModuleInit, crons, queue consumers
# and event handlers even when nobody navigates to it, so hiding the web nav is
# not sufficient — these gate the API-side import itself.
# Flip one at a time, one restart each, after a release has proven stable.
ENABLE_BEVERAGE="false"
ENABLE_ASSETS="false"
ENABLE_TASKS="true"
ENABLE_MANUFACTURING="true"
ENABLE_RENTAL="false"
ENABLE_REPAIR="false"
# School vertical — students, admissions, academics, attendance, exams, fees.
# Fees post through the same GL/AR engine as every other vertical.
ENABLE_SCHOOL="false"
# Experimental Moodle-shaped delivery features (course modules, SCORM/LTI,
# badges and advanced LMS reports). Keep false through the academic pilot.
ENABLE_ADVANCED_LMS="false"
# School fee penalty cron: runs BillingService.generatePenaltyRun for overdue
# schedules. Cadence in hours; set _ENABLED=false to disable the timer entirely.
PENALTY_RUN_INTERVAL_HOURS="24"
PENALTY_CRON_ENABLED="true"
# Communication platform — staff chat, unified inbox, WhatsApp/Telegram.
ENABLE_COMMUNICATION="false"
# External-provider sub-flags. Internal chat ships without either. Baileys is
# EXPERIMENTAL (ToS/ban risk) and gated on its own so it can be killed alone.
ENABLE_COMMUNICATION_WHATSAPP="false"
ENABLE_COMMUNICATION_TELEGRAM="false"
# Web-side mirror (build-time, baked into the bundle by Vite). Keep these in
# step with the API flags above — the API is what actually enforces access.
VITE_ENABLE_BEVERAGE="false"
VITE_ENABLE_ASSETS="false"
VITE_ENABLE_TASKS="true"
VITE_ENABLE_MANUFACTURING="true"
VITE_ENABLE_RENTAL="false"
VITE_ENABLE_REPAIR="false"
VITE_ENABLE_SCHOOL="false"
# Mirrors ENABLE_ADVANCED_LMS for navigation only; the API flag is authoritative.
VITE_ENABLE_ADVANCED_LMS="false"
VITE_ENABLE_COMMUNICATION="false"

# ── Communication platform config ────────────────────────────────────────────
# Outbound delivery worker poll interval (ms). 250 keeps Telegram's 30 msg/s.
COMM_DISPATCH_POLL_MS="250"
# AES-256-GCM key for WhatsApp (Baileys) session creds at rest — 32 bytes,
# base64. FATAL at boot when the Baileys transport is enabled and this is unset.
# Generate: openssl rand -base64 32
COMM_ENCRYPTION_KEY=""
# WhatsApp transport: 'cloud' (production target, Meta Cloud API) or 'baileys'
# (EXPERIMENTAL, unofficial — ToS/ban risk; see the plan).
WHATSAPP_TRANSPORT="cloud"
# Baileys anti-ban pacing (only used when WHATSAPP_TRANSPORT=baileys).
WA_MIN_GAP_MS="4000"
WA_DAILY_CAP="200"
# Telegram Bot API token from @BotFather (only when a Telegram channel is used).
TELEGRAM_BOT_TOKEN=""
