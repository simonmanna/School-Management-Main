model StudentDocument {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  /// 'birth_cert' | 'report_card' | 'transfer_letter' | 'photo' | 'medical' | 'other'.
  type             String
  title            String
  fileUrl          String
  uploadedAt       DateTime  @default(now())
  expiresAt        DateTime?
  verified         Boolean   @default(false)
  verifiedById     String?
  verifiedAt       DateTime?
  customFields     Json      @default("{}")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentProfileId])
}

model StaffProfile {
  id              String      @id @default(uuid())
  organizationId  String
  /// UNIQUE FK to Partner.
  partnerId       String      @unique
  employeeNo      String
  departmentId    String?
  positionId      String?
  campusId        String?
  joinDate        DateTime
  contractType    String      @default("permanent") // 'permanent' | 'contract' | 'temporary' | 'probation'
  contractEndDate DateTime?
  status          StaffStatus @default(active)
  /// Compensation is JSONB for now (payroll is a deferred satellite).
  compensation    Json        @default("{}")
  /// 'teaching' | 'non_teaching' | 'admin' | 'support'.
  staffCategory   String      @default("teaching")
  customFields    Json        @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  department         Department?          @relation(fields: [departmentId], references: [id])
  campus             Campus?              @relation(fields: [campusId], references: [id])
  position           Position?            @relation(fields: [positionId], references: [id])
  statusHistory      StaffStatusHistory[]
  attendance         StaffAttendance[]
  teacherAssignments TeacherAssignment[]
  lessonPlans        LessonPlan[]
  homeworks          HomeworkAssignment[]
  timetableSlots     TimetableSlot[]
  gradeEntries       GradeEntry[]
  messages           Message[]            @relation("MessageSender")

  @@unique([organizationId, employeeNo])
  @@index([organizationId])
  @@index([departmentId])
  @@index([campusId])
}

model StaffStatusHistory {
  id             String   @id @default(uuid())
  organizationId String
  staffProfileId String
  fromStatus     String?
  toStatus       String
  reason         String?
  changedById    String?
  changedAt      DateTime @default(now())

  staff StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([staffProfileId])
}

model Position {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  isTeaching         Boolean   @default(false)
  defaultPermissions Json      @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  staff StaffProfile[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model StaffAttendance {
  id             String    @id @default(uuid())
  organizationId String
  staffProfileId String
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  /// 'present' | 'absent' | 'late' | 'leave' | 'off_duty'.
  status         String    @default("present")
  notes          String?
  markedById     String?
  createdAt      DateTime  @default(now())

  staff StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffProfileId, date])
  @@index([organizationId])
  @@index([staffProfileId])
  @@index([organizationId, date])
}

// ── Sprint 3: Admissions & Academics ───────────────────────────────────────

enum AdmissionStatus {
  submitted
  under_review
  exam_scheduled
  accepted
  rejected
  enrolled
  withdrawn
}

enum ExamStatus {
  draft
  scheduled
  published
  closed
}

model AdmissionApplication {
  id                 String          @id @default(uuid())
  organizationId     String
  academicYearId     String
  applicationNumber  String
  applicantFirstName String
  applicantLastName  String
  applicantDob       DateTime?
  applicantGender    String?
  applyingForClassId String?
  /// FK to Contact (parent/guardian contact for this application).
  parentContactId    String?
  status             AdmissionStatus @default(submitted)
  submittedAt        DateTime        @default(now())
  reviewedById       String?
  reviewedAt         DateTime?
  decisionNotes      String?
  customFields       Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  academicYear  AcademicYear          @relation(fields: [academicYearId], references: [id])
  documents     ApplicationDocument[]
  entranceExams EntranceExam[]
  waitingList   WaitingList?
  enrollment    Enrollment?

  @@unique([organizationId, applicationNumber])
  @@index([organizationId])
  @@index([academicYearId])
  @@index([status])
}

model ApplicationDocument {
  id             String    @id @default(uuid())
  organizationId String
  applicationId  String
  /// 'birth_cert' | 'report_card' | 'recommendation' | 'photo' | 'other'.
  type           String
  fileUrl        String
  uploadedAt     DateTime  @default(now())
  verified       Boolean   @default(false)
  verifiedById   String?
  verifiedAt     DateTime?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([applicationId])
}

model EntranceExam {
  id             String    @id @default(uuid())
  organizationId String
  applicationId  String
  subjectId      String
  scheduledAt    DateTime?
  score          Decimal?  @db.Decimal(8, 2)
  maxScore       Decimal   @default(100) @db.Decimal(8, 2)
  grade          String?
  notes          String?
  enteredById    String?
  enteredAt      DateTime?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject     Subject              @relation(fields: [subjectId], references: [id])

  @@unique([applicationId, subjectId])
  @@index([organizationId])
  @@index([applicationId])
}

model WaitingList {
  id             String   @id @default(uuid())
  organizationId String
  applicationId  String   @unique
  classId        String
  position       Int
  addedAt        DateTime @default(now())
  notes          String?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([classId, position])
}

model Enrollment {
  id               String   @id @default(uuid())
  organizationId   String
  applicationId    String?  @unique
  studentProfileId String
  classId          String
  sectionId        String?
  termId           String
  rollNumber       String
  enrolledAt       DateTime @default(now())
  /// 'enrolled' | 'completed' | 'transferred_out' | 'withdrawn'.
  status           String   @default("enrolled")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application AdmissionApplication? @relation(fields: [applicationId], references: [id])
  student     StudentProfile        @relation(fields: [studentProfileId], references: [id])
  schoolClass SchoolClass           @relation(fields: [classId], references: [id])
  section     Section?              @relation(fields: [sectionId], references: [id])
  term        Term                  @relation(fields: [termId], references: [id])

  @@unique([organizationId, studentProfileId, termId])
  @@index([organizationId])
  @@index([classId])
  @@index([termId])
}

model Curriculum {
  id             String    @id @default(uuid())
  organizationId String
  classId        String
  academicYearId String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  subjects     CurriculumSubject[]

  @@unique([organizationId, classId, academicYearId, name])
  @@index([organizationId])
}

model CurriculumSubject {
  id             String  @id @default(uuid())
  curriculumId   String
  subjectId      String
  periodsPerWeek Int     @default(4)
  isCore         Boolean @default(true)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])

  @@unique([curriculumId, subjectId])
  @@index([subjectId])
}

model LessonPlan {
  id               String    @id @default(uuid())
  organizationId   String
  subjectId        String
  classId          String?
  termId           String?
  teacherPartnerId String?
  weekOf           DateTime
  title            String
  objectives       String?
  materials        String?
  /// 'draft' | 'published'.
  status           String    @default("draft")
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subject Subject       @relation(fields: [subjectId], references: [id])
  term    Term?         @relation(fields: [termId], references: [id])
  teacher StaffProfile? @relation(fields: [teacherPartnerId], references: [id])

  @@index([organizationId])
  @@index([subjectId])
  @@index([teacherPartnerId])
}

model TeacherAssignment {
  id               String   @id @default(uuid())
  organizationId   String
  teacherPartnerId String
  subjectId        String
  classId          String
  sectionId        String?
  termId           String?
  periodsPerWeek   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher     StaffProfile @relation(fields: [teacherPartnerId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id])
  schoolClass SchoolClass  @relation(fields: [classId], references: [id])
  section     Section?     @relation(fields: [sectionId], references: [id])
  term        Term?        @relation(fields: [termId], references: [id])

  @@unique([organizationId, teacherPartnerId, subjectId, classId, sectionId, termId])
  @@index([organizationId])
  @@index([teacherPartnerId])
  @@index([classId])
}

model TimetableSlot {
  id               String   @id @default(uuid())
  organizationId   String
  classId          String
  sectionId        String?
  dayOfWeek        Int // 1=Monday ... 7=Sunday
  periodId         String
  subjectId        String
  teacherPartnerId String?
  room             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  schoolClass SchoolClass   @relation(fields: [classId], references: [id])
  section     Section?      @relation(fields: [sectionId], references: [id])
  period      Period        @relation(fields: [periodId], references: [id])
  subject     Subject       @relation(fields: [subjectId], references: [id])
  campus      Campus?       @relation(fields: [campusId], references: [id])
  teacher     StaffProfile? @relation(fields: [teacherPartnerId], references: [id])
  campusId    String?

  @@index([organizationId])
  @@index([classId, dayOfWeek])
  @@index([teacherPartnerId, dayOfWeek])
  @@index([periodId, dayOfWeek])
}

// ── Sprint 4: Attendance + LMS ─────────────────────────────────────────────

enum AttendanceStatus {
  present
  absent
  late
  excused
}

model StudentAttendance {
  id               String           @id @default(uuid())
  organizationId   String
  studentProfileId String
  classId          String
  sectionId        String?
  date             DateTime
  status           AttendanceStatus @default(present)
  minutesLate      Int              @default(0)
  reason           String?
  markedById       String?
  markedAt         DateTime         @default(now())
  customFields     Json             @default("{}")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass    @relation(fields: [classId], references: [id])
  section        Section?       @relation(fields: [sectionId], references: [id])

  @@unique([organizationId, studentProfileId, date])
  @@index([organizationId])
  @@index([classId, date])
  @@index([organizationId, date])
}

model HomeworkAssignment {
  id               String    @id @default(uuid())
  organizationId   String
  teacherPartnerId String
  classId          String
  sectionId        String?
  subjectId        String
  termId           String?
  title            String
  description      String?
  dueDate          DateTime
  attachments      Json      @default("[]")
  maxScore         Decimal?  @db.Decimal(8, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  teacher     StaffProfile         @relation(fields: [teacherPartnerId], references: [id])
  schoolClass SchoolClass          @relation(fields: [classId], references: [id])
  section     Section?             @relation(fields: [sectionId], references: [id])
  subject     Subject              @relation(fields: [subjectId], references: [id])
  submissions HomeworkSubmission[]

  @@index([organizationId])
  @@index([classId, dueDate])
  @@index([subjectId])
}

model HomeworkSubmission {
  id               String    @id @default(uuid())
  organizationId   String
  assignmentId     String
  studentProfileId String
  submittedAt      DateTime?
  content          String?
  attachments      Json      @default("[]")
  score            Decimal?  @db.Decimal(8, 2)
  gradedById       String?
  gradedAt         DateTime?
  feedback         String?
  status           String    @default("assigned") // 'assigned' | 'submitted' | 'late' | 'graded'

  assignment     HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id])

  @@unique([assignmentId, studentProfileId])
  @@index([organizationId])
  @@index([studentProfileId])
}

model LearningResource {
  id             String    @id @default(uuid())
  organizationId String
  classId        String?
  subjectId      String?
  title          String
  /// 'note' | 'video' | 'link' | 'file' | 'slide'.
  type           String
  url            String?
  fileUrl        String?
  tags           String[]  @default([])
  description    String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([classId])
  @@index([subjectId])
}

model Announcement {
  id             String    @id @default(uuid())
  organizationId String
  /// 'school' | 'campus' | 'department' | 'class' | 'staff'.
  scope          String    @default("school")
  scopeId        String?
  classId        String?
  title          String
  body           String
  authorId       String?
  publishedAt    DateTime?
  expiresAt      DateTime?
  /// 'normal' | 'urgent' | 'info'.
  priority       String    @default("normal")
  /// Audience: ['all', 'parents', 'students', 'staff'].
  audience       String[]  @default(["all"])
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  schoolClass SchoolClass? @relation(fields: [classId], references: [id])

  @@index([organizationId])
  @@index([scope, scopeId])
  @@index([organizationId, publishedAt])
}

// ── Sprint 5: Examinations & Grading ───────────────────────────────────────

enum GradeEntryStatus {
  draft
  submitted
  approved
  rejected
}

model ExamType {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// Weight in overall term score (e.g. CAT1=10, Midterm=30, Final=40).
  weight         Decimal   @db.Decimal(5, 2)
  isFinal        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  exams Exam[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Exam {
  id             String     @id @default(uuid())
  organizationId String
  termId         String
  examTypeId     String
  name           String
  startDate      DateTime
  endDate        DateTime
  /// Class IDs the exam applies to (JSON array for flexibility).
  classes        Json       @default("[]")
  status         ExamStatus @default(draft)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  term      Term           @relation(fields: [termId], references: [id])
  examType  ExamType       @relation(fields: [examTypeId], references: [id])
  schedules ExamSchedule[]

  @@index([organizationId])
  @@index([termId])
  @@index([status])
}

model ExamSchedule {
  id              String   @id @default(uuid())
  organizationId  String
  examId          String
  classId         String
  subjectId       String
  date            DateTime
  startTime       String // 'HH:mm'
  durationMinutes Int      @default(60)
  invigilatorId   String?
  maxMarks        Decimal  @default(100) @db.Decimal(8, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass  @relation(fields: [classId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  gradeEntries GradeEntry[]

  @@unique([examId, classId, subjectId])
  @@index([organizationId])
  @@index([classId, date])
}

model GradeEntry {
  id               String           @id @default(uuid())
  organizationId   String
  examScheduleId   String
  studentProfileId String
  marksObtained    Decimal?         @db.Decimal(8, 2)
  maxMarks         Decimal          @db.Decimal(8, 2)
  /// Computed grade letter (A/B/C/...).
  grade            String?
  /// Computed grade point (GPA).
  gradePoint       Decimal?         @db.Decimal(4, 2)
  remarks          String?
  status           GradeEntryStatus @default(draft)
  enteredById      String?
  enteredAt        DateTime?
  approvedById     String?
  approvedAt       DateTime?
  customFields     Json             @default("{}")

  examSchedule   ExamSchedule   @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  enteredBy      StaffProfile?  @relation(fields: [enteredById], references: [id])

  @@unique([examScheduleId, studentProfileId])
  @@index([organizationId])
  @@index([studentProfileId])
  @@index([status])
}

model GradingScale {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// Bands: [{min:80, max:100, grade:'A', gpa:4.0, remark:'Distinction'}, ...]
  bands          Json
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ReportCard {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  termId           String
  generatedAt      DateTime  @default(now())
  /// Full report card payload (subjects, grades, GPA, rank, comments).
  payload          Json
  pdfUrl           String?
  publishedAt      DateTime?
  customFields     Json      @default("{}")

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([termId])
}

model AcademicTranscript {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  generatedAt      DateTime @default(now())
  payload          Json
  pdfUrl           String?

  @@index([organizationId])
  @@index([studentProfileId])
}

// ── Sprint 6: School Fees (keystone) ───────────────────────────────────────

enum DiscountType {
  percent
  fixed
}

model FeeStructure {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  academicYearId String
  /// JSON array of {code:'TUITION', productId, amount, isOptional}
  components     Json
  /// JSON filter: {gradeLevelIds:[...], classIds:[...]}.
  applicableTo   Json      @default("{}")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id])
  schedules    FeeSchedule[]
  assignments  StudentFeeAssignment[]

  @@unique([organizationId, name, academicYearId])
  @@index([organizationId])
}

model FeeSchedule {
  id             String   @id @default(uuid())
  organizationId String
  feeStructureId String
  termId         String
  dueDate        DateTime
  /// JSON: {type:'percent'|'fixed', value:Number, graceDays:Int}
  lateFeePolicy  Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure       FeeStructure        @relation(fields: [feeStructureId], references: [id])
  term               Term                @relation(fields: [termId], references: [id])
  penaltyRules       PenaltyRule[]
  penaltyRuns        PenaltyRun[]
  penaltyAssessments PenaltyAssessment[]

  @@unique([organizationId, feeStructureId, termId])
  @@index([organizationId])
  @@index([termId])
}

model StudentFeeAssignment {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  feeStructureId   String
  termId           String
  /// Per-student override of components: {code: amount} or null to use defaults.
  customDiscount   Json     @default("{}")
  /// Optional JSON: [{code,type,value}]
  extraDiscounts   Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure   @relation(fields: [feeStructureId], references: [id])
  term           Term           @relation(fields: [termId], references: [id])

  @@unique([organizationId, studentProfileId, feeStructureId, termId])
  @@index([organizationId])
  @@index([studentProfileId])
}

model Discount {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           DiscountType
  value          Decimal      @db.Decimal(18, 6)
  /// JSON filter: {gradeLevelIds, classIds, feeCodes:[...]}
  appliesTo      Json         @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Scholarship {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  code             String
  name             String
  /// 'percent' | 'fixed'.
  type             String
  value            Decimal   @db.Decimal(18, 6)
  validFrom        DateTime
  validTo          DateTime?
  awardedBy        String?
  notes            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentProfileId])
}

model InstallmentPlan {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String
  termId           String
  totalAmount      Decimal  @db.Decimal(20, 6)
  /// JSON: [{number, dueDate, amount}]
  installments     Json
  customFields     Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  term           Term           @relation(fields: [termId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
}

model PenaltyRule {
  id             String   @id @default(uuid())
  organizationId String
  feeScheduleId  String
  /// 'percent' | 'fixed'.
  type           String
  value          Decimal  @db.Decimal(18, 6)
  graceDays      Int      @default(7)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeSchedule FeeSchedule         @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  assessments PenaltyAssessment[]

  @@index([organizationId])
}

model PenaltyRun {
  id              String   @id @default(uuid())
  organizationId  String
  runAt           DateTime @default(now())
  /// P0-2: the date the cron was scheduled to run (UTC, date-only).
  /// Combined with the unique constraint below, this prevents the
  /// daily penalty cron from creating two PenaltyRun rows for the
  /// same schedule on the same day.
  cronDate        DateTime @db.Date
  scheduleId      String
  totalAssessed   Decimal  @db.Decimal(20, 6)
  /// JSON array of created penalty-document IDs.
  createdInvoices Json     @default("[]")
  notes           String?

  schedule    FeeSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assessments PenaltyAssessment[]

  @@unique([organizationId, scheduleId, cronDate])
  @@index([organizationId])
  @@index([scheduleId])
}

/// P0-2: one row per penalty applied to an overdue invoice. Enforces
/// "no duplicate penalty for the same source document in the same
/// PenaltyRun" — the most common case of the silent compounding bug
/// where a daily cron tick would mint a new penalty invoice every
/// 24 h.
model PenaltyAssessment {
  id                String   @id @default(uuid())
  organizationId    String
  penaltyRunId      String
  sourceDocumentId  String
  scheduleId        String
  ruleId            String
  amount            Decimal  @db.Decimal(20, 6)
  /// P0-2: the penalty invoice that was created for this assessment.
  /// Unique because each PenaltyAssessment produces at most one Document
  /// (and Document is the inverse side of a 1:1 relation).
  penaltyDocumentId String?  @unique
  /// When the assessment was created (audit / debugging).
  createdAt         DateTime @default(now())

  penaltyRun      PenaltyRun  @relation(fields: [penaltyRunId], references: [id], onDelete: Cascade)
  sourceDocument  Document    @relation("PenaltySource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  schedule        FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  rule            PenaltyRule @relation(fields: [ruleId], references: [id])
  penaltyDocument Document?   @relation("PenaltyDocument", fields: [penaltyDocumentId], references: [id])

  @@unique([sourceDocumentId, penaltyRunId])
  @@index([organizationId])
  @@index([penaltyRunId])
  @@index([sourceDocumentId])
  @@index([scheduleId])
}

// ── Sprint 8: Communication ────────────────────────────────────────────────

enum NotificationStatus {
  queued
  sent
  failed
}

enum NotificationChannel {
  sms
  email
  push
  in_app
}

model NotificationTemplate {
  id             String              @id @default(uuid())
  organizationId String
  channel        NotificationChannel
  code           String
  subject        String?
  body           String
  /// JSON array of placeholder names, e.g. ['studentName','dueDate'].
  variables      Json                @default("[]")
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, channel, code])
  @@index([organizationId])
}

model Notification {
  id                String              @id @default(uuid())
  organizationId    String
  /// 'partner' | 'contact' | 'user'.
  recipientType     String
  recipientId       String
  channel           NotificationChannel
  templateCode      String?
  payload           Json                @default("{}")
  status            NotificationStatus  @default(queued)
  sentAt            DateTime?
  providerMessageId String?
  error             String?
  attempts          Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([recipientType, recipientId])
}

model MessageThread {
  id             String    @id @default(uuid())
  organizationId String
  participantIds Json      @default("[]") // array of {type:'user'|'contact'|'partner', id}
  subject        String?
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages Message[]

  @@index([organizationId])
}

model Message {
  id             String   @id @default(uuid())
  organizationId String
  threadId       String
  senderId       String
  body           String
  attachments    Json     @default("[]")
  sentAt         DateTime @default(now())
  readBy         Json     @default("[]") // array of participant refs

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender StaffProfile  @relation("MessageSender", fields: [senderId], references: [id])

  @@index([organizationId])
  @@index([threadId])
}

// ── Sprint 9: Library + Transport ──────────────────────────────────────────

model BookMetadata {
  id             String  @id @default(uuid())
  organizationId String
  /// FK to Product (stockable, trackInventory=true). One row per ISBN.
  productId      String  @unique
  author         String?
  isbn           String?
  publisher      String?
  edition        String?
  /// 'reference' | 'textbook' | 'novel' | 'journal' | 'magazine'.
  category       String  @default("textbook")
  shelfLocation  String?
  /// Total copies owned across the library.
  totalCopies    Int     @default(1)
  customFields   Json    @default("{}")

  copies     BookCopy[]
  borrowings Borrowing[]

  @@index([organizationId])
  @@index([isbn])
}

model BookCopy {
  id             String   @id @default(uuid())
  organizationId String
  bookMetadataId String
  copyNumber     String
  /// 'available' | 'borrowed' | 'lost' | 'damaged' | 'reserved'.
  status         String   @default("available")
  condition      String   @default("good")
  acquiredAt     DateTime @default(now())
  customFields   Json     @default("{}")

  book       BookMetadata @relation(fields: [bookMetadataId], references: [id], onDelete: Cascade)
  borrowings Borrowing[]

  @@unique([organizationId, bookMetadataId, copyNumber])
  @@index([organizationId])
  @@index([status])
}

model Borrowing {
  id               String    @id @default(uuid())
  organizationId   String
  bookMetadataId   String
  bookCopyId       String
  studentProfileId String?
  staffProfileId   String?
  borrowedAt       DateTime  @default(now())
  dueAt            DateTime
  returnedAt       DateTime?
  /// 'borrowed' | 'returned' | 'overdue' | 'lost'.
  status           String    @default("borrowed")
  fineAmount       Decimal   @default(0) @db.Decimal(18, 6)
  fineInvoiceId    String? // FK to Document if a fine was issued
  notes            String?

  book     BookMetadata @relation(fields: [bookMetadataId], references: [id])
  bookCopy BookCopy     @relation(fields: [bookCopyId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
  @@index([status])
  @@index([dueAt])
}

model Vehicle {
  id              String    @id @default(uuid())
  organizationId  String
  code            String
  plateNumber     String
  capacity        Int       @default(14)
  /// 'bus' | 'van' | 'car'.
  type            String    @default("bus")
  driverPartnerId String?
  isActive        Boolean   @default(true)
  customFields    Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  routeAssignments RouteAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([plateNumber])
}

model Route {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  monthlyFee     Decimal   @default(0) @db.Decimal(18, 6)
  /// FK to Product (service) used when invoicing the transport fee.
  feeProductId   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  stops            Stop[]
  assignments      StudentTransportAssignment[]
  routeAssignments RouteAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Stop {
  id             String   @id @default(uuid())
  organizationId String
  routeId        String
  name           String
  /// Pickup order (1 = first stop).
  order          Int      @default(1)
  pickupTime     String? // 'HH:mm'
  dropoffTime    String? // 'HH:mm'
  feeOverride    Decimal? @db.Decimal(18, 6)
  /// Geo: {lat, lng}
  location       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  route       Route                        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentTransportAssignment[]

  @@unique([organizationId, routeId, name])
  @@index([organizationId])
}

model RouteAssignment {
  id             String  @id @default(uuid())
  organizationId String
  routeId        String
  vehicleId      String
  /// Day of week 1..7 (1=Monday).
  dayOfWeek      Int
  pickupTime     String? // 'HH:mm'
  dropoffTime    String? // 'HH:mm'
  isActive       Boolean @default(true)

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([organizationId, routeId, vehicleId, dayOfWeek])
  @@index([organizationId])
}

model StudentTransportAssignment {
  id               String    @id @default(uuid())
  organizationId   String
  studentProfileId String
  routeId          String
  stopId           String
  termId           String?
  startDate        DateTime
  endDate          DateTime?
  monthlyFee       Decimal   @default(0) @db.Decimal(18, 6)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  route   Route          @relation(fields: [routeId], references: [id])
  stop    Stop           @relation(fields: [stopId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
}

// ── Sprint 10: Hostel + Cafeteria ─────────────────────────────────────────

model Dormitory {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  /// 'boys' | 'girls' | 'mixed'.
  gender          String    @default("mixed")
  capacity        Int       @default(40)
  wardenPartnerId String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  rooms Room[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Room {
  id             String    @id @default(uuid())
  organizationId String
  dormitoryId    String
  number         String
  /// 'single' | 'double' | 'triple' | 'quad'.
  type           String    @default("double")
  capacity       Int       @default(2)
  monthlyFee     Decimal   @default(0) @db.Decimal(18, 6)
  /// FK to Product (service) for invoicing.
  feeProductId   String?
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  beds      Bed[]

  @@unique([organizationId, dormitoryId, number])
  @@index([organizationId])
}

model Bed {
  id             String   @id @default(uuid())
  organizationId String
  roomId         String
  number         String
  /// 'available' | 'occupied' | 'reserved' | 'maintenance'.
  status         String   @default("available")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocation HostelAllocation?

  @@unique([organizationId, roomId, number])
  @@index([organizationId])
  @@index([status])
}

model HostelAllocation {
  id               String    @id @default(uuid())
  organizationId   String
  bedId            String    @unique
  studentProfileId String
  termId           String?
  startDate        DateTime
  endDate          DateTime?
  checkOutDate     DateTime?
  /// 'active' | 'ended' | 'cancelled'.
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bed     Bed            @relation(fields: [bedId], references: [id])
  student StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([organizationId])
  @@index([studentProfileId])
}

model MealPlan {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  /// 'full' | 'half' | 'lunch_only' | 'breakfast_only'.
  type           String    @default("full")
  /// FK to Product (service) for invoicing.
  feeProductId   String?
  pricePerTerm   Decimal   @db.Decimal(18, 6)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  accounts MealAccount[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MealAccount {
  id               String   @id @default(uuid())
  organizationId   String
  studentProfileId String   @unique
  mealPlanId       String
  balance          Decimal  @default(0) @db.Decimal(20, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  mealPlan  MealPlan       @relation(fields: [mealPlanId], references: [id])
  purchases MealPurchase[]

  @@index([organizationId])
}

model MealPurchase {
  id             String   @id @default(uuid())
  organizationId String
  mealAccountId  String
  amount         Decimal  @db.Decimal(18, 6)
  description    String?
  paymentId      String?
  purchasedAt    DateTime @default(now())

  mealAccount MealAccount @relation(fields: [mealAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mealAccountId])
}

// ── Sprint 11: Reports (denormalized counters for fast dashboards) ─────────

model SchoolDashboardCache {
  id             String   @id @default(uuid())
  organizationId String
  /// 'admin' | 'academic' | 'finance' | 'operational'.
  kind           String
  /// Date this snapshot covers (end-of-day).
  asOf           DateTime
  payload        Json
  builtAt        DateTime @default(now())

  @@unique([organizationId, kind, asOf])
  @@index([organizationId, asOf])
}
