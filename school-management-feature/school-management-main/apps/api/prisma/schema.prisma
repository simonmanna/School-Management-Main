// ── Sprint 2: People (Students / Guardians / Staff) ─────────────────────────

enum StudentStatus {
  active
  suspended
  transferred
  withdrawn
  alumni
}

enum StaffStatus {
  active
  on_leave
  suspended
  terminated
  retired
}

model StudentProfile {
  id               String        @id @default(uuid())
  organizationId   String
  /// UNIQUE FK to Partner. The Partner row carries name/email/phone/etc.
  partnerId        String        @unique
  admissionNo      String
  currentClassId   String?
  currentSectionId String?
  enrollmentDate   DateTime
  status           StudentStatus @default(active)
  /// Date-of-birth mirror for fast filtering (also stored on Partner customFields).
