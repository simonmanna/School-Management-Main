  gender           String?
  nationality      String?
  religion         String?
  /// 'day' | 'boarder'
  residenceType    String        @default("day")
  /// House assignment (Red/Blue/etc.).
  house            String?
  customFields     Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  currentClass        SchoolClass?                 @relation(fields: [currentClassId], references: [id])
  currentSection      Section?                     @relation(fields: [currentSectionId], references: [id])
  guardians           StudentGuardian[]
  medicalRecord       MedicalRecord?
  documents           StudentDocument[]
