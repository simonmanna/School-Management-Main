# Multi-stage Dockerfile for the React SPA (Vite build, served by nginx).

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web
# Audit F10: the API address is compiled into the bundle, so it must be the
# address a remote browser can reach. Empty = same origin (/api/v1), which is
# what production uses behind Caddy. Every capability the menu reads is an ARG,
# so the image can match the API's enabled modules exactly.
ARG VITE_API_URL=
ARG VITE_ENABLE_SCHOOL=false
ARG VITE_ENABLE_ADVANCED_LMS=false
ARG VITE_ENABLE_HR=false
ARG VITE_ENABLE_COMMUNICATION=false
ARG VITE_ENABLE_ORDERS=false
ARG VITE_ENABLE_BEVERAGE=false
ARG VITE_ENABLE_ASSETS=false
ARG VITE_ENABLE_TASKS=false
ARG VITE_ENABLE_MANUFACTURING=false
ARG VITE_ENABLE_RENTAL=false
ARG VITE_ENABLE_REPAIR=false
ARG VITE_ENABLE_LIVE_MOBILE_MONEY=false
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_ENABLE_SCHOOL=${VITE_ENABLE_SCHOOL} \
    VITE_ENABLE_ADVANCED_LMS=${VITE_ENABLE_ADVANCED_LMS} \
    VITE_ENABLE_HR=${VITE_ENABLE_HR} \
    VITE_ENABLE_COMMUNICATION=${VITE_ENABLE_COMMUNICATION} \
    VITE_ENABLE_ORDERS=${VITE_ENABLE_ORDERS} \
    VITE_ENABLE_BEVERAGE=${VITE_ENABLE_BEVERAGE} \
    VITE_ENABLE_ASSETS=${VITE_ENABLE_ASSETS} \
    VITE_ENABLE_TASKS=${VITE_ENABLE_TASKS} \
    VITE_ENABLE_MANUFACTURING=${VITE_ENABLE_MANUFACTURING} \
    VITE_ENABLE_RENTAL=${VITE_ENABLE_RENTAL} \
    VITE_ENABLE_REPAIR=${VITE_ENABLE_REPAIR} \
    VITE_ENABLE_LIVE_MOBILE_MONEY=${VITE_ENABLE_LIVE_MOBILE_MONEY}
RUN pnpm --filter @erp/shared build
RUN pnpm --filter @erp/web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ || exit 1
EXPOSE 80
