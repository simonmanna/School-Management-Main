# Multi-stage Dockerfile for the API.
#
# OPS-01 — why this file looks the way it does.
#
# The runtime stage used to run its own `pnpm install --prod --ignore-scripts`
# and never copied node_modules from the build stage. `prisma generate` runs
# only during build, and `--ignore-scripts` suppresses @prisma/client's
# postinstall, so the shipped image resolved @prisma/client to an *ungenerated
# stub* and could not boot. Nothing caught it, because CI never built the image.
#
# The fix carries the build stage's node_modules — symlink farm and generated
# client included — into the runtime image, and asserts the client is real at
# build time rather than discovering it at container start. Keeping the build
# tree costs image size; correctness first. Slimming it (pnpm deploy, or a
# generator `output` inside the repo tree) is a separate, testable change.
#
# The workspace uses pnpm symlinks, so node_modules is copied as one tree —
# copying sub-paths piecemeal breaks the links.

FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
# Every workspace project needs its manifest present or --frozen-lockfile fails.
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/portal/package.json apps/portal/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY --from=deps /app /app
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @erp/shared build
RUN pnpm --filter @erp/api db:generate
RUN pnpm --filter @erp/api build
# Fail the build here, not at container start. An ungenerated stub client has no
# DMMF; a real one lists every model in schema.prisma.
RUN node -e "const {Prisma}=require('@prisma/client'); const n=Prisma.dmmf?.datamodel?.models?.length ?? 0; if(!n){console.error('FATAL: @prisma/client is not generated'); process.exit(1);} console.log('prisma client generated:', n, 'models');"

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && \
    addgroup -S cafe-pos && adduser -S cafe-pos -G cafe-pos && \
    apk add --no-cache tini
COPY --from=build /app /app
# Drop build-only sources. dist/ is what runs; node_modules must stay intact.
RUN rm -rf apps/web apps/portal apps/api/src apps/api/test packages/shared/src \
           tsconfig.base.json apps/api/tsconfig*.json && \
    mkdir -p /app/var/uploads && chown -R cafe-pos:cafe-pos /app
USER cafe-pos
# Same assertion again: prove the client survived the copy and the prune.
RUN node -e "const {Prisma}=require('@prisma/client'); if(!(Prisma.dmmf?.datamodel?.models?.length)){console.error('FATAL: @prisma/client is not generated in runtime image'); process.exit(1);} console.log('runtime prisma client ok');"
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/v1/health/live || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
# --max-http-header-size matches apps/api/package.json's start scripts; the
# previous CMD dropped it, so the container behaved differently from `pnpm start`.
CMD ["node", "--max-http-header-size=65536", "apps/api/dist/main.js"]
