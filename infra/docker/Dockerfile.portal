# The student / guardian / teacher portal (Vite build, served by nginx).
#
# Separate image from Dockerfile.web on purpose. The two apps have different
# audiences, different bundles and different security headers: the admin app runs
# on the school's own network, this one faces the public internet.

FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/portal/package.json apps/portal/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/portal apps/portal

# Baked in at build time, so the image is school-specific. VITE_ORG_CODE is why
# the login form has no "organization code" field for a guardian to guess at.
# Empty = same origin (/api/v1 through Caddy); see docker-compose.prod.yml (audit F10).
ARG VITE_API_URL=
ARG VITE_ORG_CODE=DEMO
ARG VITE_SCHOOL_NAME="School Portal"
ARG VITE_ENABLE_ADVANCED_LMS=false
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_ORG_CODE=${VITE_ORG_CODE}
ENV VITE_SCHOOL_NAME=${VITE_SCHOOL_NAME}
ENV VITE_ENABLE_ADVANCED_LMS=${VITE_ENABLE_ADVANCED_LMS}

RUN pnpm --filter @erp/shared build
RUN pnpm --filter @erp/portal build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/portal/dist /usr/share/nginx/html
COPY infra/docker/nginx.portal.conf /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ || exit 1
EXPOSE 80
